#!/usr/bin/env bash
# Runs `brew bundle` whenever any existing Brewfile module, the profile, the
# workstation feature toggles, or this script itself change. Project toolchains
# belong in per-project devbox.json files, not in global Homebrew modules.
#
# Brewfile (core)        hash: {{ include "Brewfile" | sha256sum }}
# brewfiles/Brewfile.ai            hash: {{ include "brewfiles/Brewfile.ai" | sha256sum }}
# brewfiles/Brewfile.mac-apps      hash: {{ include "brewfiles/Brewfile.mac-apps" | sha256sum }}
# brewfiles/Brewfile.personal      hash: {{ include "brewfiles/Brewfile.personal" | sha256sum }}
# brewfiles/Brewfile.work          hash: {{ include "brewfiles/Brewfile.work" | sha256sum }}
# Profile in effect:           {{ .profile }}
# Feature: ai                  {{ dig "features" "ai" false . }}
# Feature: macApps             {{ dig "features" "macApps" true . }}

set -euo pipefail

{{ if ne .chezmoi.os "darwin" -}}
echo "→ Homebrew packages: not on macOS, skipping"
exit 0
{{ end -}}

# Re-attach stdin to the controlling terminal so casks that invoke sudo
# (docker-desktop, 1password) can read the password. See run_before_00-sudo-cache
# for the upfront pre-auth; this is the belt-and-braces complement.
if [ -e /dev/tty ] && [ -r /dev/tty ]; then
    exec </dev/tty
else
    echo "! no terminal available; casks needing sudo may skip or ask later"
fi

eval "$(/opt/homebrew/bin/brew shellenv)"

SOURCE="{{ .chezmoi.sourceDir }}"

# ─── Pretty progress + heartbeat helpers ──────────────────────────────────────
HEARTBEAT_PID=""
TMP_DIR=""

# Start a heartbeat that prints an "(elapsed)" message every 30s. Useful for
# silent stretches like brew downloading a 1 GB cask over a slow link — the
# user can see something's still happening. The heartbeat self-terminates
# within 2 seconds of its parent dying, so it can't outlive the script if
# something goes sideways.
start_heartbeat() {
    local label="$1"
    local parent_pid=$$
    local start_ts
    start_ts="$(date +%s)"
    (
        local since_msg=0
        while kill -0 "$parent_pid" 2>/dev/null; do
            sleep 2
            since_msg=$((since_msg + 2))
            if [ "$since_msg" -ge 30 ]; then
                local now elapsed mins secs
                now="$(date +%s)"
                elapsed=$((now - start_ts))
                mins=$((elapsed / 60))
                secs=$((elapsed % 60))
                printf "  … still working on %s — %dm%02ds elapsed\n" "$label" "$mins" "$secs"
                since_msg=0
            fi
        done
    ) &
    HEARTBEAT_PID=$!
}
stop_heartbeat() {
    [ -n "$HEARTBEAT_PID" ] && kill "$HEARTBEAT_PID" 2>/dev/null
    HEARTBEAT_PID=""
}

cleanup() {
    stop_heartbeat
    [ -n "$TMP_DIR" ] && rm -rf "$TMP_DIR"
}
trap cleanup EXIT

is_bundle_line() {
    case "$1" in
        tap\ *|brew\ *|cask\ *|mas\ *) return 0 ;;
        *) return 1 ;;
    esac
}

entry_name() {
    local line="$1" kind name
    kind="${line%%[[:space:]]*}"
    name="$(printf '%s\n' "$line" | sed -n 's/^[[:space:]]*[[:alpha:]][[:alpha:]]*[[:space:]]*"\([^"]*\)".*/\1/p')"
    [ -n "$name" ] || name="$line"
    printf '%s %s' "$kind" "$name"
}

count_bundle_lines() {
    local file="$1" count=0 line
    [ -f "$file" ] || { printf '0'; return; }
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line#"${line%%[![:space:]]*}"}"
        is_bundle_line "$line" && count=$((count + 1))
    done < "$file"
    printf '%s' "$count"
}

write_unit_brewfile() {
    local target="$1" entry="$2"
    shift 2
    local tap_line
    {
        printf '# Generated by dotfiles brew-bundle split installer.\n'
        for tap_line in "$@"; do
            printf '%s\n' "$tap_line"
        done
        printf '%s\n' "$entry"
    } > "$target"
}

# Run one Brewfile entry at a time. This makes fresh installs recoverable and
# gives exact progress for large casks instead of one long opaque bundle run.
# Args: module-label, file, module-N, module-total, starting-item-N, total-items
bundle_one() {
    local label="$1" file="$2" module_step="$3" module_total="$4" item_start="$5" item_total="$6"
    if [ ! -f "$file" ]; then
        echo "! $label: $file not found, skipping"
        return 0
    fi

    local module_items module_start module_end module_elapsed module_mins module_secs
    module_items="$(count_bundle_lines "$file")"
    printf "→ Module %d/%d: %s (%s, %s item(s))\n" "$module_step" "$module_total" "$label" "$(basename "$file")" "$module_items"
    [ "$module_items" -gt 0 ] || { echo "✓ Module $module_step/$module_total: $label has no active entries"; return 0; }

    local active_taps=()
    local line display item_step item_file start_ts end_ts elapsed mins secs rc
    item_step="$item_start"
    module_start="$(date +%s)"

    while IFS= read -r line || [ -n "$line" ]; do
        line="${line#"${line%%[![:space:]]*}"}"
        is_bundle_line "$line" || continue

        display="$(entry_name "$line")"
        item_file="$TMP_DIR/brew-bundle-${item_step}.Brewfile"
        write_unit_brewfile "$item_file" "$line" "${active_taps[@]}"

        printf "→ %d/%d  %s: %s\n" "$item_step" "$item_total" "$label" "$display"
        start_ts="$(date +%s)"
        start_heartbeat "$display"
        rc=0
        brew bundle install --file="$item_file" || rc=$?
        stop_heartbeat

        end_ts="$(date +%s)"
        elapsed=$((end_ts - start_ts))
        mins=$((elapsed / 60))
        secs=$((elapsed % 60))
        if [ "$rc" -eq 0 ]; then
            printf "✓ %d/%d  %s: %s done in %dm%02ds\n" "$item_step" "$item_total" "$label" "$display" "$mins" "$secs"
        else
            printf "✗ %d/%d  %s: %s failed after %dm%02ds (rc=%d)\n" "$item_step" "$item_total" "$label" "$display" "$mins" "$secs" "$rc"
            printf "  Re-run the installer after fixing it; completed Homebrew items will be skipped.\n"
            return "$rc"
        fi

        case "$line" in
            tap\ *) active_taps+=("$line") ;;
        esac
        item_step=$((item_step + 1))
    done < "$file"

    module_end="$(date +%s)"
    module_elapsed=$((module_end - module_start))
    module_mins=$((module_elapsed / 60))
    module_secs=$((module_elapsed % 60))
    printf "✓ Module %d/%d: %s complete in %dm%02ds\n" "$module_step" "$module_total" "$label" "$module_mins" "$module_secs"
}

TMP_DIR="$(mktemp -d)"

# ─── Build the run plan up front so the user sees the whole picture ──────────
PLAN_LABELS=()
PLAN_FILES=()
add_step() { PLAN_LABELS+=("$1"); PLAN_FILES+=("$SOURCE/$2"); }

add_step "core (always)"                  "Brewfile"
{{ if dig "features" "ai" false . -}}
add_step "ai tooling (Ollama/llm)"        "brewfiles/Brewfile.ai"
{{ end -}}
{{ if dig "features" "macApps" true . -}}
add_step "mac apps (Rectangle/Raycast/Stats/Chrome/dive)"  "brewfiles/Brewfile.mac-apps"
{{ end -}}
case "{{ .profile }}" in
    personal|both) add_step "personal profile extras"  "brewfiles/Brewfile.personal" ;;
esac
case "{{ .profile }}" in
    work|both)     add_step "work profile extras"      "brewfiles/Brewfile.work" ;;
esac

TOTAL=${#PLAN_LABELS[@]}
TOTAL_ITEMS=0
for i in $(seq 0 $((TOTAL - 1))); do
    TOTAL_ITEMS=$((TOTAL_ITEMS + $(count_bundle_lines "${PLAN_FILES[$i]}")))
done

echo "◆ Apply 3/5: Homebrew packages"
echo "  Profile: {{ .profile }}"
echo "  Modules: $TOTAL"
for i in $(seq 0 $((TOTAL - 1))); do
    printf "    %d. %s\n" $((i + 1)) "${PLAN_LABELS[$i]}"
done
echo "  Items: $TOTAL_ITEMS taps/formulae/casks split into individual installs."
echo "  First install usually takes 5-15 minutes. Downloads dominate."
echo "  Quiet stretches print a heartbeat every 30 seconds."

# Print disabled modules so users know nothing's being silently dropped.
{{ if not (dig "features" "ai" false .) -}}
echo "  ai module disabled"
{{ end -}}
{{ if not (dig "features" "macApps" true .) -}}
echo "  mac-apps module disabled"
{{ end -}}

# ─── Execute the plan ─────────────────────────────────────────────────────────
OVERALL_START="$(date +%s)"
CURRENT_ITEM=1
for i in $(seq 0 $((TOTAL - 1))); do
    bundle_one "${PLAN_LABELS[$i]}" "${PLAN_FILES[$i]}" $((i + 1)) "$TOTAL" "$CURRENT_ITEM" "$TOTAL_ITEMS"
    CURRENT_ITEM=$((CURRENT_ITEM + $(count_bundle_lines "${PLAN_FILES[$i]}")))
done
OVERALL_END="$(date +%s)"
OVERALL_ELAPSED=$((OVERALL_END - OVERALL_START))
OVERALL_MIN=$((OVERALL_ELAPSED / 60))
OVERALL_SEC=$((OVERALL_ELAPSED % 60))

# brew installs sometimes leave group/other-write bits on share dirs that end
# up on zsh's $fpath, which makes `compinit` prompt at every shell startup:
#   "zsh compinit: insecure directories, run compaudit for list."
# Strip those bits proactively.
chmod -R go-w /opt/homebrew/share/zsh* 2>/dev/null || true

printf "✓ Homebrew packages up to date — %d module(s), total %dm%02ds\n" "$TOTAL" "$OVERALL_MIN" "$OVERALL_SEC"
