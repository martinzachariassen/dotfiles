#!/usr/bin/env bash
# run_onchange_after_02b-mise-install — materialize mise's global toolchain.
#
# Why this exists:
#   `mise activate` (wired into ~/.config/zsh/.zshrc) puts tools on PATH and
#   sets JAVA_HOME, but it does NOT install missing versions on its own. So
#   the first shell on a fresh machine would have a global mise config that
#   points at java/node versions that aren't downloaded yet. Running
#   `mise install` here eagerly downloads the global toolchain so the first
#   interactive shell just works — the mise equivalent of the old eager Nix
#   bootstrap.
#
# Why `onchange_after` and keyed on the global config:
#   - after: mise itself is installed by the brew-bundle step (02). Files in
#     the target state — including ~/.config/mise/config.toml — are written
#     before any run_after script, so the global config is in place by now.
#   - onchange: re-fires only when the global tool list changes, so a routine
#     apply that doesn't touch mise config is a no-op. The hash below pins the
#     re-fire trigger to the global config's content.
#
# Global mise config hash: {{ include "dot_config/mise/config.toml" | sha256sum }}

set -euo pipefail

{{ if ne .chezmoi.os "darwin" -}}
echo "→ mise: not on macOS, skipping"
exit 0
{{ end -}}

echo "◆ Apply 2b/5: mise runtimes"

if ! command -v mise >/dev/null 2>&1; then
    # brew-bundle (02) installs mise; if it's missing here the bundle step
    # failed or hasn't run. Don't fail the whole apply — the next shell will
    # have mise on PATH once brew bundle succeeds, and re-running `chez` will
    # re-fire this script.
    echo "! mise not on PATH yet — skipping global install."
    echo "  Re-run \`chez\` after brew bundle finishes to install runtimes."
    exit 0
fi

echo "→ Installing global runtimes from ~/.config/mise/config.toml"
echo "  (java + node; downloads only what's missing, idempotent)"

# `mise install` with no args installs every tool pinned in the resolved
# config — here just the global config.toml. Already-installed versions are
# skipped, so re-fires are cheap. Don't fail the apply on a transient network
# error; the tools install lazily on first `mise install`/use otherwise.
if mise install; then
    echo "✓ mise runtimes installed: $(mise current 2>/dev/null | tr '\n' ' ')"
else
    echo "! mise install failed (network?). Re-run \`chez\` or \`mise install\` to retry."
    exit 0
fi
