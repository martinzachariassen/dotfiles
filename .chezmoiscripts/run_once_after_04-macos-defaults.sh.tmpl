#!/usr/bin/env bash
# Applies scripts/macos-defaults.sh exactly ONCE per machine, on the first chezmoi apply.
#
# `run_once_*` (vs `run_onchange_*`) means chezmoi records that this script has
# run successfully, and never runs it again — even if you edit scripts/macos-defaults.sh
# later. That's the right tradeoff: editing system defaults shouldn't trigger a
# sudo prompt on every apply. To re-apply edits manually, use the `macos-defaults`
# zsh alias, which calls the script directly.

set -euo pipefail

# Skip on non-macOS (chezmoi runs scripts on every platform unless guarded)
{{ if ne .chezmoi.os "darwin" -}}
echo "→ macOS defaults: not on macOS, skipping"
exit 0
{{ end -}}

# chezmoi runs scripts with stdin closed/non-interactive, so sudo's password
# prompt inside scripts/macos-defaults.sh hangs in "Waiting for data…" mode. Reopen
# stdin from the controlling terminal if one exists, so sudo can read the
# password normally. In CI or other no-tty contexts, skip cleanly with a
# helpful message rather than hang.
echo "◆ Apply 5/5: macOS defaults"
echo "  One-time system preferences pass. Some changes need a reboot."

if [ -e /dev/tty ] && [ -r /dev/tty ]; then
    exec </dev/tty
else
    echo "! no terminal available; skipping macOS defaults"
    echo "  Run later with: macos-defaults"
    echo "  Or: bash {{ .chezmoi.sourceDir }}/scripts/macos-defaults.sh"
    exit 0
fi

bash "{{ .chezmoi.sourceDir }}/scripts/macos-defaults.sh"

echo "✓ macOS defaults applied"
