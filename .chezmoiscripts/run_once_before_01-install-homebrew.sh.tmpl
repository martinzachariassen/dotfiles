#!/usr/bin/env bash
# Installs Homebrew if missing. Runs ONCE (before the first apply).
#
# Guarded to macOS only — chezmoi runs scripts on every platform unless we tell
# it not to. Linuxbrew works but lives at a different path and isn't in scope here.
set -euo pipefail

{{ if ne .chezmoi.os "darwin" -}}
echo "→ Homebrew: not on macOS, skipping"
exit 0
{{ end -}}

# Not numbered in the apply step 1..5 sequence because this only runs on the
# very first apply (`run_once_before_*`). Subsequent applies skip it silently.
echo "◆ One-time setup: Homebrew"

if command -v brew >/dev/null 2>&1; then
    echo "✓ Homebrew already installed"
    exit 0
fi

echo "→ Installing Homebrew. This is usually about a minute on a fresh Mac."
NONINTERACTIVE=1 /bin/bash -c \
    "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

# Apple Silicon path
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

echo "✓ Homebrew installed and ready"
