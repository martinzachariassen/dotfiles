#!/usr/bin/env bash
# run_onchange_after_02e-pre-commit-install — activate this repo's git hooks.
#
# Why this exists:
#   .pre-commit-config.yaml only takes effect once `pre-commit install` has
#   written the dispatcher into .git/hooks. That's a per-clone action chezmoi
#   can't express as a managed file (the hooks live under .git, which isn't in
#   the source state), so it has to be a script. Without it, a fresh machine has
#   the config but commits straight to main ungated — exactly the gap the config
#   is meant to close.
#
# Why `run_onchange` keyed on the config:
#   The git dispatcher pre-commit writes is the same regardless of which hooks
#   the config lists, so re-running on every apply is pure noise. The hash of
#   .pre-commit-config.yaml is embedded below, so this re-fires only when the
#   hook set (or this script) changes — and `pre-commit install` is idempotent,
#   so any re-fire is a cheap reconcile.
#
# Bootstrap order:
#   02-brew-bundle installs the `pre-commit` formula (core tier), so the binary
#   is on PATH by the time this 02e step runs. If it isn't (bundle skipped), we
#   no-op with a hint rather than fail the apply.
#
# pre-commit config hash: {{ include ".pre-commit-config.yaml" | sha256sum }}

set -euo pipefail

{{ if ne .chezmoi.os "darwin" -}}
echo "→ pre-commit: not on macOS, skipping"
exit 0
{{ end -}}

# Ensure Homebrew's bin dir is on PATH when apply runs outside a login shell
# (launchd, cron, a bare `chezmoi apply`). Mirrors run_after_02-brew-bundle so
# the `command -v pre-commit` check below finds the binary the bundle installed.
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

echo "◆ Apply 2e/5: pre-commit hooks"

if ! command -v pre-commit >/dev/null 2>&1; then
    echo "  ! pre-commit not on PATH — skipping (run \`chezup\` after brew bundle installs it)"
    exit 0
fi

repo="{{ .chezmoi.sourceDir }}"
if [ ! -d "$repo/.git" ]; then
    echo "  ! ${repo} is not a git checkout — skipping hook install"
    exit 0
fi

# default_install_hook_types in .pre-commit-config.yaml selects the stages
# (pre-commit + commit-msg), so a bare install wires up both. --install-hooks
# pre-builds any hook environments; ours are all language: system, so it's a
# no-op today but stays correct if a managed-env hook is added later.
( cd "$repo" && pre-commit install --install-hooks >/dev/null )

echo "  ${GREEN:-}✓${RESET:-} pre-commit hooks installed (pre-commit + commit-msg)"
