#!/usr/bin/env bash
# run_after_02d-obsidian-apply — converge an Obsidian vault to canonical config.
#
# Why this exists:
#   The Obsidian app installs from Brewfile.mac-apps, but a fresh app is just
#   an empty shell — the theme, community plugins, hotkeys, and templates have
#   to be set up per-vault. This script seeds the active vault with the
#   canonical layout from ~/.config/obsidian/ so the first launch on a new
#   machine looks the same as every other one.
#
# Why `run_after` (every apply), not `run_onchange`:
#   Same reasoning as 02-brew-bundle and 02b-mise-install (see docs/lifecycle.md).
#   The script converges real installed state — plugins on disk, templates in
#   the vault — not the text of the canonical config. A plugin can go missing
#   while ~/.config/obsidian/plugins.txt stays put. The presence-check inside
#   each loop is the fast short-circuit so a clean machine stays quick.
#
# Bootstrap order:
#   02-brew-bundle installs the Obsidian.app cask. ~/.config/obsidian/ is
#   written before any run_after script. By the time we get here, both are in
#   place. We still no-op gracefully if Obsidian hasn't been opened once (no
#   vault registered) — the user can open it, add a vault, and re-run `chezup`.

set -euo pipefail

{{ if ne .chezmoi.os "darwin" -}}
echo "→ obsidian: not on macOS, skipping"
exit 0
{{ end -}}

{{ if not (has "obsidian" (dig "modules" (list) .)) -}}
echo "→ obsidian: 'obsidian' module not selected, skipping"
exit 0
{{ end -}}

# shellcheck source=/dev/null
. "{{ .chezmoi.sourceDir }}/scripts/lib/log.sh"
ui_init_colors
ui_init_glyphs

# shellcheck source=/dev/null
. "{{ .chezmoi.sourceDir }}/scripts/lib/obsidian-apply.sh"

echo "${NODE} Apply 2d/5: Obsidian vault"

obsidian_apply

if [ "${#OB_FAILURES[@]}" -gt 0 ]; then
    printf "${YELLOW}!${RESET} obsidian: %d item(s) failed — apply continues:\n" "${#OB_FAILURES[@]}"
    for failure in "${OB_FAILURES[@]}"; do
        printf "    %s\n" "$failure"
    done
    echo "  Re-run \`chezup\` to retry (transient network errors heal on retry)."
fi
