#!/usr/bin/env bash
# Installs VS Code extensions from the repo manifest when this script or the
# extension manifest changes.
#
# Marketplace extension manifest hash: {{ include "vscode/extensions.txt" | sha256sum }}

set -euo pipefail

{{ if ne .chezmoi.os "darwin" -}}
echo "→ VS Code: not on macOS, skipping"
exit 0
{{ end -}}

# Ensure Homebrew's bin dir is on PATH when apply runs outside a login shell
# (launchd, cron, a bare `chezmoi apply`). Mirrors run_after_02-brew-bundle so
# the `command -v code` check below finds the binary the bundle installed.
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

SOURCE="{{ .chezmoi.sourceDir }}"
EXTENSIONS_FILE="$SOURCE/vscode/extensions.txt"
DEPRECATED_EXTENSIONS=(
    "continue.continue"
    "fwcd.kotlin"
    "jetbrains.kotlin"
    "jetpack-io.devbox"
    "mkhl.direnv"
    # Lombok support is now built into redhat.java (since v1.9), controlled by
    # java.jdt.ls.lombokSupport.enabled (default true). The standalone extension
    # ships an old bundled lombok.jar and is being deprecated upstream.
    "vscjava.vscode-lombok"
)

if ! command -v code >/dev/null 2>&1; then
    echo "! VS Code CLI not found; extension install skipped"
    exit 0
fi

installed_extensions() {
    code --list-extensions 2>/dev/null | tr '[:upper:]' '[:lower:]' || true
}

install_marketplace_extensions() {
    if [ ! -f "$EXTENSIONS_FILE" ]; then
        echo "! VS Code extension manifest missing: $EXTENSIONS_FILE"
        return 0
    fi

    local installed ext line
    installed="$(installed_extensions)"
    while IFS= read -r line || [ -n "$line" ]; do
        ext="${line%%#*}"
        ext="$(printf '%s' "$ext" | xargs | tr '[:upper:]' '[:lower:]')"
        [ -n "$ext" ] || continue

        # -F = literal match (extension IDs contain "."), -x = whole line.
        # `installed` is already lowercased; `ext` matches that.
        if printf '%s\n' "$installed" | grep -qxF "$ext"; then
            echo "✓ extension already installed: $ext"
        else
            echo "→ installing extension: $ext"
            # Continue-on-error: a yanked ID, version-incompatible extension, or a
            # transient marketplace failure must not abort the extensions after it.
            code --install-extension "$ext" || echo "  ! failed to install: $ext (continuing)"
        fi
    done < "$EXTENSIONS_FILE"
}

uninstall_deprecated_extensions() {
    local installed ext
    installed="$(installed_extensions)"

    # DEPRECATED_EXTENSIONS entries are kept lowercase by convention so they
    # line up with `installed_extensions` (already lowercased). Match literally
    # with -F so dots in IDs aren't treated as regex any-char.
    for ext in "${DEPRECATED_EXTENSIONS[@]}"; do
        if printf '%s\n' "$installed" | grep -qxF "$ext"; then
            echo "→ uninstalling deprecated extension: $ext"
            code --uninstall-extension "$ext" || echo "  ! failed to uninstall: $ext (continuing)"
        fi
    done
}

echo "◆ Apply 4/5: VS Code extensions"
echo "  Manifest: $EXTENSIONS_FILE"

install_marketplace_extensions
uninstall_deprecated_extensions

echo "✓ VS Code extensions are managed"
