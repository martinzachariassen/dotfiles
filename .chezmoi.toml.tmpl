{{/* chezmoi init prompts — used as a fallback if the install wizard does not
     pre-populate the init command.

     The wizard in install.sh loads any existing answers, asks once, then passes
     those values to `chezmoi init` with --promptString/--promptChoice/--promptBool.
     Plain prompt helpers consume those supplied values; prompt*Once would prompt
     again during first init.

     Defaults are intentionally empty for identity fields so forks of this
     repo don't inherit private values. */ -}}

{{- $name       := promptString "name"       "" -}}
{{- $email      := promptString "email"      "" -}}
{{- $signingKey := promptString "signingKey" "" -}}

{{/* Profile picker — controls which casks get installed and which config blocks
     activate. `personal` and `work` each install only their respective extras
     on top of the core Brewfile. */ -}}
{{- $profile    := promptChoice "profile" (list "personal" "work") "personal" -}}

{{/* Workstation feature toggles. Project toolchains (Kubernetes, Terraform,
     database clients/servers, language runtimes) belong in each project's
     devbox.json, not in global Homebrew modules. */ -}}
{{- $useOnePassword := promptBool "useOnePassword" true -}}
{{- $featMacApps    := promptBool "features.macApps" true -}}
{{- $featAi         := promptBool "features.ai" false -}}

# Tell chezmoi the source repo lives under ~/Developer/personal/dotfiles
# (default is ~/.local/share/chezmoi). Required so subsequent commands find it.
sourceDir = "{{ .chezmoi.homeDir }}/Developer/personal/dotfiles"

# Note: the minimum chezmoi version is enforced by the `.chezmoiversion` file
# at the repo root (not a config-file field). chezmoi refuses to interpret
# the source state if the current version is too old.

[data]
    name           = {{ $name | quote }}
    email          = {{ $email | quote }}
    signingKey     = {{ $signingKey | quote }}
    profile        = {{ $profile | quote }}
    useOnePassword = {{ $useOnePassword }}

    [data.features]
        macApps   = {{ $featMacApps }}
        ai        = {{ $featAi }}

# delta is unconditionally in the core Brewfile, so we can wire chezmoi's
# diff pager to it without `lookPath` gating. The path resolves on first
# `chezmoi diff` AFTER brew bundle has run; nothing in the install flow calls
# `chezmoi diff` before that, so there's no chicken-and-egg issue.
[diff]
    pager = "delta"

# Make `chezmoi apply` (and every variant — `apply -v`, etc.) behave as if
# `--force` were always passed. Reasoning: when a managed file in $HOME has
# drifted from its source state, plain `chezmoi apply` stops and asks per-file
#   diff/overwrite/skip/quit/merge?
# The single-keypress prompt collides with later sudo prompts and feels
# completely unexpected if you didn't realise you'd edited a managed file
# locally.
#
# Force-by-default makes the apply non-interactive: it just overwrites local
# drift. The safety net is `chez` (the zshrc wrapper) — it shows
# `chezmoi status` upfront with a one-shot y/N so you can see and abort if
# unwanted changes would be clobbered. To preserve a local edit before
# applying, run `chezmoi re-add ~/.X` to capture it back into source first.
[apply]
    force = true
