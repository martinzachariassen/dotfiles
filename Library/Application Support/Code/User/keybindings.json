// Custom VS Code keybindings — chezmoi-managed (see docs/mapping.md).
//
// Vim normal/insert/visual-mode leader maps live in settings.json (vscodevim
// owns those). This file is for editor-chrome chords that vim doesn't cover.
// Everything here is chosen to NOT clobber a macOS default binding — add your
// own below and `chezmoi re-add` to capture them back into the repo.
[
    // ---- Editor group / pane management ----
    // Move the focused editor into the next / previous editor group.
    { "key": "cmd+ctrl+right", "command": "workbench.action.moveEditorToNextGroup" },
    { "key": "cmd+ctrl+left", "command": "workbench.action.moveEditorToPreviousGroup" },

    // Maximize / restore the focused editor group — temporary single-pane focus.
    { "key": "cmd+ctrl+up", "command": "workbench.action.toggleMaximizeEditorGroup" },

    // ---- Terminal ----
    // Split a new integrated terminal beside the current one.
    { "key": "cmd+ctrl+t", "command": "workbench.action.terminal.split", "when": "terminalFocus" }
]
