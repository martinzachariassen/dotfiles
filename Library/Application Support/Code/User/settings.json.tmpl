{
    // =========================================================
    // APPEARANCE
    // =========================================================

{{ if has "theme" (dig "modules" (list) .) -}}
    "workbench.colorTheme": "Catppuccin Frappé",
{{ end -}}
    "workbench.iconTheme": "material-icon-theme",

    "window.commandCenter": true,
    "workbench.startupEditor": "none",
    "workbench.editor.enablePreview": false,
    "workbench.editor.labelFormat": "short",
    "workbench.tree.indent": 16,
    "breadcrumbs.enabled": true,
    "workbench.settings.enableNaturalLanguageSearch": false,
    "workbench.enableExperiments": false,
    "workbench.list.smoothScrolling": true,

    // Cap open tabs per group so the editor never sprawls; least-recently-used
    // non-dirty tabs auto-close once the limit is hit.
    "workbench.editor.limit.enabled": true,
    "workbench.editor.limit.value": 10,
    "workbench.editor.limit.perEditorGroup": true,

    // =========================================================
    // FONT & EDITOR
    // =========================================================

    "editor.fontFamily": "'JetBrainsMono Nerd Font', Menlo, Monaco, 'Courier New', monospace",
    "editor.fontSize": 14,
    "editor.fontLigatures": true,
    "editor.lineHeight": 1.7,
    "editor.letterSpacing": 0.3,

    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.smoothScrolling": true,

    "editor.minimap.enabled": false,
    "editor.renderWhitespace": "selection",
    "editor.guides.indentation": true,
    "editor.guides.bracketPairs": "active",

    "editor.bracketPairColorization.enabled": true,
    "editor.stickyScroll.enabled": true,
    "editor.stickyScroll.maxLineCount": 5,

    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.formatOnSaveMode": "file",
    "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
    },

    // One default formatter so save-formatting is deterministic and never shows
    // a "select a formatter" prompt. LSP-owned languages (Java, Kotlin, YAML,
    // XML, Terraform, …) override this in LANGUAGE-SPECIFIC below.
    "editor.defaultFormatter": "esbenp.prettier-vscode",

    // Prettier fallbacks used only when a repo has no .prettierrc — pin a
    // project-level .prettierrc when the team needs the same width/wrap rules.
    "prettier.printWidth": 100,
    "prettier.proseWrap": "preserve",

    "editor.inlineSuggest.enabled": true,
    "editor.acceptSuggestionOnEnter": "smart",
    "editor.rulers": [100, 120],
    "editor.cursorSurroundingLines": 4,
    "editor.linkedEditing": true,
    "editor.accessibilitySupport": "off",

    // =========================================================
    // FILES
    // =========================================================

    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,

    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.hotExit": "onExitAndWindowClose",
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/.gradle/**": true,
        "**/build/**": true,
        "**/dist/**": true,
        "**/node_modules/**": true,
        "**/target/**": true
    },

    "files.exclude": {
        "**/.DS_Store": true,
        "**/.git": false,
        "**/node_modules": true,
        "**/.gradle": true,
        "**/dist": true,
        "**/build": true
    },

    // Collapse derived/companion files under their parent in the Explorer so the
    // tree shows intent, not noise (lockfiles under manifests, maps/.d.ts under
    // sources, .class under .java, etc.). Toggle nests with the arrow.
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js, ${capture}.d.ts, ${capture}.js.map",
        "*.tsx": "${capture}.js, ${capture}.css",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.java": "${capture}.class",
        "package.json": "package-lock.json, .npmrc, .nvmrc, .node-version, tsconfig*.json, .eslint*, .prettier*, eslint.config.*, prettier.config.*",
        "tsconfig.json": "tsconfig.*.json",
        "build.gradle": "gradle.properties, gradle-wrapper.properties, settings.gradle, gradlew, gradlew.bat",
        "build.gradle.kts": "gradle.properties, gradle-wrapper.properties, settings.gradle.kts, gradlew, gradlew.bat",
        "pom.xml": "mvnw, mvnw.cmd, .mvn",
        "*.tf": "${capture}.tfvars, ${capture}.tfvars.json, .terraform.lock.hcl",
        "Dockerfile": "Dockerfile.*, .dockerignore, docker-compose.*, compose.*",
        "pyproject.toml": "poetry.lock, uv.lock, setup.py, setup.cfg, requirements*.txt, .python-version, ruff.toml, .ruff.toml",
        ".gitignore": ".gitattributes, .gitmodules, .mailmap, .editorconfig",
        "mise.toml": ".mise.toml, mise.*.toml, .tool-versions",
        "readme.md": "license, license.*, contributing.*, changelog.*, code_of_conduct.*, security.*"
    },

    // =========================================================
    // SEARCH
    // =========================================================

    "search.exclude": {
        "**/node_modules": true,
        "**/build": true,
        "**/dist": true,
        "**/.gradle": true
    },

    "search.followSymlinks": false,

    // Todo-Tree's marketplace VSIX (gruntfuggly.todo-tree 0.0.226) ships without
    // its bundled `vscode-ripgrep/bin/rg`, so the extension fails on activation
    // with "Failed to find vscode-ripgrep". Point it at the Homebrew rg instead.
    "todo-tree.ripgrep.ripgrep": "/opt/homebrew/bin/rg",

    // =========================================================
    // EXPLORER & GIT
    // =========================================================

    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,

    "git.enableSmartCommit": true,
    "git.confirmSync": false,
    "git.autofetch": true,
    "git.openRepositoryInParentFolders": "never",
    "git.pruneOnFetch": true,
    "git.rebaseWhenSync": true,
    "git.mergeEditor": true,
    "gitlens.currentLine.enabled": false,
    // Disable VS Code's built-in inline blame decoration shown at the end of the
    // current line (default-on; often mistaken for a GitLens annotation).
    "git.blame.editorDecoration.enabled": false,
    "git.blame.statusBarItem.enabled": false,
    // Remove the "You, N hours ago | 1 author" CodeLens GitLens inserts above
    // code blocks (and between lines in YAML/config files).
    "gitlens.codeLens.enabled": false,

    // SCM view as a tree, and diffs that respect whitespace + flag moved code.
    "scm.defaultViewMode": "tree",
    "diffEditor.ignoreTrimWhitespace": false,
    "diffEditor.experimental.showMoves": true,

    "github.gitAuthentication": true,
    "githubPullRequests.pullBranch": "never",

    // =========================================================
    // TERMINAL
    // =========================================================

    "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font'",
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.scrollback": 10000,
    "terminal.integrated.smoothScrolling": true,
    "terminal.integrated.enablePersistentSessions": false,

    // =========================================================
    // PROJECT ENVIRONMENT
    // =========================================================

    // mise provides per-project runtimes + env. The extension reflects the
    // active mise tools into the integrated terminal and is mise-toml aware.
    // Auto-configuration of OTHER extensions is left OFF: this settings file is
    // chezmoi-managed, so the Java SDK paths below are the single source of
    // truth — we don't want the extension writing into it and causing drift.
    "mise.configureExtensionsAutomatically": false,

    // =========================================================
    // VIM
    // =========================================================

    "vim.leader": "<space>",
    "vim.useSystemClipboard": true,
    "vim.hlsearch": true,
    "vim.incsearch": true,
    "vim.smartcase": true,
    "vim.ignorecase": true,
    "vim.easymotion": true,
    "vim.surround": true,
    "vim.insertModeKeyBindings": [
        {
            "before": ["j", "k"],
            "after": ["<Esc>"]
        }
    ],
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": ["<leader>", "w"],
            "commands": ["workbench.action.files.save"]
        },
        {
            "before": ["<leader>", "p"],
            "commands": ["workbench.action.quickOpen"]
        },
        {
            "before": ["<leader>", "f"],
            "commands": ["workbench.action.findInFiles"]
        },
        {
            "before": ["<leader>", "e"],
            "commands": ["workbench.view.explorer"]
        },
        {
            "before": ["<leader>", "g"],
            "commands": ["workbench.view.scm"]
        },
        {
            "before": ["<leader>", "d"],
            "commands": ["editor.action.revealDefinition"]
        },
        {
            "before": ["<leader>", "r", "n"],
            "commands": ["editor.action.rename"]
        },
        {
            "before": ["<leader>", "a"],
            "commands": ["editor.action.quickFix"]
        },
        {
            "before": ["<leader>", "/"],
            "commands": ["editor.action.commentLine"]
        },
        {
            "before": ["<leader>", "q"],
            "commands": ["workbench.action.closeActiveEditor"]
        }
    ],
    "vim.visualModeKeyBindingsNonRecursive": [
        {
            "before": ["<leader>", "/"],
            "commands": ["editor.action.commentLine"]
        }
    ],

    // =========================================================
    // AI / COPILOT
    // =========================================================

    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": true,
        "scminput": false
    },

    // Conventional Commits for the SCM "Generate Commit Message" action.
    "github.copilot.chat.commitMessageGeneration.instructions": [
        {
            "text": "Use Conventional Commits: `<type>(<scope>): <subject>`. Types: feat, fix, docs, refactor, test, chore, perf, build, ci, style. Subject in imperative mood, lowercase, no trailing period, ≤72 chars. Breaking changes append `!` to the type and add a `BREAKING CHANGE:` footer. Body (when needed) is separated from the subject by a blank line, explains the *why*, and wraps at 72."
        }
    ],

    "chat.editor.fontSize": 14,

    // =========================================================
    // BACKEND / INFRA
    // =========================================================

    // Auto-sync the classpath when build files change (no manual prompt).
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.compile.nullAnalysis.mode": "automatic",
    "java.inlayHints.parameterNames.enabled": "literals",
    "java.saveActions.organizeImports": true,

    // Pin the editor's JDKs to mise's stable install paths. Unlike devbox/Nix
    // (content-hashed paths that churned on every update/GC and made JDT.LS
    // lose its classpath), mise installs to a fixed, version-named directory
    // that doesn't move — so these paths are durable anchors. The JDKs come
    // from the global mise config (java = ["temurin-25", "temurin-21"] in
    // dot_config/mise/config.toml); project build versions are still pinned per
    // project via Gradle/Maven toolchains. This file is a chezmoi template so
    // the home dir resolves per machine.
    //
    // JDT.LS itself runs on Java 25 — picks up newer language-server features
    // and matches the default project JDK so Lombok/javac plugins line up.
{{ if has "jvmStack" (dig "modules" (list) .) -}}
    "java.jdt.ls.java.home": "{{ .chezmoi.homeDir }}/.local/share/mise/installs/java/temurin-25/Contents/Home",
    "java.import.gradle.java.home": "{{ .chezmoi.homeDir }}/.local/share/mise/installs/java/temurin-25/Contents/Home",
    "java.configuration.runtimes": [
        {
            "name": "JavaSE-25",
            "path": "{{ .chezmoi.homeDir }}/.local/share/mise/installs/java/temurin-25/Contents/Home",
            "default": true
        },
        {
            "name": "JavaSE-21",
            "path": "{{ .chezmoi.homeDir }}/.local/share/mise/installs/java/temurin-21/Contents/Home"
        }
    ],
{{ end -}}

    // Language-server heap/GC tuning.
    "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx2G -Xms100m",
    "java.import.gradle.wrapper.enabled": true,

    // Pull down library sources/decompiled output so go-to-definition lands on
    // real code instead of stubs.
    "java.maven.downloadSources": true,
    "java.eclipse.downloadSources": true,
    "java.references.includeDecompiledSources": true,

    // Faster authoring: fill best-guess args, richer signature help, and
    // static-import favorites for the common test/assertion libraries.
    "java.completion.guessMethodArguments": "auto",
    "java.signatureHelp.description.enabled": true,
    "java.completion.favoriteStaticMembers": [
        "org.junit.jupiter.api.Assertions.*",
        "org.junit.jupiter.api.Assumptions.*",
        "org.assertj.core.api.Assertions.*",
        "org.mockito.Mockito.*",
        "org.mockito.ArgumentMatchers.*",
        "org.hamcrest.MatcherAssert.assertThat",
        "org.hamcrest.Matchers.*"
    ],

    // Code-generation defaults for generated equals/hashCode/getters.
    "java.codeGeneration.hashCodeEquals.useJava7Objects": true,
    "java.codeGeneration.useBlocks": true,
    "java.codeGeneration.generateComments": false,

    // Safe, unambiguous cleanups applied on save.
    "java.cleanup.actionsOnSave": [
        "addOverride",
        "instanceofPatternMatch",
        "switchExpression"
    ],

    // Lombok handled by redhat.java's built-in support (since v1.9), not the
    // deprecated vscjava.vscode-lombok extension. JDT.LS prefers the project's
    // own Lombok jar from the classpath and falls back to the bundled one —
    // so projects that pin a recent Lombok (1.18.40+ for JDK 25, 1.18.46+ for
    // JDK 26) get accurate parsing of @-annotated sources automatically.
    "java.jdt.ls.lombokSupport.enabled": true,

    // SonarLint: lint quality/bugs without phoning home.
    "sonarlint.disableTelemetry": true,

    "spring-boot.ls.problem.application-properties.enabled": true,
    "spring-boot.ls.problem.application-yaml.enabled": true,

    // JetBrains Kotlin LSP — server-side configuration. The extension is Alpha
    // and JVM-only (no Multiplatform, no Android). Settings live under the
    // `intellij.*` namespace because the underlying server is IntelliJ's
    // language-engine repackaged as an LSP.
    //
    //   intellij.dev.serverPort = -1  → use the server bundled in the
    //     extension's VSIX (`unpack-server.mjs`). Any other port would expect
    //     a locally-run dev server — only useful if you're hacking on the LSP.
    //   intellij.buildTool = null      → auto-detect (gradle | maven). Leave
    //     unset so per-project shape wins.
    //   intellij.jdkForSymbolResolution → JDK whose stdlib symbols the server
    //     resolves against. Anchored to the same mise temurin-25 path used by
    //     JDT.LS above so Java + Kotlin agree on what `java.*` looks like.
    "intellij.dev.serverPort": -1,
{{ if has "jvmStack" (dig "modules" (list) .) -}}
    "intellij.jdkForSymbolResolution": "{{ .chezmoi.homeDir }}/.local/share/mise/installs/java/temurin-25/Contents/Home",
{{ end -}}
    "intellij.trace.server": "off",

    "terraform.languageServer.enable": true,

    "yaml.validate": true,
    "yaml.format.enable": true,
    "yaml.completion": true,
    "yaml.hover": true,
    "yaml.schemaStore.enable": true,
    "yaml.format.printWidth": 120,
    "yaml.format.singleQuote": false,
    "yaml.format.bracketSpacing": true,
    "yaml.format.proseWrap": "preserve",

    // XML (LemMinX / redhat.vscode-xml) — keep pom.xml & Spring XML tidy and
    // schema-validated without reflowing hand-laid-out attributes.
    "xml.format.enabled": true,
    "xml.format.maxLineWidth": 120,
    "xml.format.splitAttributes": "preserve",
    "xml.format.preserveAttributeLineBreaks": true,
    "xml.format.joinContentLines": false,
    "xml.validation.enabled": true,

    // shfmt flags for the shell-format extension (4-space indent, indent switch
    // cases) — mirrors the repo .editorconfig.
    "shellformat.flag": "-i 4 -ci",

    "cSpell.language": "{{ if has "locale" (dig "modules" (list) .) }}en-US,nb{{ else }}en-US{{ end }}",

    // Personal dictionary as a chezmoi-managed plain-text file. Words added
    // via "Add Words to personal" in the spell-checker quick-fix get appended
    // to ~/.config/cspell/personal.txt, which is a symlink into this dotfiles
    // repo (vscode/cspell-personal-words.txt). So new words show up in
    // `git status`, are committed alongside the rest of the config, and sync
    // across machines on the next chezmoi apply — no settings.json edit, no
    // `chezmoi re-add` step. addWords: true exposes this dictionary as a
    // target in the lightbulb menu; scope: user keeps it available in every
    // project.
    "cSpell.customDictionaries": {
        "personal": {
            "name": "personal",
            "description": "Personal dictionary tracked in dotfiles",
            "path": "{{ .chezmoi.homeDir }}/.config/cspell/personal.txt",
            "addWords": true,
            "scope": "user"
        }
    },

    // =========================================================
    // LANGUAGE-SPECIFIC
    // =========================================================

    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },

    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },

    "[yaml]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },

    "[xml]": {
        "editor.defaultFormatter": "redhat.vscode-xml"
    },

    "[markdown]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },

    // Commit messages: subject ≤50, body wrap at 72 — the conventional guides.
    "[git-commit]": {
        "editor.rulers": [50, 72]
    },
    "[scminput]": {
        "editor.rulers": [50, 72]
    },

    "[toml]": {
        "editor.defaultFormatter": "tamasfe.even-better-toml"
    },

    "[dockerfile]": {
        "editor.defaultFormatter": "ms-azuretools.vscode-containers"
    },

    "[shellscript]": {
        "editor.defaultFormatter": "foxundermoon.shell-format"
    },

    "[terraform]": {
        "editor.defaultFormatter": "hashicorp.terraform"
    },

    "[terraform-vars]": {
        "editor.defaultFormatter": "hashicorp.terraform"
    },

    "[spring-boot-properties-yaml]": {
        "yaml.validate": false,
        "editor.quickSuggestions": {
            "strings": true
        }
    },

    "[java]": {
        "editor.defaultFormatter": "redhat.java",
        "editor.tabSize": 4,
        "editor.detectIndentation": false
    },

    // JetBrains Kotlin LSP (extension ID jetbrains.kotlin-server) — Alpha as of
    // KotlinConf 2026. Ships the IntelliJ-backed language server bundled inside
    // the extension (the kotlin-lsp Homebrew cask is for *non*-VS Code clients
    // like nvim/Emacs). The formatter is the same publisher.extension ID, not
    // "jetbrains.kotlin" — that was the older extension we deprecated.
    "[kotlin]": {
        "editor.defaultFormatter": "jetbrains.kotlin-server",
        "editor.tabSize": 4,
        "editor.detectIndentation": false
    },

    // Prettier formats; ESLint applies its non-format autofixes on save.
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit"
        }
    },

    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit"
        }
    },

    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit"
        }
    },

    "[javascriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit"
        }
    },

    // Ruff handles both lint-fix and formatting + import sorting on save.
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnType": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports.ruff": "explicit",
            "source.fixAll.ruff": "explicit"
        }
    },

    // =========================================================
    // PERFORMANCE
    // =========================================================

    "extensions.ignoreRecommendations": true,
    "telemetry.telemetryLevel": "off",
    "redhat.telemetry.enabled": false,
    "gitlens.telemetry.enabled": false,

    "update.mode": "manual",

    // =========================================================
    // SECURITY
    // =========================================================

    "security.workspace.trust.enabled": true
}
