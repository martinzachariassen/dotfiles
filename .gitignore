# ─── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.VolumeIcon.icns

# ─── Editors / IDEs ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.iml
*.swp
*.swo
*~
.netrwhist
.nvimlog
Session.vim

# ─── AI coding tools (local-only state) ───────────────────────────────────────
# Per-clone permission/session state for assistants. Belongs in $HOME, not in
# the repo. The user's global ~/.config/git/ignore typically already covers
# this; the repo-local entries make it self-protecting on forks and CI.
.claude/
.aider*
.cursor/

# ─── Build / temp ─────────────────────────────────────────────────────────────
*.bak
*.orig
*.tmp
*.log
.cache/
.storecode/

# ─── chezmoi internal state (should never appear here, but belt-and-suspenders) ─
.chezmoistate*
chezmoistate.boltdb

# ─── Secrets — fail-safe even though we don't intentionally put them here ────
# Private keys
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
id_ecdsa

# Anything literally named "secret" or "private"
*-private*
*-secret*
secrets.*
.env
.env.*
!.env.example
!.env.sample
mise.local.toml
.mise.local.toml

# Cloud auth state
.aws/credentials
gcloud-credentials.json
*-service-account*.json
