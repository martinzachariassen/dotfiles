# Identity, signing and the editor live in config.local, generated by this
# module's apply.sh from config.toml.

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	default = current
	autoSetupRemote = true

[fetch]
	prune = true

[rebase]
	autoStash = true

[diff]
	algorithm = histogram
	colorMoved = default

[merge]
	conflictstyle = zdiff3

[core]
	excludesfile = ~/.config/git/ignore

[column]
	ui = auto

[branch]
	sort = -committerdate

[alias]
	s = status --short --branch
	lg = log --oneline --graph --decorate -20
	last = log -1 --stat
	unstage = restore --staged
	amend = commit --amend --no-edit

# Last, so it wins. A missing file is not an error. The path is relative to
# THIS file as git found it -- ~/.config/git/config, the symlink -- not to the
# repo it resolves to. Make it absolute and it stops following the checkout;
# leave it relative and identity and signing load. modules/ssh does the reverse
# (Include FIRST) because ssh takes the first value, not the last.
[include]
	path = config.local
