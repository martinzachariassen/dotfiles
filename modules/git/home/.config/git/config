# Identity, signing and the editor live in config.local, generated by this
# module's apply.sh from config.toml.

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	default = current
	autoSetupRemote = true

[fetch]
	prune = true

[rebase]
	autoStash = true

[diff]
	algorithm = histogram
	colorMoved = default

[merge]
	conflictstyle = zdiff3

[core]
	excludesfile = ~/.config/git/ignore

[column]
	ui = auto

[branch]
	sort = -committerdate

[alias]
	s = status --short --branch
	lg = log --oneline --graph --decorate -20
	last = log -1 --stat
	unstage = restore --staged
	amend = commit --amend --no-edit

# Last, so it wins; a missing file is not an error. Relative on purpose: git
# resolves the path against THIS file as it found it -- ~/.config/git/config,
# the symlink -- so an absolute path stops following the checkout.
[include]
	path = config.local
