[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	default = current
	autoSetupRemote = true

[fetch]
	prune = true

[rebase]
	autoStash = true

[diff]
	algorithm = histogram
	colorMoved = default

[merge]
	conflictstyle = zdiff3

[core]
	excludesfile = ~/.config/git/ignore

[column]
	ui = auto

[branch]
	sort = -committerdate

[alias]
	s = status --short --branch
	lg = log --oneline --graph --decorate -20
	last = log -1 --stat
	unstage = restore --staged
	amend = commit --amend --no-edit

[include]
	# Relative on purpose: git resolves it against the symlink, so an absolute
	# path would stop following the checkout.
	path = config.local
