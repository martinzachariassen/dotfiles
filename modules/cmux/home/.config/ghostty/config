# Read by the libghostty cmux embeds. cmux's own UI is in ~/.config/cmux/cmux.json.

# Left unset, Option becomes Alt/Meta and swallows the combos for AA/AE/OE.
macos-option-as-alt = false

# "Mono" variant keeps Nerd Font glyphs at one cell width. The cask is in this
# module's Brewfile; modules/apps ships only the plain, non-Nerd build.
font-family = "JetBrainsMono Nerd Font Mono"
