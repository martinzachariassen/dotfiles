{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,

  // Subtle divider between split panes in the same window, brighter ring
  // around the focused one.
  "paneBorderColor": "#3A3A3A",
  "activePaneBorderColor": "#5E9EFF",

  "app": {
    // Agent sessions resume on launch, so quitting loses little.
    "confirmQuit": "dirty-only",
    "sendAnonymousTelemetry": false
  },

  // agentPermissionPrompt stays on: it is the one alert that means an agent
  // is stopped until you answer.
  "notifications": {
    "agentTurnComplete": "never",
    "agentIdleReminder": false
  }
}
