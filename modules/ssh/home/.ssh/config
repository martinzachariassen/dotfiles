# No private keys on this machine: 1Password's agent signs. This file names a
# socket, not a secret.

# FIRST: ssh takes the first value it obtains for each keyword, so config.local
# wins. A missing file is fine.
Include ~/.ssh/config.local

Host *
  # 2BUA8C4S2C is AgileBits' team ID, the same on every Mac. Quoted: the path
  # has spaces. Same literal as modules/ssh/doctor.sh.
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

  # NOT `IdentitiesOnly yes`: it limits ssh to IdentityFile entries, of which
  # there are none, and nothing gets offered.
