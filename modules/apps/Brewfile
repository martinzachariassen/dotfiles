# GUI apps and fonts. Things with a window or menu bar item; CLIs go in
# dev-cli.
#
# A cask whose absence would BREAK another module's shipped config ships from
# that module instead (cmux, claude-code, ssh, git, zsh): enabling `apps` must
# never be the undeclared requirement that makes a different module work, and
# module.toml has no field to say so. A cask a module merely prefers stays
# here -- git and zsh both fall back in the open when VS Code is absent.

cask "raycast"
cask "claude"
cask "bruno" # API client; local files, no account
cask "google-chrome"
cask "spotify"
cask "visual-studio-code" # $EDITOR (modules/zsh/home/.zshenv) and git's editor

cask "thaw"  # menu bar manager
cask "stats" # resource monitor in the menu bar

# The plain build only: it keeps editors on stock metrics. The Nerd Font that
# starship and ghostty draw with ships from the modules that name its glyphs.
cask "font-jetbrains-mono"
