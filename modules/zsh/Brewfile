# The shell you sit in. Every alias in home/.config/zsh/aliases.zsh has its
# package here.

brew "starship"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting" # must be sourced last, see .zshrc

brew "eza"     # ls
brew "bat"     # cat
brew "ripgrep" # grep

# Not a preference: home/.config/starship.toml draws the prompt out of Nerd
# Font glyphs, and without the face every one of them renders as a tofu box.
# modules/cmux names the same cask for the same reason -- a module names what
# it needs and brew installs it once, exactly as jq is named twice.
cask "font-jetbrains-mono-nerd-font"
