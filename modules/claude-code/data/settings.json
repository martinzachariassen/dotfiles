{
  "permissions": {
    "defaultMode": "auto"
  },
  "cleanupPeriodDays": 7,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "outputStyle": "concise",
  "spinnerTipsEnabled": false,
  "theme": "custom:catppuccin-latte",
  "inputNeededNotifEnabled": false,
  "agentPushNotifEnabled": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/git-guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
