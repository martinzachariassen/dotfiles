# Brewfile.mac-apps — GUI apps + AI tooling, installed when the macApps module is
# selected. Pure preference; nothing here is required by the shell config.

# ─── Productivity & system ────────────────────────────────────────────────────
cask "google-drive"
cask "jordanbaird-ice@beta"     # menu bar manager
cask "pearcleaner"              # app uninstaller
cask "raycast"                  # Spotlight replacement
cask "stats"                    # menu bar resource monitor

# ─── Notes / Obsidian ─────────────────────────────────────────────────────────
# Vault lives at ~/TheArchive (its own git repo, not chezmoi-managed).
cask "obsidian"
cask "font-inter"               # Obsidian interface font
cask "font-ia-writer-quattro"   # Obsidian editor font
# Obsidian's monospace font is font-jetbrains-mono — declared in the core
# Brewfile (VS Code's editor font), so it's not repeated here.

# ─── Browser ──────────────────────────────────────────────────────────────────
cask "google-chrome"

# ─── Media ────────────────────────────────────────────────────────────────────
cask "spotify"
cask "vlc"

# ─── Development ──────────────────────────────────────────────────────────────
cask "bruno"                    # Postman alternative
cask "fork"                     # git client

# ─── AI tooling + apps ────────────────────────────────────────────────────────
cask "claude"
cask "claude-code"

# ─── Mac App Store apps (mas) ─────────────────────────────────────────────────
# `mas` installs App Store apps declaratively so `brew bundle` reproduces them on
# a fresh Mac (you must be signed in to the App Store first). This is INSTALL-only:
# `brew bundle cleanup` never uninstalls `mas` apps, so removing an app this list
# no longer names stays a manual `mas uninstall <id>` — consistent with this repo's
# "removal is always manual" model. See docs/packages.md.
brew "mas"                      # backs the `mas` lines below
#
# Populate from YOUR machine — `mas` can't be queried from CI, so nothing is
# declared by default. On a signed-in Mac run `mas list` and paste the apps you
# want reproduced, e.g.:
#   mas "Xcode", id: 497799835
#   mas "The Unarchiver", id: 425424353
#   mas "Wipr 2", id: 1662217862
