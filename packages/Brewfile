# Brewfile — CORE tier, always installed. Optional add-ons layer on top from
# packages/Brewfile.<feature>. Entries sorted alphabetically within each section.

# ─── Core CLI ─────────────────────────────────────────────────────────────────
brew "actionlint"              # pre-commit + CI
brew "bats-core"               # runs tests/*.bats
brew "chezmoi"                 # this repo's manager
brew "gh"
brew "git"
brew "git-delta"
brew "gitleaks"                # pre-commit + CI
brew "gum"                     # backs wizard's pickers
brew "jq"
brew "lazygit"
brew "pre-commit"
brew "tlrc"                    # tldr client; tldr formula disabled upstream
brew "typos-cli"               # pre-commit; CI uses the action
brew "zizmor"                  # pre-commit + CI

# ─── Modern CLI replacements (the shell config aliases these by default) ──────
brew "bat"                     # cat
brew "carapace"                # shell completions
brew "eza"                     # ls
brew "fd"                      # find
brew "fzf"                     # fuzzy finder (Ctrl-R)
brew "hadolint"                # Dockerfile linter
brew "ripgrep"                 # grep
brew "shellcheck"              # pre-commit + CI
brew "shfmt"                   # shell formatter
brew "zoxide"                  # smarter cd

# ─── Runtimes ─────────────────────────────────────────────────────────────────
brew "mise"                    # language runtime manager

# ─── Editor (terminal) ────────────────────────────────────────────────────────
brew "neovim"                  # LazyVim config in dot_config/nvim

# ─── Shell ────────────────────────────────────────────────────────────────────
brew "starship"
brew "zellij"                  # tmux alternative
brew "zsh-autosuggestions"     # type-ahead (→ to accept)
brew "zsh-completions"
brew "zsh-syntax-highlighting" # source this last

# ─── GUI essentials (terminal + 1Password are foundational here) ──────────────
cask "1password"               # SSH agent + git signing
cask "1password-cli"           # op CLI; chezmoi secrets
cask "docker-desktop"          # or colima/podman
cask "ghostty"                 # Catppuccin Frappé
cask "visual-studio-code"      # chezmoi manages settings

# JDKs come from mise, not Homebrew — see dot_config/mise/config.toml.

# ─── Fonts ────────────────────────────────────────────────────────────────────
cask "font-jetbrains-mono-nerd-font"   # Ghostty + VS Code

# Mac App Store apps live in the macApps tier — see packages/Brewfile.mac-apps.
