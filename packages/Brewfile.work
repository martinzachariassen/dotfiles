# Brewfile.work — extras layered on core for the `work` profile.

# ─── Cloud / Kubernetes / IaC ─────────────────────────────────────────────────
# Taps first (formulae below resolve from them); the brew-bundle hook trusts each
# declared tap before installing (Homebrew 6.0 ignores untrusted non-official taps).
tap "Azure/kubelogin"
tap "hashicorp/tap"
brew "azure-cli"                 # global Azure account/subscription CLI
brew "Azure/kubelogin/kubelogin" # AKS Azure AD auth plugin for kubectl
brew "hashicorp/tap/terraform"  # IaC — HashiCorp's official tap (latest, BUSL build)
brew "helm"                     # Kubernetes package manager (backs the helm-intellisense ext; keeps it off VS Code's ad-hoc ~/.vs-kubernetes download)
brew "kubectx"                  # kubectx + kubens for context/namespace switching
brew "kubernetes-cli"           # kubectl
brew "minikube"                 # local single-node Kubernetes cluster (VS Code k8s ext otherwise downloads its own copy)
cask "gcloud-cli"               # global Google Cloud account/project CLI

# ─── Work apps ────────────────────────────────────────────────────────────────
# microsoft-office is the full M365 suite; don't also list the standalone
# Word/Excel/Outlook/… casks — it `conflicts_with` them and `brew bundle` fails.
cask "microsoft-office"
cask "microsoft-teams"
cask "slack"
