# Brewfile.work — extras layered on core for the `work` profile.

# ─── Cloud / Kubernetes / IaC ─────────────────────────────────────────────────
# Taps first (formulae below resolve from them); the brew-bundle hook trusts each
# declared tap before installing (Homebrew 6.0 ignores untrusted non-official taps).
tap "Azure/kubelogin"
tap "hashicorp/tap"
brew "azure-cli"                 # account/subscription CLI
brew "Azure/kubelogin/kubelogin" # AKS auth plugin for kubectl
brew "hashicorp/tap/terraform"  # official tap (BUSL build)
brew "helm"                     # backs the helm-intellisense ext
brew "kubectx"                  # + kubens
brew "kubernetes-cli"           # kubectl
brew "minikube"                 # avoids VS Code ext's own download
cask "gcloud-cli"               # GCP account/project CLI

# ─── Work apps ────────────────────────────────────────────────────────────────
# microsoft-office is the full M365 suite; don't also list the standalone
# Word/Excel/Outlook/… casks — it `conflicts_with` them and `brew bundle` fails.
cask "microsoft-office"
cask "microsoft-teams"
cask "slack"
