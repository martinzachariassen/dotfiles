# Forces LF; protects shell scripts/templates from CRLF on Windows clones.
* text=auto eol=lf

*.sh    text eol=lf
*.tmpl  text eol=lf
*.zsh   text eol=lf
*.toml  text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf

*.png   binary
*.jpg   binary
*.icns  binary
