# Force LF line endings on checkout/checkin for everything textual.
# Protects shell scripts and chezmoi templates from accidentally being
# converted to CRLF on Windows clones.
* text=auto eol=lf

*.sh    text eol=lf
*.tmpl  text eol=lf
*.zsh   text eol=lf
*.toml  text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf

# Binary files we don't want git to mangle
*.png   binary
*.jpg   binary
*.icns  binary
