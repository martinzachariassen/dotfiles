# Brewfile.personal — extras for the `personal` profile.
#
# Installed on top of the core Brewfile when your profile is "personal".
# Skipped when your profile is "work".
#
# Run standalone: brew bundle install --file=~/Developer/personal/dotfiles/brewfiles/Brewfile.personal

