# Brewfile.personal — extras for the `personal` profile.
#
# Installed on top of the core Brewfile when your profile is "personal" or
# "both". Skipped when your profile is "work".
#
# Run standalone: brew bundle install --file=~/Dev/Personal/dotfiles/brewfiles/Brewfile.personal

# ─── OpenAI ───────────────────────────────────────────────────────────────────
cask "codex"                    # OpenAI Codex CLI
cask "chatgpt"                  # OpenAI ChatGPT desktop app

# ─── Add your other personal-only apps below ──────────────────────────────────
cask "discord"
cask "steam"
