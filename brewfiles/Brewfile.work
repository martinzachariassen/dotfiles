# Brewfile.work — extras for the `work` profile.
#
# Installed by the brew-bundle chezmoi script ON TOP of the common `Brewfile`
# when your profile is "work". Skipped when your profile is "personal".
# Entries are sorted alphabetically within each section.
#
# Run standalone: brew bundle install --file=~/Developer/personal/dotfiles/brewfiles/Brewfile.work

# ─── Cloud / Kubernetes / IaC ─────────────────────────────────────────────────
# Taps stay first: the kubelogin + terraform formulae below resolve from them.
tap "Azure/kubelogin"
tap "hashicorp/tap"
brew "azure-cli"                 # global Azure account/subscription CLI
brew "Azure/kubelogin/kubelogin" # AKS Azure AD auth plugin for kubectl
brew "hashicorp/tap/terraform"  # IaC — HashiCorp's official tap (latest, BUSL build)
brew "kubectx"                  # kubectx + kubens for context/namespace switching
brew "kubernetes-cli"           # kubectl
cask "gcloud-cli"               # global Google Cloud account/project CLI

# ─── Work apps ────────────────────────────────────────────────────────────────
cask "microsoft-office"
cask "microsoft-outlook"
cask "microsoft-teams"
cask "slack"
