# Brewfile.work — extras for the `work` profile.
#
# Installed by the brew-bundle chezmoi script ON TOP of the common `Brewfile`
# when your profile is "work" or "both". Skipped when your profile is
# "personal".
#
# Run standalone: brew bundle install --file=~/Developer/personal/dotfiles/brewfiles/Brewfile.work

# ─── Cloud / Kubernetes ───────────────────────────────────────────────────────
brew "azure-cli"                # global Azure account/subscription CLI; project kubectl stays in Devbox
brew "azure/kubelogin/kubelogin" # AKS Azure AD auth plugin for kubectl
brew "kubectx"                  # provides kubectx and kubens for context/namespace switching
cask "gcloud-cli"               # global Google Cloud account/project CLI; project kubectl stays in Devbox

# ─── Work apps ────────────────────────────────────────────────────────────────
cask "intellij-idea"            # if Java work
cask "microsoft-teams"
cask "slack"
cask "microsoft-outlook"
