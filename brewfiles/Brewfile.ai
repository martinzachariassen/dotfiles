# Brewfile.ai — optional local AI tooling.
#
# Enable with:
#   dotfiles features enable ai
#
# Models are intentionally not pulled by brew bundle. Run
# `scripts/setup-local-llm.sh` after enabling this feature.

brew "ollama"                   # local model runner/server
brew "llm"                      # Unix-style LLM CLI for shell pipelines
cask "codex"                    # OpenAI Codex CLI
cask "chatgpt"                  # OpenAI ChatGPT desktop app
cask "claude"                   # Anthropic Claude desktop app
cask "claude-code"              # Anthropic Claude Code CLI
