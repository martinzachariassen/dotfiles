#!/usr/bin/env bash
if ((BASH_VERSINFO[0] < 5)); then
  if [[ -x /opt/homebrew/bin/bash ]]; then
    exec /opt/homebrew/bin/bash "$0" "$@"
  fi
  echo "dot needs bash 5 or newer; this is $BASH_VERSION. Run: brew install bash" >&2
  exit 1
fi

set -euo pipefail

# shellcheck source=../lib/dot.sh
source "$(dirname "${BASH_SOURCE[0]}")/../lib/dot.sh"

__DOT_EXIT_WARN=0

__DOT_LOG=''

__transcript_start() {
  local verb=$1 old
  if [[ $DOT_DRY_RUN == 1 ]]; then
    return 0
  fi

  __DOT_LOG="$DOT_STATE/logs/$DOT_RUN_ID-$verb.log"
  mkdir -p "$DOT_STATE/logs"

  touch "$__DOT_LOG"
  while IFS= read -r old; do
    rm -f "$old"
  done < <(find "$DOT_STATE/logs" -maxdepth 1 -type f -name '*.log' | sort -r | tail -n +21)

  # lib/dot.sh's EXIT trap restores fd 3/4 and waits on __DOT_TEE_PID, or the
  # log loses its last lines.
  exec 3>&1 4>&2
  exec > >(sed -l -e "$__UI_FRAME_SED" -e h -e "$__UI_STRIP_SGR" -e "w $__DOT_LOG" -e g) 2>&1
  __DOT_TEE_PID=$!
}

__transcript_end() {
  if [[ -n $__DOT_LOG ]]; then
    say log "${__DOT_LOG/#$HOME/\~}"
  fi
}

usage() {
  __opt() {
    ui_nest
    ui_row 10 "$1" "$2"
    ui_unnest
  }

  heading 'dot' 'one Mac, as code'
  say 'usage: dot <command> [options]'
  dim 'dot <command> --help explains one command in full'

  heading 'Commands'
  say apply 'Make this Mac match the repo: packages, links, module hooks.'
  __opt --dry-run 'print every change it would make, and make none'
  __opt --pull 'fast-forward the repo first, then apply what came down'
  say add 'Enable one module and apply it.'
  __opt '<module>' 'one of the names under Modules below'
  __opt --dry-run 'print what it would do, and do none of it'
  say remove 'Undo one module and disable it. Its packages stay installed.'
  __opt '<module>' 'an enabled module, or one that left something behind'
  __opt --dry-run 'print what it would undo, and undo none of it'
  say config 'Open config.toml in $EDITOR.'
  __opt --init 'write it for the first time, through the picker'
  say doctor 'Check this Mac against the repo. Never changes anything.'
  __opt --verbose 'every check, including the ones that passed'
  __opt --fetch 'git fetch first, so the repo check sees what origin has now'

  heading 'Reading the output'
  ui_legend
  dim 'A module with nothing to do is one line, with the time it took on the right.'

  __usage_modules

  heading 'Exit status'
  ui_row 12 0 'clean, or only warnings'
  ui_row 12 1 'something failed; the last section repeats what'

  heading 'Environment'
  ui_row 18 NO_COLOR 'set to anything: no colour'
  ui_row 18 DOT_ASCII=1 'ASCII markers, the same widths'
  ui_row 18 DOT_PROGRESS=0 'no live progress line while brew downloads'
  ui_row 18 DOT_COLUMNS 'the width to lay out for, 40 to 100'
  ui_row 18 DOT_UI_HEARTBEAT 'seconds of silence before "still running" (15)'

  heading 'Files'
  say config "${DOT_CONFIG/#$HOME/\~}"
  say repo "${DOT_ROOT/#$HOME/\~}"
  say logs "${DOT_STATE/#$HOME/\~}/logs -- one per apply, add and remove"
  say backups "${DOT_STATE/#$HOME/\~}/backups -- files that were in the way"
  say uninstall 'bash uninstall.sh --dry-run   (in the repo; not a verb, on purpose)'
  printf '\n'
}

__usage_modules() {
  local name n=0 on=0
  local -A enabled=()
  if ! command -v dasel >/dev/null 2>&1; then
    heading 'Modules'
    dim 'listed once phase 1 has installed dasel: dot apply'
    return 0
  fi
  if cfg_exists && [[ -z $(cfg_parse_problems) ]]; then
    while IFS= read -r name; do enabled[$name]=1; done < <(modules_enabled)
  fi
  while IFS= read -r name; do
    n=$((n + 1))
    if [[ -n ${enabled[$name]:-} ]]; then on=$((on + 1)); fi
  done < <(modules_all)

  heading 'Modules' "$on of $n enabled"
  while IFS= read -r name; do
    if [[ -n ${enabled[$name]:-} ]]; then
      ui_toggle 1 "$name" "$(module_desc "$name")"
    else
      ui_toggle 0 "$name" "$(module_desc "$name")"
    fi
  done < <(modules_all)
  if ! cfg_exists; then dim 'no config yet: dot config --init'; fi
}

__help() {
  case $1 in
    apply)
      heading 'dot apply' '[--dry-run] [--pull]'
      say 'Makes this Mac match the repo, in this order, and stops before the first'
      say 'write if any read fails:'
      ui_row 12 1 'core packages (bash, dasel, fzf, git, taplo)'
      ui_row 14 2 'read the config, check every module name, parse every hook'
      ui_row 14 3 'per module: Brewfile, then links into $HOME, then apply.sh'
      ui_row 14 4 'the same checks dot doctor runs, showing only what failed'
      dim 'A real file in the way of a link is moved to the backups, never deleted.'
      dim 'Safe to run again: a second run changes nothing and says so.'
      heading 'Options'
      ui_row 14 --dry-run 'the same run, every write turned into a line that says it'
      ui_row 14 --pull 'git pull --ff-only first; refuses over uncommitted changes'
      ;;
    add)
      heading 'dot add' '<module> [--dry-run]'
      say 'Adds one line to the enabled list in config.toml, then applies that'
      say 'module alone. Every other byte of the config is left as it was.'
      ;;
    remove)
      heading 'dot remove' '<module> [--dry-run]'
      say 'Runs the module'"'"'s remove.sh, takes back its links, then drops it from'
      say 'the enabled list. Packages stay: removing those is brew uninstall.'
      ;;
    config)
      heading 'dot config' '[--init]'
      say 'Opens config.toml in $EDITOR. With --init and no config yet, the picker'
      say 'asks for a profile and modules, and writes it.'
      ;;
    doctor)
      heading 'dot doctor' '[--verbose] [--fetch]'
      say 'Checks, read-only, that this Mac still matches the repo: packages, links,'
      say 'what each module'"'"'s doctor.sh asks, stale links, and packages no'
      say 'Brewfile names. A healthy module is one line naming what it checked.'
      heading 'Options'
      ui_row 14 --verbose 'every check, including the ones that passed'
      ui_row 14 --fetch 'git fetch first; the one write, and only inside .git'
      ;;
  esac
  printf '\n'
}

# bash reads this file lazily while it runs, so the pulled bin/dot is exec'd
# rather than continued in this process.
__pull() {
  local repo=${DOT_ROOT/#$HOME/\~} dirty
  info pull "git pull --ff-only in $repo"
  if [[ $DOT_DRY_RUN == 1 ]]; then return 0; fi

  dirty=$(git -C "$DOT_ROOT" status --porcelain) ||
    die 'pull: the repo is not a git checkout' repo "$repo"
  [[ -z $dirty ]] ||
    die 'pull: the repo has uncommitted changes -- not pulling over them' \
      see "git -C $repo status"

  if ! git -C "$DOT_ROOT" pull --ff-only 2>&1 | ui_quote; then
    die 'pull: git could not fast-forward -- nothing was applied' \
      inspect "git -C $repo log --oneline --graph -20"
  fi

  exec "$BASH" "$DOT_ROOT/bin/dot" apply "$@"
}

cmd_apply() {
  local pull=0
  local -a pass=()
  while (($#)); do
    case $1 in
      --dry-run)
        export DOT_DRY_RUN=1
        pass+=("$1")
        ;;
      --pull) pull=1 ;;
      -h | --help)
        __help apply
        return 0
        ;;
      *) die "apply: unknown option '$1'" next 'dot apply [--pull] [--dry-run]' ;;
    esac
    shift
  done

  if ((pull)); then __pull "${pass[@]}"; fi

  __transcript_start apply
  __run_start 'dot apply'

  __core_packages

  if ! cfg_exists; then
    if [[ $DOT_DRY_RUN == 1 ]]; then
      die 'There is no config yet' \
        config "${DOT_CONFIG/#$HOME/\~}" next 'dot config --init'
    fi
    [[ -t 0 ]] ||
      die 'There is no config yet, and no terminal to ask' \
        config "${DOT_CONFIG/#$HOME/\~}" next 'dot config --init'
    command -v fzf >/dev/null ||
      die 'fzf is missing -- phase 1 did not complete' \
        next 'check the brew output above'
    wizard_run
  fi

  local problems
  problems=$(cfg_parse_problems)
  [[ -z $problems ]] ||
    die 'The config did not parse' \
      problem "$problems" edit "${DOT_CONFIG/#$HOME/\~}"

  modules_require_known

  modules_preflight

  local name
  local -a names
  mapfile -t names < <(modules_enabled)

  __ui_render ok read "$(ui_join 'config parses' "$(ui_count "${#names[@]}" module) known" \
    "$(ui_count "$DOT_HOOKS_PARSED" hook) parse")" "$__UI_GROUP_W"

  heading 'Applying' "core + $(ui_count "${#names[@]}" module)"
  __apply_group core 'the shim, and the files this repo owns itself' __apply_core

  if ((${#names[@]} == 0)); then
    say modules "none enabled -- list them under [modules] in ${DOT_CONFIG/#$HOME/\~}"
  fi

  for name in "${names[@]}"; do
    __apply_group "$name" "$(module_desc "$name")" module_apply "$name"
  done

  if [[ $DOT_DRY_RUN != 1 ]]; then
    DOT_UI_HIDE_CLEAN=1
    run_checks 'Checking' 'the same checks as: dot doctor'
    DOT_UI_HIDE_CLEAN=''
  fi

  __run_end
  return 0
}

__RUN_BEGAN=0

# Shared by apply, add and remove: what a run read, before it writes.
__run_start() {
  local title=$1 mode='' tone=''
  __RUN_BEGAN=$(ui_now)
  __UI_TALLY=$(mktemp "${TMPDIR:-/tmp}/dot-changes.XXXXXX")
  if [[ $DOT_DRY_RUN == 1 ]]; then
    mode='DRY RUN -- nothing will change'
    tone=warn
  else
    mode=$(date '+%a %d %b %H:%M')
  fi
  heading "$title" "$mode" "$tone"
  say repo "${DOT_ROOT/#$HOME/\~}"
  say config "${DOT_CONFIG/#$HOME/\~}"
  if [[ -n $__DOT_LOG ]]; then say log "${__DOT_LOG/#$HOME/\~}"; fi
}

__core_packages() {
  if ! brew_load; then
    die 'Homebrew is not installed' next 'bash install.sh'
  fi
  __apply_group packages 'core/Brewfile' brew_bundle "$DOT_ROOT/core/Brewfile" core ||
    die 'Core packages did not install' next 'fix the brew errors above, then re-run'
}

__apply_core() {
  fs_link_tree "$DOT_ROOT/core"
  fold_status 'core apply.sh failed' "$BASH" "$DOT_ROOT/core/apply.sh"
}

# A FIFO and `&`, not `> >(...)`: the renderer must be waited for, or the next
# group starts beside its lines, and $! does not reliably name a substitution.
__apply_group() {
  local name=$1 note=$2 status=0 renderer fifo
  shift 2
  fifo=$(mktemp -u "${TMPDIR:-/tmp}/dot-group.XXXXXX")
  mkfifo "$fifo"
  ui_live_group "$name" "$note" <"$fifo" &
  renderer=$!
  export DOT_UI_RECORDS=1
  "$@" >"$fifo" 2>&1 || status=$?
  unset DOT_UI_RECORDS
  wait "$renderer"
  rm -f "$fifo"
  return "$status"
}

__run_end() {
  local tally n parts
  if [[ $DOT_DRY_RUN == 1 ]]; then
    heading 'Plan' 'dry run' warn
  else
    heading 'Done' "$(ui_duration $(($(ui_now) - __RUN_BEGAN)))"
  fi

  tally=$(ui_changes "$__UI_TALLY")
  rm -f "$__UI_TALLY"
  __UI_TALLY=''
  n=${tally%%$'\t'*}
  parts=${tally#*$'\t'}
  if [[ -z $tally ]]; then
    ok changes 'none -- this Mac already matches the repo'
  elif [[ $DOT_DRY_RUN == 1 ]]; then
    info "$(ui_count "$n" change)" "$parts"
  else
    ok "$(ui_count "$n" change)" "$parts"
  fi

  fs_report
  ui_verdict '' module
  __transcript_end
  if [[ $DOT_DRY_RUN == 1 ]]; then
    if [[ -n $tally ]]; then
      dim 'Dry run: nothing was changed. To make these changes: dot apply'
    else
      dim 'Dry run: nothing was changed.'
    fi
  fi
}

# Never make it print: under `$(...)` the --dry-run export dies and the verb
# acts for real.
__module_arg() {
  local verb=$1
  shift
  __MODULE_NAME=''
  __MODULE_HELP=0
  while (($#)); do
    case $1 in
      --dry-run) export DOT_DRY_RUN=1 ;;
      -h | --help)
        __MODULE_HELP=1
        return 0
        ;;
      -*) die "$verb: unknown option '$1'" next "dot $verb <module> [--dry-run]" ;;
      *)
        [[ -z $__MODULE_NAME ]] ||
          die "$verb: one module at a time -- got '$__MODULE_NAME' and '$1'" \
            next "dot $verb <module>"
        __MODULE_NAME=$1
        ;;
    esac
    shift
  done
  [[ -n $__MODULE_NAME ]] || die "$verb: which module?" next "dot $verb <module>"
}

__module_gate() {
  local verb=$1 name=$2 available problems
  cfg_exists ||
    die 'There is no config yet' \
      config "${DOT_CONFIG/#$HOME/\~}" next 'dot config --init'

  problems=$(cfg_parse_problems)
  [[ -z $problems ]] ||
    die 'The config did not parse' \
      problem "$problems" edit "${DOT_CONFIG/#$HOME/\~}"

  if ! module_exists "$name"; then
    available=$(modules_all | tr '\n' ' ')
    die "$verb: there is no module '$name'" available "${available% }"
  fi
  cfg_enabled_editable ||
    die "$verb: the \`enabled\` list is not in a shape this can edit safely" \
      expected 'one "name", per line' \
      next 'edit it by hand, then run: dot apply'
}

cmd_add() {
  local name
  __module_arg add "$@"
  if ((__MODULE_HELP)); then
    __help add
    return 0
  fi
  name=$__MODULE_NAME
  __transcript_start add
  __module_gate add "$name"

  __run_start "dot add $name"
  __core_packages

  if modules_enabled | grep -qxF -- "$name"; then
    say enabled "'$name' is already in the list -- applying it anyway"
  elif [[ $DOT_DRY_RUN == 1 ]]; then
    info enable "'$name' in ${DOT_CONFIG/#$HOME/\~}"
  elif cfg_module_add "$name"; then
    ok enabled "'$name' in ${DOT_CONFIG/#$HOME/\~}"
  else
    die 'add: could not write the config -- it was left as it was' \
      config "${DOT_CONFIG/#$HOME/\~}"
  fi

  modules_preflight

  heading 'Applying' '1 module'
  __apply_group "$name" "$(module_desc "$name")" module_apply "$name"

  __run_end
  return 0
}

cmd_remove() {
  local name enabled_now=0
  __module_arg remove "$@"
  if ((__MODULE_HELP)); then
    __help remove
    return 0
  fi
  name=$__MODULE_NAME
  __transcript_start remove
  __module_gate remove "$name"

  __run_start "dot remove $name"

  if modules_enabled | grep -qxF -- "$name"; then
    enabled_now=1
  else
    say enabled "'$name' is not in the list -- removing what it left anyway"
  fi

  heading 'Removing' '1 module'
  __apply_group "$name" "$(module_desc "$name")" __remove_module "$name"

  if ((enabled_now)); then
    if [[ $DOT_DRY_RUN == 1 ]]; then
      info remove "'$name' from ${DOT_CONFIG/#$HOME/\~}"
    elif ((DOT_FAILURES > 0)); then
      fail config "left '$name' listed -- fix what failed above, then re-run"
    elif cfg_module_remove "$name"; then
      ok removed "'$name' from ${DOT_CONFIG/#$HOME/\~}"
    else
      fail config "could not be written -- '$name' is still listed"
    fi
  fi

  __run_end
  dim 'Packages stay installed. Removing those is `brew uninstall`, yours to run.'
  return 0
}

# Hook before links: remove.sh may need them still in place.
__remove_module() {
  local dst
  module_remove "$1"
  while IFS=$'\t' read -r _ dst; do
    fs_unlink "$dst"
  done < <(fs_pairs "$(modules_dir "$1")")
}

cmd_config() {
  case ${1:-} in
    -h | --help)
      __help config
      return 0
      ;;
    --init)
      cfg_exists &&
        die 'The config already exists' \
          config "${DOT_CONFIG/#$HOME/\~}" next 'dot config'
      command -v fzf >/dev/null ||
        die 'fzf is missing' next 'dot apply'
      wizard_run
      return 0
      ;;
    '') ;;
    *) die "config: unknown option '$1'" next 'dot config [--init]' ;;
  esac

  cfg_exists || die 'There is no config yet' next 'dot config --init'
  # Unquoted: $EDITOR carries arguments (`code --wait`).
  # shellcheck disable=SC2086
  ${EDITOR:-vi} "$DOT_CONFIG"
}

# Captured by a redirect in this shell, never `$(...)`: a subshell drops the
# tallies.
__checks_sink=''

# Exported, not a `VAR=x fn` prefix: on a function that depends on POSIX mode.
__check_group() {
  local name=$1 note=$2
  shift 2
  export DOT_UI_RECORDS=1
  "$@" >"$__checks_sink" 2>&1
  unset DOT_UI_RECORDS
  ui_group "$name" "$note" "$__checks_sink"
}

__core_checks() {
  local unknown
  while IFS= read -r unknown; do
    fail config "lists unknown module '$unknown' -- dot apply will refuse"
  done < <(modules_unknown)

  brew_check "$DOT_ROOT/core/Brewfile" core
  fold_status 'core checks failed' "$BASH" "$DOT_ROOT/core/doctor.sh"
  fs_check_tree "$DOT_ROOT/core" || fail files 'core files are not linked -- run: dot apply'
}

run_checks() {
  local title=${1:-Checks} note=${2:-}

  __checks_sink=$(mktemp "${TMPDIR:-/tmp}/dot-checks.XXXXXX")

  local name i=0
  local -a names
  mapfile -t names < <(modules_enabled)

  if [[ -z $note ]]; then note="core + $(ui_count "${#names[@]}" module)"; fi
  heading "$title" "$note"
  __check_group core 'the repo, the shim, the config' __core_checks

  for name in "${names[@]}"; do
    i=$((i + 1))
    __check_group "$name" "$(module_desc "$name")" module_doctor "$name"
  done
  rm -f "$__checks_sink"

  if [[ -n ${DOT_UI_HIDE_CLEAN:-} ]] && ((DOT_GROUPS_CLEAN > 0)); then
    ok "$DOT_GROUPS_CLEAN of $DOT_GROUPS_TOTAL clean"
  fi

  __orphan_report
  __unmanaged_report
}

__orphan_report() {
  local mod path found=0 unowned='' repo=${DOT_ROOT/#$HOME/\~}
  local -A bymod=()
  local -a order=()
  while IFS=$'\t' read -r path mod; do
    found=1
    path=${path/#$HOME/\~}
    if [[ -z $mod ]]; then
      unowned+=$path$'\n'
    else
      [[ -n ${bymod[$mod]:-} ]] || order+=("$mod")
      bymod[$mod]+=$path$'\n'
    fi
  done < <(fs_orphans)

  if ((found == 0)); then
    [[ -n ${DOT_UI_HIDE_CLEAN:-} ]] || __ui_render ok orphans 'none' "$__UI_GROUP_W"
    return 0
  fi

  local hooks=0
  for mod in "${order[@]}"; do
    __ui_render warn orphans "$mod is not enabled, and left these links:" "$__UI_GROUP_W"
    ui_nest
    ui_nest
    while IFS= read -r path; do say "$path"; done <<<"${bymod[$mod]%$'\n'}"
    if [[ -f $(modules_dir "$mod")/remove.sh ]]; then
      hooks=$((hooks + 1))
      dim 'rm them -- then undo the rest, which no verb does for you:'
      dim "DOT_ROOT=$repo bash $repo/modules/$mod/remove.sh"
    else
      dim "rm them; $mod leaves nothing else behind."
    fi
    ui_unnest
    ui_unnest
  done

  if [[ -n $unowned ]]; then
    ui_warn_group orphans 'unclaimed -- no module ships these any more:'
    ui_nest
    ui_nest
    while IFS= read -r path; do say "$path"; done <<<"${unowned%$'\n'}"
    dim 'rm them; there is nothing else to undo.'
    ui_unnest
    ui_unnest
  fi

  if ((hooks)); then
    dim 'Add DOT_DRY_RUN=1 to any of those to see what it would do first.'
  fi
}

__unmanaged_report() {
  local out line status=0
  out=$(brew_unmanaged) || status=$?

  case $status in
    0) [[ -n ${DOT_UI_HIDE_CLEAN:-} ]] || __ui_render ok unmanaged 'none' "$__UI_GROUP_W" ;;
    1)
      local n
      n=$(grep -c . <<<"$out")
      __ui_render info unmanaged \
        "$(ui_count "$n" package) no Brewfile names" "$__UI_GROUP_W"
      ui_nest
      ui_nest
      while IFS= read -r line; do say "$line"; done <<<"$out"
      dim 'add one to a module Brewfile and the next machine gets it too.'
      ui_unnest
      ui_unnest
      ;;
    2) __ui_render dim unmanaged 'could not be listed -- brew did not answer' "$__UI_GROUP_W" ;;
  esac
}

__fetch() {
  local repo=${DOT_ROOT/#$HOME/\~}
  info fetch "git fetch in $repo"
  if ! GIT_TERMINAL_PROMPT=0 git -C "$DOT_ROOT" fetch --quiet 2>&1 | ui_quote; then
    warn fetch 'could not reach the remote -- comparing against the last fetch'
  fi
}

cmd_doctor() {
  local fetch=0
  while (($#)); do
    case $1 in
      -v | --verbose) export DOT_VERBOSE=1 ;;
      --fetch) fetch=1 ;;
      -h | --help)
        __help doctor
        return 0
        ;;
      *) die "doctor: unknown option '$1'" next 'dot doctor [--verbose] [--fetch]' ;;
    esac
    shift
  done

  cfg_exists ||
    die 'There is no config yet' \
      config "${DOT_CONFIG/#$HOME/\~}" next 'dot config --init'

  if ((fetch)); then __fetch; fi
  run_checks 'Checking'

  heading 'Result'
  ui_verdict 'Everything looks right.' module
  if [[ -z ${DOT_VERBOSE:-} ]] && ((DOT_FAILURES + DOT_WARNINGS > 0)); then
    dim 'Every check, including the ones that passed: dot doctor --verbose'
  fi
}

case "${1:-}" in
  apply)
    shift
    cmd_apply "$@"
    ;;
  add)
    shift
    cmd_add "$@"
    ;;
  remove)
    shift
    cmd_remove "$@"
    ;;
  config)
    shift
    cmd_config "$@"
    ;;
  doctor)
    shift
    cmd_doctor "$@"
    ;;
  help)
    shift
    case ${1:-} in
      apply | add | remove | config | doctor) __help "$1" ;;
      *) usage ;;
    esac
    ;;
  -h | --help | '')
    usage
    ;;
  *)
    die "dot: unknown command '$1'" see 'dot --help'
    ;;
esac
