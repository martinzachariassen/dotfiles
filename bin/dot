#!/usr/bin/env bash
#
# `dot` -- the dotfiles CLI. Five verbs, hardcoded; full removal is uninstall.sh.

# macOS ships bash 3.2 as /bin/bash; a shell that never sourced Homebrew's
# shellenv would start this under it.
if ((BASH_VERSINFO[0] < 5)); then
  if [[ -x /opt/homebrew/bin/bash ]]; then
    exec /opt/homebrew/bin/bash "$0" "$@"
  fi
  echo "dot needs bash 5 or newer; this is $BASH_VERSION. Run: brew install bash" >&2
  exit 1
fi

set -euo pipefail

# shellcheck source=../lib/dot.sh
source "$(dirname "${BASH_SOURCE[0]}")/../lib/dot.sh"

# Top level, not a hook: `dot doctor && ...` must survive an orphaned link.
__DOT_EXIT_WARN=0

# --- The transcript ----------------------------------------------------------
#
# Only the verbs that CHANGE the machine: apply, add, remove. A tee makes vi
# unusable under `config`, and `doctor` runs as the tail of `apply`, where a
# second transcript would nest. uninstall.sh removes logs/ and must keep
# agreeing they are ours. One file per run, <timestamp>-<verb>.log, twenty kept;
# the timestamp leads and is fixed width, so the rotating sort ignores the verb.
__DOT_LOG=''

__transcript_start() {
  local verb=$1 old
  if [[ $DOT_DRY_RUN == 1 ]]; then
    return 0
  fi

  __DOT_LOG="$DOT_STATE/logs/$DOT_RUN_ID-$verb.log"
  mkdir -p "$DOT_STATE/logs"

  # touch BEFORE the tee, so this run is one of the twenty by construction
  # rather than racing the async redirect.
  touch "$__DOT_LOG"
  while IFS= read -r old; do
    rm -f "$old"
  done < <(find "$DOT_STATE/logs" -maxdepth 1 -type f -name '*.log' | sort -r | tail -n +21)

  # fd 3/4 and __DOT_TEE_PID are the contract with lib/dot.sh's EXIT trap: it
  # restores them and waits, or bash exits unreaped and the log loses the lines
  # naming the failure. 2>&1, because a transcript without the warnings is none.
  exec 3>&1 4>&2
  exec > >(tee -a "$__DOT_LOG") 2>&1
  __DOT_TEE_PID=$!
}

__transcript_end() {
  if [[ -n $__DOT_LOG ]]; then
    dim "Full output: ${__DOT_LOG/#$HOME/\~}"
  fi
}

usage() {
  cat <<'EOF'
usage: dot <command> [options]

  apply     Install packages, link config files, run module hooks.
              --dry-run   Show every intended change, make none.
  add       Enable one module and apply it.        [<module>] [--dry-run]
  remove    Undo one module and disable it.        [<module>] [--dry-run]
              Packages stay; that is `brew uninstall`.
  config    Open the config file in $EDITOR.
              --init      Create it for the first time (runs the wizard).
  doctor    Check this machine. Read-only; never changes anything.

EOF
  # Overridable paths are printed, never baked into the heredoc.
  printf 'Config:  %s\n' "${DOT_CONFIG/#$HOME/\~}"
  printf 'Repo:    %s\n' "${DOT_ROOT/#$HOME/\~}"
  printf 'Remove:  bash uninstall.sh --dry-run   (in the repo; not a verb, on purpose)\n'
}

# --- apply -----------------------------------------------------------------
cmd_apply() {
  # Anything unknown is fatal: `dot apply --dry` must not apply for real.
  while (($#)); do
    case $1 in
      --dry-run) export DOT_DRY_RUN=1 ;;
      *) die "apply: unknown option '$1'. Try: dot apply [--dry-run]" ;;
    esac
    shift
  done

  # After the parse, never before: --dry-run opens no transcript.
  __transcript_start apply

  heading 'dot apply'
  dim "repo    ${DOT_ROOT/#$HOME/\~}"
  dim "config  ${DOT_CONFIG/#$HOME/\~}"
  if [[ -n $__DOT_LOG ]]; then dim "log     ${__DOT_LOG/#$HOME/\~}"; fi
  if [[ $DOT_DRY_RUN == 1 ]]; then dim 'dry run -- nothing will be changed'; fi

  heading 'Applying'
  dim 'Install packages, link files, run each module.'

  # Phase 1 installs dasel and fzf; nothing below may run before it.
  heading 'Core packages'
  if ! brew_load; then
    die 'Homebrew is not installed. Run install.sh first.'
  fi
  brew_bundle "$DOT_ROOT/core/Brewfile" core ||
    die 'Core packages did not install. Fix the brew errors above, then re-run.'

  if ! cfg_exists; then
    # Not under --dry-run: config_generate would not write, so the wizard would
    # ask and discard.
    if [[ $DOT_DRY_RUN == 1 ]]; then
      die "No config at $DOT_CONFIG yet. Create it first: dot config --init"
    fi
    [[ -t 0 ]] ||
      die "No config at $DOT_CONFIG and no terminal to ask. Run: dot config --init"
    command -v fzf >/dev/null ||
      die 'fzf is missing -- phase 1 did not complete. Check the brew output above.'
    wizard_run
  fi

  # Parse check first: a truncated config has no `enabled` key at all, so
  # modules_require_known would wave it through and apply would do nothing.
  local problems
  problems=$(cfg_parse_problems)
  [[ -z $problems ]] || die "$DOT_CONFIG did not parse:
    $problems
    edit:       $DOT_CONFIG"

  # Once, here: modules_enabled is read in subshells and cannot report this.
  modules_require_known

  # Last gate before anything in $HOME moves. Everything above only read.
  modules_preflight

  heading 'Core files'
  fs_link_tree "$DOT_ROOT/core"
  fold_status 'core apply.sh failed' "$BASH" "$DOT_ROOT/core/apply.sh"

  local name i=0
  local -a names
  mapfile -t names < <(modules_enabled)

  heading 'Modules'
  if ((${#names[@]} == 0)); then
    say "None enabled. List them under [modules] in $DOT_CONFIG."
  else
    local list
    list=$(printf ', %s' "${names[@]}")
    say "${#names[@]} enabled: ${list:2}"
  fi

  for name in "${names[@]}"; do
    i=$((i + 1))
    heading "Module: $name  [$i/${#names[@]}]"
    dim "$(module_desc "$name")"
    module_apply "$name"
  done

  # A run that only reports what it attempted is not evidence. Skipped under
  # --dry-run, where every check would report drift the run did not fix.
  if [[ $DOT_DRY_RUN != 1 ]]; then
    heading 'Verifying'
    dim 'Read-only recheck of the same modules -- same as: dot doctor.'
    run_checks
  fi

  heading 'Summary'
  if ((${#names[@]} > 0)); then say "${#names[@]} modules"; fi
  fs_report
  if ((DOT_FAILURES > 0)); then
    fail 'Finished with problems -- see the ✗ marks above.'
  elif ((DOT_WARNINGS > 0)); then
    warn 'Finished. There are warnings above worth a look.'
  else
    ok 'Done.'
  fi
  __transcript_end
  [[ $DOT_DRY_RUN == 1 ]] && dim 'Dry run: nothing was changed.'
  return 0
}

# --- add / remove ------------------------------------------------------------
#
# Five verbs, not three: switching a module OFF had no path at all, since
# `apply` walks only the enabled list and `uninstall.sh` is all-or-nothing.
# The only commands that write to an existing config.toml, and they write one
# array (lib/config.sh) -- one reformatted by hand makes them refuse.

# __module_arg VERB ARGS... -- sets __MODULE_NAME, and DOT_DRY_RUN when asked.
# It must NOT print its answer: read through `$(...)` the --dry-run export would
# be lost in the subshell and the verb would go on to act for real.
__module_arg() {
  local verb=$1
  shift
  __MODULE_NAME=''
  while (($#)); do
    case $1 in
      --dry-run) export DOT_DRY_RUN=1 ;;
      -*) die "$verb: unknown option '$1'. Try: dot $verb <module> [--dry-run]" ;;
      *)
        [[ -z $__MODULE_NAME ]] ||
          die "$verb: one module at a time -- got '$__MODULE_NAME' and '$1'."
        __MODULE_NAME=$1
        ;;
    esac
    shift
  done
  [[ -n $__MODULE_NAME ]] || die "$verb: which module? Try: dot $verb <module>"
}

# Every gate both verbs share, before either touches anything. The config check
# comes first: unlinking a module and then finding the list cannot be edited
# would leave the machine and the file disagreeing.
__module_gate() {
  local verb=$1 name=$2 available problems
  cfg_exists || die "No config at $DOT_CONFIG. Run: dot config --init"

  # dasel stops at a malformed line and exits 0, so `enabled` can read empty on
  # a file that is merely truncated. Splicing a line into that loses the rest.
  problems=$(cfg_parse_problems)
  [[ -z $problems ]] || die "$DOT_CONFIG did not parse:
    $problems
    edit:       $DOT_CONFIG"

  if ! module_exists "$name"; then
    available=$(modules_all | tr '\n' ' ')
    die "$verb: no module '$name'.
    available:  ${available% }"
  fi
  cfg_enabled_editable || die "$verb: the \`enabled\` list in $DOT_CONFIG is not
    in the shape this can edit safely -- one \"name\", per line. Edit it by hand
    instead, then run: dot apply"
}

cmd_add() {
  local name
  __module_arg add "$@"
  name=$__MODULE_NAME
  __transcript_start add
  __module_gate add "$name"

  heading "dot add $name"
  dim "config  ${DOT_CONFIG/#$HOME/\~}"
  if [[ -n $__DOT_LOG ]]; then dim "log     ${__DOT_LOG/#$HOME/\~}"; fi

  # Phase 1 first, as cmd_apply orders it: `brew_load` alone is not that.
  heading 'Core packages'
  if ! brew_load; then
    die 'Homebrew is not installed. Run install.sh first.'
  fi
  brew_bundle "$DOT_ROOT/core/Brewfile" core ||
    die 'Core packages did not install. Fix the brew errors above, then re-run.'

  if modules_enabled | grep -qxF -- "$name"; then
    say "'$name' is already enabled. Applying it anyway."
  elif [[ $DOT_DRY_RUN == 1 ]]; then
    info "add '$name' to ${DOT_CONFIG/#$HOME/\~}"
  elif cfg_module_add "$name"; then
    ok "added '$name' to ${DOT_CONFIG/#$HOME/\~}"
  else
    die "add: could not write $DOT_CONFIG -- it was left as it was"
  fi

  # After the config write, so the module being added is one of the hooks this
  # parses -- a syntax error in it must stop before anything in $HOME moves.
  modules_preflight

  heading "Module: $name"
  dim "$(module_desc "$name")"
  module_apply "$name"

  heading 'Summary'
  fs_report
  if ((DOT_FAILURES > 0)); then
    fail 'Finished with problems -- see the ✗ marks above.'
  else
    ok 'Done.'
  fi
  __transcript_end
  [[ $DOT_DRY_RUN == 1 ]] && dim 'Dry run: nothing was changed.'
  return 0
}

cmd_remove() {
  local name enabled_now=0
  __module_arg remove "$@"
  name=$__MODULE_NAME
  __transcript_start remove
  __module_gate remove "$name"

  heading "dot remove $name"
  dim "config  ${DOT_CONFIG/#$HOME/\~}"
  if [[ -n $__DOT_LOG ]]; then dim "log     ${__DOT_LOG/#$HOME/\~}"; fi

  # A module already out of the list still gets the sweep: that is the state
  # this verb exists to clean up, and it is what a hand-edited config leaves.
  if modules_enabled | grep -qxF -- "$name"; then
    enabled_now=1
  else
    say "'$name' is not in the list; removing what it left anyway."
  fi

  heading "Module: $name"
  dim "$(module_desc "$name")"

  # Hooks before links, the order uninstall.sh uses: remove.sh exists for what
  # the symlink sweep cannot see, and may look at the module while it is whole.
  module_remove "$name"

  local dst
  while IFS=$'\t' read -r _ dst; do
    fs_unlink "$dst"
  done < <(fs_pairs "$(modules_dir "$name")")

  # The config last, so it is the commit point: anything above that failed
  # leaves the module still listed, and re-running is the fix.
  if ((enabled_now)); then
    if [[ $DOT_DRY_RUN == 1 ]]; then
      info "remove '$name' from ${DOT_CONFIG/#$HOME/\~}"
    elif ((DOT_FAILURES > 0)); then
      fail "left '$name' in $DOT_CONFIG -- fix the ✗ above, then re-run"
    elif cfg_module_remove "$name"; then
      ok "removed '$name' from ${DOT_CONFIG/#$HOME/\~}"
    else
      fail "could not write $DOT_CONFIG -- '$name' is still listed"
    fi
  fi

  heading 'Summary'
  # Said every time: the one thing this verb does not do, and "removed" reads
  # as if it had.
  dim 'Packages stay installed. Removing those is `brew uninstall`, yours to run.'
  if ((DOT_FAILURES > 0)); then
    fail 'Finished with problems -- see the ✗ marks above.'
  elif ((DOT_WARNINGS > 0)); then
    warn 'Finished. There are warnings above worth a look.'
  else
    ok 'Done.'
  fi
  __transcript_end
  [[ $DOT_DRY_RUN == 1 ]] && dim 'Dry run: nothing was changed.'
  return 0
}

# --- config ----------------------------------------------------------------
cmd_config() {
  case ${1:-} in
    --init)
      cfg_exists && die "$DOT_CONFIG already exists. Edit it with: dot config"
      command -v fzf >/dev/null || die 'fzf is missing. Run `dot apply` first.'
      wizard_run
      return 0
      ;;
    '') ;;
    *) die "config: unknown option '$1'. Try: dot config [--init]" ;;
  esac

  cfg_exists || die "No config yet. Create it with: dot config --init"
  # Unquoted: $EDITOR carries arguments (`code --wait`).
  # shellcheck disable=SC2086
  ${EDITOR:-vi} "$DOT_CONFIG"
}

# --- checks ----------------------------------------------------------------
# Shared by `doctor` and the tail of `apply`. Safe there because contract.bats
# proves no doctor.sh writes to $HOME.
run_checks() {
  heading 'Core'
  # `fail`: this is exactly what will stop the next apply.
  local unknown
  while IFS= read -r unknown; do
    fail "config lists unknown module '$unknown' -- dot apply will refuse"
  done < <(modules_unknown)

  brew_check "$DOT_ROOT/core/Brewfile" core
  fold_status 'core checks failed' "$BASH" "$DOT_ROOT/core/doctor.sh"
  fs_check_tree "$DOT_ROOT/core" || fail 'core files are not linked -- run: dot apply'

  local name i=0
  local -a names
  mapfile -t names < <(modules_enabled)
  for name in "${names[@]}"; do
    i=$((i + 1))
    heading "Module: $name  [$i/${#names[@]}]"
    dim "$(module_desc "$name")"
    module_doctor "$name"
  done

  # Reported, never deleted. Grouped by module because the two causes need
  # opposite advice: for a path the repo no longer ships `rm` is the whole fix;
  # for a module switched off it is a false all-clear, since nothing runs a
  # disabled module's remove.sh and its defaults and generated files stay.
  heading 'Orphaned links'
  local mod path found=0 unowned='' repo=${DOT_ROOT/#$HOME/\~}
  local -A bymod=()
  local -a order=()
  while IFS=$'\t' read -r path mod; do
    found=1
    path=${path/#$HOME/\~}
    if [[ -z $mod ]]; then
      unowned+=$path$'\n'
    else
      [[ -n ${bymod[$mod]:-} ]] || order+=("$mod")
      bymod[$mod]+=$path$'\n'
    fi
  done < <(fs_orphans)

  if ((found == 0)); then
    ok 'none'
    return 0
  fi

  # Whether the module HAS a remove.sh decides the advice. The same test
  # uninstall.sh makes before module_remove.
  local hooks=0
  for mod in "${order[@]}"; do
    warn "$mod is not enabled, and left these links:"
    while IFS= read -r path; do say "    $path"; done <<<"${bymod[$mod]%$'\n'}"
    if [[ -f $(modules_dir "$mod")/remove.sh ]]; then
      hooks=$((hooks + 1))
      dim '  rm them -- then undo the rest, which no verb does for you:'
      dim "  DOT_ROOT=$repo bash $repo/modules/$mod/remove.sh"
    else
      dim "  rm them; $mod leaves nothing else behind."
    fi
  done

  if [[ -n $unowned ]]; then
    warn 'unclaimed -- no module ships these any more:'
    while IFS= read -r path; do say "    $path"; done <<<"${unowned%$'\n'}"
    dim '  rm them; there is nothing else to undo.'
  fi

  if ((hooks)); then
    dim 'Add DOT_DRY_RUN=1 to any of those to see what it would do first.'
  fi
}

# --- doctor ----------------------------------------------------------------
cmd_doctor() {
  cfg_exists || die "No config at $DOT_CONFIG. Run: dot config --init"

  run_checks

  # No count: a hook's three problems arrive as one rolled-up failure, and a
  # summary may not contradict the lines above it.
  heading 'Result'
  if ((DOT_FAILURES > 0)); then
    fail 'Problems found -- see the ✗ marks above.'
  elif ((DOT_WARNINGS > 0)); then
    warn 'No problems found. There are warnings above worth a look.'
  else
    ok 'Everything looks right.'
  fi
}

# --- dispatch --------------------------------------------------------------
case "${1:-}" in
  apply)
    shift
    cmd_apply "$@"
    ;;
  add)
    shift
    cmd_add "$@"
    ;;
  remove)
    shift
    cmd_remove "$@"
    ;;
  config)
    shift
    cmd_config "$@"
    ;;
  doctor)
    shift
    cmd_doctor "$@"
    ;;
  -h | --help | help | '')
    usage
    ;;
  *)
    printf 'dot: unknown command %s\n\n' "$1" >&2
    usage >&2
    exit 1
    ;;
esac
