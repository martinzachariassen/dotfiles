// Personal devcontainer template — copy this .devcontainer/ folder into a
// project to get a full local-environment replica inside the container.
//
// This is an opt-in personal setup, not a team baseline. For a shared team
// devcontainer, start fresh and include only what the team agrees on.
//
// What this provides:
//   - The full extension set from the host Mac, minus host-only and cosmetic
//     ones (themes, Remote Containers, CodeTogether, Claude Code, Norwegian
//     spell-check pack). Runtime-dependent extensions are commented out below
//     — uncomment per project type after confirming the runtime is in the image.
//   - setup.sh (postCreateCommand) installs the CLI binaries those extensions
//     shell out to: ripgrep (Todo-Tree), shfmt, hadolint. Run it once on
//     container create; safe to re-run (idempotent).
//   - The two-way cSpell personal dictionary, bind-mounted from the host so
//     "Add to dictionary" writes through to the dotfiles-tracked file.
//   - JDK path overrides that clear the Mac mise paths so the container's own
//     JAVA_HOME wins for the Java/Kotlin language servers.
//
// Adjust `image` to match what the project needs (JDK, Python, Node, etc.) —
// the language runtime is the image's job, never mise's inside a container.
{
    "name": "personal",
    "image": "mcr.microsoft.com/devcontainers/base:debian",
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {}
    },
    // Run once on container create. Installs the CLI binaries the extensions
    // need but don't bundle (ripgrep, shfmt, hadolint).
    "postCreateCommand": "bash .devcontainer/setup.sh",
    // Bind-mount the host's cSpell personal dictionary so "Add to dictionary"
    // writes the same repo-tracked file as on the Mac.
    "mounts": [
        "source=${localEnv:HOME}/.config/cspell/personal.txt,target=/cspell/personal.txt,type=bind"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                // ── Editor / general productivity ──
                "editorconfig.editorconfig",
                "usernamehw.errorlens",
                "oderwat.indent-rainbow",
                "streetsidesoftware.code-spell-checker",
                "gruntfuggly.todo-tree",
                "wmaurer.change-case",
                "vscodevim.vim",
                "humao.rest-client",
                "bierner.markdown-mermaid",
                "davidanson.vscode-markdownlint",
                // ── Git / GitHub ──
                "eamodio.gitlens",
                "mhutchie.git-graph",
                "github.vscode-pull-request-github",
                "github.vscode-github-actions",
                "vivaxy.vscode-conventional-commits",
                // ── Formatters / linters ──
                "esbenp.prettier-vscode",
                "dbaeumer.vscode-eslint",
                "timonwong.shellcheck",
                "foxundermoon.shell-format",
                "exiasr.hadolint",
                "charliermarsh.ruff",
                // ── Config formats ──
                "redhat.vscode-yaml",
                "redhat.vscode-xml",
                "tamasfe.even-better-toml",
                "hashicorp.hcl",
                "hashicorp.terraform",
                "tim-koehler.helm-intellisense",
                // ── Database ──
                "ms-ossdata.vscode-pgsql",
                // ── Runtime-dependent — uncomment per project type ──
                // Java / Kotlin / Spring (needs a JDK in the image):
                // "redhat.java",
                // "vscjava.vscode-java-pack",
                // "vscjava.vscode-java-debug",
                // "vscjava.vscode-java-dependency",
                // "vscjava.vscode-java-test",
                // "vscjava.vscode-maven",
                // "vscjava.vscode-gradle",
                // "vscjava.vscode-spring-boot-dashboard",
                // "vscjava.vscode-spring-initializr",
                // "vmware.vscode-spring-boot",
                // "jetbrains.kotlin-server",
                // Python (needs a Python interpreter in the image):
                // "ms-python.python",
                // SonarQube (needs Node >= 20.12 in the image, or set
                // "sonarlint.pathToNodeExecutable"):
                // "sonarsource.sonarlint-vscode",
                // Docker / Kubernetes (need a docker socket / kubectl + kubeconfig):
                // "ms-azuretools.vscode-containers",
                // "ms-kubernetes-tools.vscode-kubernetes-tools",
                // mise (only useful if mise is installed in the image):
                // "hverlin.mise-vscode"
            ],
            "settings": {
                // Point cSpell at the mounted dictionary. The host user setting
                // pins it to a Mac path that doesn't exist inside the container.
                "cSpell.customDictionaries": {
                    "personal": {
                        "name": "personal",
                        "path": "/cspell/personal.txt",
                        "addWords": true,
                        "scope": "user"
                    }
                },
                // Clear the host JDK paths (pinned to the Mac's mise installs)
                // so the Java/Kotlin language servers fall back to JAVA_HOME.
                // Inert on non-Java projects.
                "java.jdt.ls.java.home": "",
                "java.import.gradle.java.home": "",
                "java.configuration.runtimes": [],
                "intellij.jdkForSymbolResolution": ""
            }
        }
    }
}
