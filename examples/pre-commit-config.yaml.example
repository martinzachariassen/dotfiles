# .pre-commit-config.yaml — git hook framework
# Reference: https://pre-commit.com
#
# Activate by:  cp pre-commit-config.yaml.example /path/to/project/.pre-commit-config.yaml \
#               && cd /path/to/project && pre-commit install
#
# After install, hooks run automatically on `git commit`. Failed hooks block
# the commit; many fix files in place — re-stage and re-commit.
#
# Run manually any time:  pre-commit run --all-files

repos:
  # ─── Universal hygiene (every project) ─────────────────────────────────────
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v4.6.0
    hooks:
      - id: trailing-whitespace                 # strip trailing spaces
      - id: end-of-file-fixer                   # ensure files end in a newline
      - id: check-yaml                          # validate YAML syntax
      - id: check-toml                          # validate TOML syntax
      - id: check-json                          # validate JSON syntax
      - id: check-merge-conflict                # block files with <<<<<<< markers
      - id: check-added-large-files             # warn on >500 kB by default
      - id: check-case-conflict                 # block clashes on case-insensitive FS
      - id: check-executables-have-shebangs
      - id: check-shebang-scripts-are-executable
      - id: mixed-line-ending
        args: [--fix=lf]

  # ─── Shell scripts ─────────────────────────────────────────────────────────
  - repo: https://github.com/koalaman/shellcheck-precommit
    rev: v0.10.0
    hooks:
      - id: shellcheck

  # ─── Python (uncomment if it's a Python project) ───────────────────────────
  # - repo: https://github.com/astral-sh/ruff-pre-commit
  #   rev: v0.6.9
  #   hooks:
  #     - id: ruff                              # lint
  #       args: [--fix]
  #     - id: ruff-format                       # format

  # ─── JavaScript / TypeScript ───────────────────────────────────────────────
  # - repo: https://github.com/pre-commit/mirrors-prettier
  #   rev: v4.0.0-alpha.8
  #   hooks:
  #     - id: prettier
  #       types_or: [javascript, typescript, jsx, tsx, json, yaml, markdown]

  # ─── Java (Google Java Format via spotless wrapper) ────────────────────────
  # - repo: https://github.com/macisamuele/language-formatters-pre-commit-hooks
  #   rev: v2.14.0
  #   hooks:
  #     - id: pretty-format-java
  #       args: [--autofix, --aosp]

  # ─── Terraform / OpenTofu ──────────────────────────────────────────────────
  # - repo: https://github.com/antonbabenko/pre-commit-terraform
  #   rev: v1.96.1
  #   hooks:
  #     - id: terraform_fmt
  #     - id: terraform_validate
  #     - id: terraform_tflint

  # ─── Dockerfiles (uncomment if the project ships images) ───────────────────
  # - repo: https://github.com/hadolint/hadolint
  #   rev: v2.13.1-beta
  #   hooks:
  #     - id: hadolint-docker                   # runs hadolint in a container

  # ─── GitHub Actions workflows (uncomment if the repo has .github/workflows) ─
  # - repo: https://github.com/rhysd/actionlint
  #   rev: v1.7.7
  #   hooks:
  #     - id: actionlint                        # validates workflow syntax + shell in run:

  # ─── Secrets — block accidental token commits ──────────────────────────────
  - repo: https://github.com/gitleaks/gitleaks
    rev: v8.21.2
    hooks:
      - id: gitleaks                            # scans staged content for credentials
