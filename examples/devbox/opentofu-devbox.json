{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.2/.schema/devbox.schema.json",
  "packages": [
    "opentofu",
    "tflint",
    "terraform-docs"
  ],
  "shell": {
    "init_hook": [
      "echo 'opentofu devbox ready'"
    ],
    "scripts": {
      "fmt": "tofu fmt -recursive",
      "validate": "tofu validate",
      "docs": "terraform-docs markdown table ."
    }
  }
}
