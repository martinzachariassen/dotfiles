{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.2/.schema/devbox.schema.json",
  "packages": [
    "jdk21",
    "gradle",
    "nodejs@lts",
    "python313",
    "postgresql_16",
    "redis",
    "pgcli"
  ],
  "shell": {
    "init_hook": [
      "echo 'backend devbox ready'"
    ],
    "scripts": {
      "db:version": "postgres --version",
      "redis:version": "redis-server --version"
    }
  }
}
