# .envrc — direnv config for a project. Loaded automatically when you `cd` in.
# Projects under whitelisted roots (see ~/.config/direnv/direnv.toml) are
# trusted by default; everywhere else needs a one-time `direnv allow`.
#
# Pair this with a devbox.json sitting next to it (run `devbox init` to scaffold,
# then `devbox add jdk21 kotlin postgresql_16 ...` to pin the toolchain).
#
# Activate by:  cp envrc.example /path/to/project/.envrc
#               cd /path/to/project && devbox init     # if you haven't yet
#               (direnv allow                          # only if outside whitelist)
# Edit by:      direnv edit            # opens in $EDITOR, re-allows on save

# ─── Runtime toolchain via devbox ────────────────────────────────────────────
# Ask devbox to emit the direnv integration for this project. It reads
# devbox.json in this directory and exports the project's Nix-built tools
# (Postgres / Node / gradle / etc.) into the shell, scoped to this dir only and
# reverted on `cd` out.
eval "$(devbox generate direnv --print-envrc)"

# ─── Java version (Homebrew Temurin, stable paths) ───────────────────────────
# JDKs are installed globally via Homebrew (Brewfile: temurin@21, temurin@25) so
# the editor and CLI share one stable path — VS Code's Java server stops losing
# its classpath the way it does with devbox's churning /nix/store paths. Drop
# "jdk*" from devbox.json so it doesn't re-export a Nix JDK over the line below.
#
# Gradle's `toolchain {}` already auto-selects the JDK to *compile* with, so this
# is mostly for Maven (whose compiler runs on JAVA_HOME) or plain `java`/kotlinc.
# Set it after the devbox eval above so it wins. Pick the major you want:
export JAVA_HOME="$(/usr/libexec/java_home -v 21)"   # or -v 25  (list: java_home -V)

# ─── Project-local environment variables ─────────────────────────────────────
# These exist while you're in this directory, gone when you leave.
export DATABASE_URL="postgres://localhost:5432/myapp_dev"
export SPRING_PROFILES_ACTIVE="local"

# ─── Project bin/ on PATH ────────────────────────────────────────────────────
# `PATH_add` is a direnv stdlib helper — prepends to PATH only inside this dir.
# Useful for project-local scripts (./bin/run-tests, ./bin/migrate, etc.)
PATH_add ./bin

# ─── Secrets pulled from 1Password (uncomment to use) ────────────────────────
# Requires the 1Password CLI (`op`, installed via Brewfile cask "1password-cli").
# Sign in once with `op signin`; thereafter direnv can fetch values on demand.
# Each call hits 1Password, so cache the results in a local var if you call them
# repeatedly inside the same .envrc.
#
# export STRIPE_API_KEY="$(op read 'op://Personal/Stripe Test/api-key')"
# export GITHUB_TOKEN="$(op read 'op://Work/GitHub PAT/token')"

# ─── Local-only overrides (not committed) ────────────────────────────────────
# If a .envrc.local exists alongside this file, source it. Pattern: keep the
# committed .envrc clean; put machine-specific paths/credentials in .envrc.local
# (which is in our global .gitignore — see ~/.config/git/ignore).
[ -f .envrc.local ] && source_env .envrc.local
