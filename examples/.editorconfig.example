# .editorconfig — cross-editor formatting baseline. See https://editorconfig.org
#
# The single most reliable way to get "same result for everyone": commit this to
# a project root. Every EditorConfig-aware editor (VS Code via the editorconfig
# extension, IntelliJ natively, Vim/Neovim, …) reads it, so indent/charset/EOL/
# final-newline stay identical regardless of who edits or how. Formatters
# (Prettier, shfmt, gofmt) also honor it.
#
# Activate:  cp examples/.editorconfig.example /path/to/project/.editorconfig
root = true

[*]
charset                  = utf-8
end_of_line              = lf
insert_final_newline     = true
trim_trailing_whitespace = true
indent_style             = space
indent_size              = 4

[*.{md,markdown}]
trim_trailing_whitespace = false   # markdown uses two trailing spaces for line breaks

[*.{yml,yaml}]
indent_size              = 2

[*.{json,jsonc}]
indent_size              = 4

[*.{kt,kts}]
indent_size              = 4

[*.{xml,pom}]
indent_size              = 4

[*.{tf,tfvars,hcl}]
indent_size              = 2

[*.{js,ts,jsx,tsx,css,scss,html}]
indent_size              = 2

[Makefile]
indent_style             = tab
