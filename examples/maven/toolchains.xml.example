<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven toolchains — Option B for picking a JDK independent of JAVA_HOME.

  Most projects don't need this: Gradle auto-selects the JDK via toolchain {},
  and for Maven the JAVA_HOME that `mise activate` exports (from the project's
  mise.toml) is usually enough. Use this only when you want a Maven build to
  compile with a specific JDK regardless of which JDK launched `mvn`.

  Setup:
    cp examples/maven/toolchains.xml.example ~/.m2/toolchains.xml
  The <jdkHome> paths below point at mise's stable install dirs
  (~/.local/share/mise/installs/java/temurin-<major>/...). Those dirs are a
  fixed name per major version, so unlike the old Homebrew-cask paths they do
  NOT move on a JDK patch update — no bumping needed. This file is intentionally
  NOT chezmoi-managed. Maven interpolates ${user.home}; if your Maven is too old
  to do so, replace it with your absolute home path.

  A project opts in via the maven-toolchains-plugin in its pom.xml:

    <plugin>
      <groupId>org.apache.maven.plugins</groupId>
      <artifactId>maven-toolchains-plugin</artifactId>
      <version>3.2.0</version>
      <configuration>
        <toolchains>
          <jdk><version>21</version></jdk>
        </toolchains>
      </configuration>
      <executions>
        <execution><goals><goal>toolchain</goal></goals></execution>
      </executions>
    </plugin>
-->
<toolchains xmlns="http://maven.apache.org/TOOLCHAINS/1.1.0"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://maven.apache.org/TOOLCHAINS/1.1.0 http://maven.apache.org/xsd/toolchains-1.1.0.xsd">
  <toolchain>
    <type>jdk</type>
    <provides>
      <version>21</version>
      <vendor>temurin</vendor>
    </provides>
    <configuration>
      <jdkHome>${user.home}/.local/share/mise/installs/java/temurin-21/Contents/Home</jdkHome>
    </configuration>
  </toolchain>
  <toolchain>
    <type>jdk</type>
    <provides>
      <version>25</version>
      <vendor>temurin</vendor>
    </provides>
    <configuration>
      <jdkHome>${user.home}/.local/share/mise/installs/java/temurin-25/Contents/Home</jdkHome>
    </configuration>
  </toolchain>
</toolchains>
