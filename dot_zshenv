# ~/.zshenv — read by every zsh invocation (interactive, login, scripts) BEFORE any
# other rc file. Only file that MUST stay in $HOME, because zsh reads it before
# environment variables are set.
#
# Keep this minimal. Only env vars universally needed go here.
# Interactive shell config (aliases, completions, history opts) lives in
# $ZDOTDIR/.zshrc — see ~/.config/zsh/.zshrc.

# ─── Tell zsh where to find the rest of its config ────────────────────────────
export ZDOTDIR="$HOME/.config/zsh"

# ─── XDG Base Directory paths ─────────────────────────────────────────────────
# These are the spec defaults; setting explicitly so XDG-aware tools agree.
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"

# ─── Redirect tool dirs out of $HOME into XDG paths ───────────────────────────
export GRADLE_USER_HOME="$XDG_CONFIG_HOME/gradle"   # was ~/.gradle
export NPM_CONFIG_CACHE="$XDG_CACHE_HOME/npm"       # was ~/.npm
export HISTFILE="$XDG_STATE_HOME/zsh/history"       # was ~/.zsh_history
# git auto-detects ~/.config/git/{config,ignore} — no env var needed.
# claude-personal lives under ~/.config/claude/personal — see wrapper in .zshrc.

# ─── Disable Apple Terminal session-save (we use Ghostty; .zsh_sessions is clutter) ─
export SHELL_SESSIONS_DISABLE=1

# ─── Pager behaviour ──────────────────────────────────────────────────────────
# Default `less` is "stay open until q", with no on-screen reminder that q is
# the way out. That makes short diffs feel like you're stuck in vim — chezmoi
# diff, git log, git diff, etc. all hit this.
#
#   F = quit-if-one-screen   short output auto-exits, no key needed
#   R = raw ANSI colors      delta's syntax highlighting comes through
#   K = quit on interrupt    Ctrl-C exits less (instead of just interrupting
#                            an in-progress search)
#   -P… = custom prompt      Replaces the cryptic default ":" / "(END)" status
#                            line with a visible reminder of how to escape.
#
# NOT using -X (no-terminal-init): with -X, less prints content + status line
# to your normal terminal stream, which means the "Press q…" prompt sticks
# around in your scrollback as a stale artifact every time less auto-quits.
# Without -X, less uses the alternate-screen buffer — content and prompt
# vanish cleanly on exit, leaving your terminal as it was before. To re-view a
# diff, just re-run the command.
#
# Three ways to escape any pager: q · Ctrl-C · (short content auto-exits).
# The -P prompt is double-quoted so less treats spaces inside as one argument.
export LESS='-FRK -P"Press q or Ctrl-C to quit · / search · h for help"'

# ─── PATH ─────────────────────────────────────────────────────────────────────
export PATH="$HOME/.local/bin:$PATH"
