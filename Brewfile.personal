# Brewfile.personal — extras for the `personal` profile.
#
# Installed on top of the core Brewfile when your profile is "personal" or
# "both". Skipped when your profile is "work".
#
# Run standalone: brew bundle install --file=~/Dev/Personal/dotfiles/Brewfile.personal

# ─── Claude Code (personal profile uses these) ───────────────────────────────
# Work machines get Claude Code via storecode (managed by employer's tooling),
# so we don't install the personal CLI cask there — that would create a binary
# collision at /opt/homebrew/bin/claude.
cask "claude"                   # Claude desktop GUI app
cask "claude-code@latest"       # Claude Code CLI (rolling channel)

# ─── Add your other personal-only apps below ──────────────────────────────────
# cask "spotify"
# cask "discord"
# cask "steam"
# cask "vlc"
