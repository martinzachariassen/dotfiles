# Brewfile.cloud — Kubernetes + cloud provider CLIs.
#
# Installed when `features.cloud = true` in chezmoi data (set via the install
# wizard, or by editing ~/.config/chezmoi/chezmoi.toml directly).
#
# This is the "do you do cloud / k8s work?" toggle. Skip it if you're a pure
# local-dev or non-cloud shop; you can flip it on later without re-running the
# wizard.
#
# Note on gke-gcloud-auth-plugin: Google distributes it as a gcloud SDK
# component, not a brew formula. bootstrap-auth.sh installs it after you've run
# `gcloud auth login`, since the install requires an authenticated SDK.

# ─── Kubernetes ───────────────────────────────────────────────────────────────
brew "kubernetes-cli"                  # kubectl
brew "kubectx"                         # also installs `kubens` — switch contexts/namespaces fast
brew "k9s"                             # kubernetes TUI
brew "stern"                           # multi-pod log tailing
brew "helm"                            # chart packaging + install

# ─── Azure ────────────────────────────────────────────────────────────────────
brew "azure-cli"                       # `az` — sign in via `az login`
brew "Azure/kubelogin/kubelogin"       # required for kubectl against AKS clusters using Azure AD

# ─── Google Cloud ─────────────────────────────────────────────────────────────
cask "gcloud-cli"                      # `gcloud`, `gsutil`, `bq`; was named google-cloud-sdk before 2025
