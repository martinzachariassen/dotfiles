{{/* Upgrade safety: dig defaults useOnePassword to true if the key is missing
     (pre-upgrade configs). Signing is only actually emitted when there's a
     signing key, so missing-key users don't get a broken config. */ -}}
{{- $useOP := dig "useOnePassword" true . -}}
[user]
    name = {{ .name }}
    email = {{ .email }}
{{- if and $useOP .signingKey }}
    signingkey = {{ .signingKey }}
{{- end }}

[init]
    defaultBranch = main

{{ if and $useOP .signingKey -}}
# Commit signing is enabled because useOnePassword=true and signingKey is set.
# To disable: edit ~/.config/chezmoi/chezmoi.toml — set useOnePassword=false or
# blank out signingKey — then `chezmoi apply`.
[commit]
    gpgsign = true

[gpg]
    format = ssh

[gpg "ssh"]
    program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
{{- end }}

[core]
    editor = nvim
    pager = delta
    # Global ignore lives at ~/.config/git/ignore (XDG)

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    line-numbers = true
    side-by-side = false
    # Pager wired with the same flags as $LESS in ~/.zshenv:
    #   F = auto-exit when content fits in one screen
    #   R = raw ANSI colors so delta's syntax highlighting renders
    #   K = Ctrl-C quits less (instead of interrupting in-progress search)
    #   -P… = custom status line showing how to escape, instead of the cryptic ":"
    # NOT using -X — see the rationale in ~/.zshenv. Without -X, less uses the
    # alt-screen buffer so content + status line vanish cleanly on exit
    # instead of cluttering scrollback.
    pager = "less -FRK -P'Press q or Ctrl-C to quit · / search · h for help'"

[diff]
    colorMoved = default
    algorithm = histogram

[merge]
    conflictstyle = zdiff3

[push]
    default = simple
    autoSetupRemote = true
    followTags = true

[pull]
    rebase = true
    ff = only

[rebase]
    autoStash = true
    autoSquash = true

[rerere]
    enabled = true

[fetch]
    prune = true
    pruneTags = true

[branch]
    sort = -committerdate

[help]
    autocorrect = prompt

[alias]
    s   = status -sb
    co  = checkout
    sw  = switch
    br  = branch --sort=-committerdate
    lg  = log --oneline --graph --decorate -20
    last = log -1 HEAD --stat
    unstage = reset HEAD --
    amend = commit --amend --no-edit
    fixup = commit --fixup
    wip  = !git add -A && git commit -m 'wip' --no-verify
    undo = reset --soft HEAD~1

# URL rewrites — push always goes via SSH, even if cloned via HTTPS
[url "git@github.com:"]
    pushInsteadOf = https://github.com/
