{{ if eq .profile "work" -}}
# ─── Work-only shell config (rendered because profile = {{ .profile }}) ───────
# Edit by changing the `{{`{{`}} if eq .profile "work" ... block in
# dot_config/zsh/dot_zshrc.tmpl, then `chezmoi apply -v`.

# Add work-only env vars, aliases, or hooks below as needed:
# export CORP_VPN_PROFILE="default"
# alias k="kubectl --context=work-prod"
{{ end -}}

{{ if eq .profile "personal" -}}
# ─── Personal-only shell config (rendered because profile = {{ .profile }}) ───
# Add personal-only env vars, aliases, or hooks below as needed:
# alias music='open -a "Spotify"'
{{ end -}}

# ─── Local overrides (not versioned) ──────────────────────────────────────────
[ -f "$ZDOTDIR/.zshrc.local" ] && source "$ZDOTDIR/.zshrc.local"

# ─── zsh-autosuggestions (brew) — fish-like type-ahead from history ───────────
# As you type, suggests the most recent matching command from history in dim
# text. Press → (or End, or Ctrl-E) to accept, Ctrl-→ to accept one word.
if [ -f /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]; then
    source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
{{ if has "theme" (dig "modules" (list) .) -}}
    # Catppuccin Frappé `overlay0` — readable but unmistakably suggestion-grey
    ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#737994'
{{ end -}}
fi

# ─── zsh-syntax-highlighting (brew) — MUST be sourced LAST ────────────────────
# Required to be the final addition per upstream docs.
if [ -f /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]; then
    source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi
