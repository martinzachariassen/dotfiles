# ~/.zshenv — read by every zsh invocation before any other rc file; must stay in
# $HOME. Universal env vars only — interactive config is in $ZDOTDIR/.zshrc.

# ─── Config location ──────────────────────────────────────────────────────────
export ZDOTDIR="$HOME/.config/zsh"

# ─── XDG Base Directory paths ─────────────────────────────────────────────────
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"

# ─── Redirect tool dirs out of $HOME into XDG paths ───────────────────────────
export GRADLE_USER_HOME="$XDG_CONFIG_HOME/gradle"
export NPM_CONFIG_CACHE="$XDG_CACHE_HOME/npm"
export HISTFILE="$XDG_STATE_HOME/zsh/history"

# Set in .zshenv (not .zshrc) so non-interactive and IDE subshells see it too.
export CLAUDE_CONFIG_DIR="$XDG_CONFIG_HOME/claude"

# ─── Editor ───────────────────────────────────────────────────────────────────
# Everything without its own editor setting falls back to $VISUAL/$EDITOR.
export EDITOR=nvim
export VISUAL=nvim

# Ghostty only; disables Apple Terminal's .zsh_sessions clutter.
export SHELL_SESSIONS_DISABLE=1

# Set explicitly so subshells advertise truecolor without detection heuristics.
export COLORTERM=truecolor

# ─── Pager behaviour ──────────────────────────────────────────────────────────
# -FRK: quit-if-one-screen, raw ANSI, Ctrl-C quits; no -X so it alt-screens and
# clears on exit. less doesn't strip quotes from $LESS, so -P is left unquoted.
export LESS='-FRK -PPress q or Ctrl-C to quit · / search · h for help'
export LESSHISTFILE="$XDG_STATE_HOME/less/history"

# ─── PATH ─────────────────────────────────────────────────────────────────────
# Dedup only; prepends live in .zprofile, which must run after path_helper (else it sinks them below /usr/bin).
typeset -U path fpath PATH
