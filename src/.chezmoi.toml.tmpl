{{/* chezmoi config + first-run wizard. prompt*Once reads saved answers back from
     [data] on re-runs, so init is idempotent. Force a re-ask: chezmoi init --prompt
     (CI: --promptDefaults). Identity defaults stay blank so forks don't inherit
     private values. Prompted answers use a namespace disjoint from .chezmoidata. */ -}}

{{- $name  := promptStringOnce . "name"  "Full name for git commits" -}}
{{- $email := promptStringOnce . "email" "Email for git commits" -}}

{{/* personal = my full stack · work = work extras · minimal = neutral base */ -}}
{{- $profile := promptChoiceOnce . "profile" "Profile" (list "personal" "work" "minimal") "personal" -}}

{{/* Git commit signing: 1Password SSH agent · a plain SSH key · or off.
     Only ask for the public key when signing is actually enabled. */ -}}
{{- $signingMode := promptChoiceOnce . "signingMode" "Git commit signing" (list "1password" "ssh-key" "off") "1password" -}}
{{- $signingKey  := dig "signingKey" "" . -}}
{{- if ne $signingMode "off" -}}
{{-   $signingKey = promptStringOnce . "signingKey" "Public signing key line (leave blank to configure later)" -}}
{{- end -}}

{{/* Rendered BEFORE .chezmoidata loads, so module names are listed literally here.
     Keep in sync with [moduleCatalog] in modules.toml — tests/data-model.bats
     enforces the match. */ -}}
{{- $allModules := list "claudePersona" "cloudAuth" "jvmStack" "locale" "macApps" "macosDefaults" "theme" -}}
{{- $defaults := list -}}
{{- if eq $profile "personal" -}}
{{-   $defaults = list "claudePersona" "jvmStack" "locale" "macApps" "macosDefaults" "theme" -}}
{{- else if eq $profile "work" -}}
{{-   $defaults = list "claudePersona" "cloudAuth" "jvmStack" "locale" "macApps" "macosDefaults" "theme" -}}
{{- end -}}
{{- $modules := promptMultichoiceOnce . "modules" "Optional modules" $allModules $defaults -}}
{{/* wizard.sh supplies the selection via --promptMultichoice; an empty one arrives
     as [""], so normalise it back to an empty list. */ -}}
{{- $modules = without $modules "" -}}

sourceDir = {{ printf "%s/Developer/personal/dotfiles" .chezmoi.homeDir | quote }}

[data]
    name        = {{ $name | quote }}
    email       = {{ $email | quote }}
    profile     = {{ $profile | quote }}
    signingMode = {{ $signingMode | quote }}
    signingKey  = {{ $signingKey | quote }}
    modules     = [{{ range $i, $m := $modules }}{{ if $i }}, {{ end }}{{ $m | quote }}{{ end }}]

# delta is always in the core Brewfile, so no lookPath gating needed.
[diff]
    pager = "delta"

# Force apply so drifted files are overwritten instead of a per-file prompt mid-run;
# the `chez` wrapper shows status with a y/N first as the safety net.
[apply]
    force = true
