{{/* chezmoi config + first-run wizard. prompt*Once reads saved answers back from
     [data] on re-runs, so init is idempotent. Force a re-ask: chezmoi init --prompt
     (CI: --promptDefaults). Identity defaults stay blank so forks don't inherit
     private values. Prompted answers use a namespace disjoint from .chezmoidata. */ -}}

{{- $name  := promptStringOnce . "name"  "Full name for git commits" -}}

{{/* Email gets asked twice on purpose. promptStringOnce treats a saved "" as a
     real answer, so a blank first run stuck permanently: `chez setup` skipped the
     key forever, git wrote every commit as "Name <>", and nothing said so. The
     re-ask makes an empty value mean "not answered yet" on this run *and* on
     machines that already saved one. Non-interactive runs (--promptDefaults, CI)
     get the empty default back and fall through to the useConfigOnly guard in
     dot_config/git/config.tmpl. */ -}}
{{- $email := promptStringOnce . "email" "Email for git commits" -}}
{{- if not $email -}}
{{/* Same message as above on purpose: wizard.sh answers this non-interactively
     with --promptString "Email for git commits=…", and chezmoi keys that flag by
     the prompt text. A different string here would make the wizard fall through
     to chezmoi's raw-mode TUI, which cannot run under `curl | bash`. */ -}}
{{-   $email = promptString "Email for git commits" -}}
{{- end -}}

{{/* personal = my full stack · work = work extras · minimal = neutral base */ -}}
{{- $profile := promptChoiceOnce . "profile" "Profile" (list "personal" "work" "minimal") "personal" -}}

{{/* Git commit signing: 1Password SSH agent · a plain SSH key · or off.
     Only ask for the public key when signing is actually enabled. */ -}}
{{- $signingMode := promptChoiceOnce . "signingMode" "Git commit signing" (list "1password" "ssh-key" "off") "1password" -}}
{{- $signingKey  := dig "signingKey" "" . -}}
{{- if ne $signingMode "off" -}}
{{-   $signingKey = promptStringOnce . "signingKey" "Public signing key line (leave blank to configure later)" -}}
{{- end -}}

{{/* Rendered BEFORE .chezmoidata loads, so module names are listed literally here.
     Keep in sync with [moduleCatalog] in modules.toml — tests/data-model.bats
     enforces the match. */ -}}
{{- $allModules := list "appleDev" "claudeDistiller" "claudePersona" "cloudAuth" "jvmStack" "locale" "macApps" "macosDefaults" "theme" -}}
{{- $defaults := list -}}
{{- if eq $profile "personal" -}}
{{-   $defaults = list "appleDev" "claudeDistiller" "claudePersona" "jvmStack" "locale" "macApps" "macosDefaults" "theme" -}}
{{- else if eq $profile "work" -}}
{{-   $defaults = list "claudeDistiller" "claudePersona" "cloudAuth" "jvmStack" "locale" "macApps" "macosDefaults" "theme" -}}
{{- end -}}
{{- $modules := promptMultichoiceOnce . "modules" "Optional modules" $allModules $defaults -}}
{{/* wizard.sh supplies the selection via --promptMultichoice; an empty one arrives
     as [""], so normalise it back to an empty list. */ -}}
{{- $modules = without $modules "" -}}

{{/* Where this Mac's distilled corpus backs up. Prompted, never a table in this
     public repo — see the header of .chezmoidata/distill.toml. Asked
     unconditionally so a machine that enables claudeDistiller later still has an
     answer saved; the wizard only shows the question when the module is on.

     Blank is a real answer meaning "local only", so it is written to [data]
     even when empty — signingKey's behaviour, not email's, which is deliberately
     omitted when blank so it re-asks forever. No comma in the message: chezmoi's
     non-interactive flags are parsed on commas (tests/wizard.bats). */ -}}
{{/* The trailing "" is the DEFAULT and is load-bearing. promptStringOnce with no
     default hands back the prompt MESSAGE when it cannot ask — which is every
     non-interactive path, including `--promptDefaults` and CI — so the message
     itself would be saved and then treated as a git URL. */ -}}
{{- $corpusRemote := promptStringOnce . "corpusRemote" "Corpus backup repo for the distiller (blank for local only)" "" -}}

{{/* Which corpus this Mac's memory belongs to. A free-text label and the leak
     boundary: two Macs that share a scope share a corpus, two that don't must
     never merge theirs, because `hits` counts sightings across the whole corpus.

     Defaults to the saved `profile` so a Mac set up before this key existed keeps
     the scope it already had — its corpus.json is stamped `personal`, and a Mac
     that suddenly claimed a different scope would refuse its own backup. Falls
     back to "default" on a fresh init. Same load-bearing default as corpusRemote
     above, and no comma in the message for the same reason. */ -}}
{{- $memoryScope := promptStringOnce . "memoryScope" "Memory scope for the distiller (Macs sharing a scope share one corpus)" (dig "profile" "default" .) -}}

{{/* Which modules this Mac has already been *offered* — not the same as which it
     has enabled. promptMultichoiceOnce reads the saved answer back and chez up
     only ever runs `apply`, so a module added to the catalog after a machine was
     set up would otherwise stay invisible on it forever. chez up diffs the
     catalog against this list and offers the difference exactly once, recording
     the answer either way. Round-tripped through dig so a plain `chezmoi init`
     preserves what chez up wrote.

     The default when the key is absent depends on WHY it is absent, and `profile`
     tells the two cases apart because it has been saved since v1 of this config:

       no saved profile  → a fresh init, where the wizard just showed every box.
                           Everything is seen; nothing is new.
       saved profile     → a machine set up before this key existed. Only what it
                           already has is seen, so whatever the catalog gained in
                           the meantime gets its one offer. This is the case that
                           makes claudeDistiller reachable on an existing Mac.

     Edge case, deliberately left: the wizard shows every box, but cannot record
     that (wizard.sh ends in `exec chezmoi init`, so nothing runs after it). A
     module already in the list is fine — dig round-trips it, so unticking it in
     `chez setup` sticks. Only one that was never seen *and* was left unticked
     there gets offered once more by chez up. One extra question, never a wrong
     answer. */ -}}
{{- $seenDefault := $modules -}}
{{- if not (hasKey . "profile") -}}
{{-   $seenDefault = $allModules -}}
{{- end -}}
{{- $modulesSeen := dig "modulesSeen" $seenDefault . -}}

{{/* Derive from the checkout chezmoi was actually initialised against, so a
     DOTFILES_DIR clone (honoured by install.sh, wizard.sh, chezup.sh and
     doctor.sh) doesn't end up writing a config that points somewhere else.
     workingTree is the git root; .chezmoiroot puts the source under src/. */ -}}
sourceDir = {{ .chezmoi.workingTree | quote }}

[data]
    name        = {{ $name | quote }}
{{- if $email }}
    email       = {{ $email | quote }}
{{- end }}
    profile     = {{ $profile | quote }}
    signingMode = {{ $signingMode | quote }}
    signingKey  = {{ $signingKey | quote }}
    corpusRemote = {{ $corpusRemote | quote }}
    memoryScope = {{ $memoryScope | quote }}
    modules     = [{{ range $i, $m := $modules }}{{ if $i }}, {{ end }}{{ $m | quote }}{{ end }}]
    modulesSeen = [{{ range $i, $m := $modulesSeen }}{{ if $i }}, {{ end }}{{ $m | quote }}{{ end }}]

# delta is always in the core Brewfile, so no lookPath gating needed.
[diff]
    pager = "delta"

# No `[apply] force` here: chezmoi has no such config key — `--force` is flag-only
# (verified against v2.72.0; `chezmoi dump-config` has no `apply` section, and the
# key was silently ignored). Every entry point passes `--force` explicitly instead:
# install.sh, wizard.sh, signing.sh, and the `chez apply`/`chez up` wrappers — each
# gates on its own y/N first.
