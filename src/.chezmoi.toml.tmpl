{{/* chezmoi V2 config + first-run wizard.

     This file IS the setup wizard. chezmoi's built-in prompt* functions ask each
     question during `chezmoi init`. The *Once variants read the saved answer back
     from the config [data] on re-runs, so re-initialising is idempotent and never
     re-asks. To change your setup later, force a re-ask with:
         chezmoi init --prompt
     Non-interactive (CI / containers): add --promptDefaults, or pass explicit
     --promptString / --promptChoice / --promptMultichoice pairs.

     Identity defaults are intentionally blank so forks don't inherit private
     values. The optional-module list + labels live in .chezmoidata/modules.toml
     and package selection in .chezmoidata/packages.toml (single sources of
     truth). Prompted answers (name, profile, modules, ...) stay in a key
     namespace disjoint from that static data so the two never collide. */ -}}

{{- $name  := promptStringOnce . "name"  "Full name for git commits" -}}
{{- $email := promptStringOnce . "email" "Email for git commits" -}}

{{/* personal = my full stack · work = work extras · minimal = neutral base */ -}}
{{- $profile := promptChoiceOnce . "profile" "Profile" (list "personal" "work" "minimal") "personal" -}}

{{/* Git commit signing: 1Password SSH agent · a plain SSH key · or off.
     Only ask for the public key when signing is actually enabled. */ -}}
{{- $signingMode := promptChoiceOnce . "signingMode" "Git commit signing" (list "1password" "ssh-key" "off") "1password" -}}
{{- $signingKey  := dig "signingKey" "" . -}}
{{- if ne $signingMode "off" -}}
{{-   $signingKey = promptStringOnce . "signingKey" "Public signing key line (leave blank to configure later)" -}}
{{- end -}}

{{/* Optional modules — one multi-select. Defaults depend on the chosen profile:
     personal pre-checks my full stack, work leans toward cloud, minimal starts
     empty.
     NOTE: the config template is rendered BEFORE .chezmoidata is loaded, so the
     module names must be listed here literally (they can't be read from
     .chezmoidata/modules.toml). Keep this list in sync with the [moduleCatalog]
     keys there — tests/data-model.bats enforces the match. Labels for the
     doctor report / summary come from that catalog. */ -}}
{{- $allModules := list "claudePersona" "cloudAuth" "jvmStack" "locale" "macApps" "macosDefaults" "obsidian" "theme" -}}
{{- $defaults := list -}}
{{- if eq $profile "personal" -}}
{{-   $defaults = list "claudePersona" "jvmStack" "locale" "macApps" "macosDefaults" "obsidian" "theme" -}}
{{- else if eq $profile "work" -}}
{{-   $defaults = list "claudePersona" "cloudAuth" "jvmStack" "macApps" "macosDefaults" "theme" -}}
{{- end -}}
{{- $modules := promptMultichoiceOnce . "modules" "Optional modules (space toggles, Enter confirms)" $allModules $defaults -}}

sourceDir = {{ printf "%s/Developer/personal/dotfiles" .chezmoi.homeDir | quote }}

[data]
    name        = {{ $name | quote }}
    email       = {{ $email | quote }}
    profile     = {{ $profile | quote }}
    signingMode = {{ $signingMode | quote }}
    signingKey  = {{ $signingKey | quote }}
    modules     = [{{ range $i, $m := $modules }}{{ if $i }}, {{ end }}{{ $m | quote }}{{ end }}]

# delta is unconditionally in the core Brewfile, so wiring chezmoi's diff pager to
# it needs no lookPath gating (it resolves after the first brew bundle).
[diff]
    pager = "delta"

# Force apply so a locally-drifted managed file is overwritten instead of dropping
# into a per-file diff/overwrite/skip prompt mid-run. The `chez` wrapper shows
# `chezmoi status` with a y/N first as the safety net.
[apply]
    force = true
