{
    // ── Appearance ──

{{ if has "theme" (dig "modules" (list) .) -}}
    "workbench.colorTheme": "Catppuccin Frappé",
{{ end -}}
    "workbench.iconTheme": "material-icon-theme",

    "window.commandCenter": true,
    "workbench.startupEditor": "none",
    "workbench.editor.enablePreview": false,
    "workbench.editor.labelFormat": "short",
    "workbench.tree.indent": 16,
    "breadcrumbs.enabled": true,
    "workbench.settings.enableNaturalLanguageSearch": false,
    "workbench.enableExperiments": false,
    "workbench.list.smoothScrolling": true,

    // Cap open tabs per group; LRU non-dirty tabs auto-close past the limit.
    "workbench.editor.limit.enabled": true,
    "workbench.editor.limit.value": 10,
    "workbench.editor.limit.perEditorGroup": true,

    // ── Font & editor ──

    "editor.fontFamily": "'JetBrainsMono Nerd Font', Menlo, Monaco, 'Courier New', monospace",
    "editor.fontSize": 14,
    "editor.fontLigatures": true,
    "editor.lineHeight": 1.7,
    "editor.letterSpacing": 0.3,

    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.smoothScrolling": true,

    "editor.minimap.enabled": false,
    "editor.renderWhitespace": "selection",
    "editor.guides.indentation": true,
    "editor.guides.bracketPairs": "active",

    "editor.bracketPairColorization.enabled": true,
    "editor.stickyScroll.enabled": true,
    "editor.stickyScroll.maxLineCount": 5,

    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.formatOnSaveMode": "file",
    "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
    },

    // Default formatter so save never prompts; LSP languages override below.
    "editor.defaultFormatter": "esbenp.prettier-vscode",

    // Fallbacks only when a repo has no .prettierrc.
    "prettier.printWidth": 100,
    "prettier.proseWrap": "preserve",

    "editor.inlineSuggest.enabled": true,
    "editor.acceptSuggestionOnEnter": "smart",
    "editor.rulers": [100, 120],
    "editor.cursorSurroundingLines": 4,
    "editor.linkedEditing": true,
    "editor.accessibilitySupport": "off",

    // ── Files ──

    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,

    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.hotExit": "onExitAndWindowClose",
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/.gradle/**": true,
        "**/build/**": true,
        "**/dist/**": true,
        "**/node_modules/**": true,
        "**/target/**": true
    },

    "files.exclude": {
        "**/.DS_Store": true,
        "**/.git": false,
        "**/node_modules": true,
        "**/.gradle": true,
        "**/dist": true,
        "**/build": true
    },

    // Highlight chezmoi .tmpl files by base language; a whole-file "go"
    // association would wrongly parse the shell/json bodies.
    "files.associations": {
        "*.sh.tmpl": "shellscript",
        "*.json.tmpl": "jsonc",
        "*.toml.tmpl": "toml",
        "**/dot_zshrc.tmpl": "shellscript",
        "**/ghostty/config.tmpl": "ini",
        "**/git/config.tmpl": "ini"
    },

    // Nest derived/companion files under their parent to cut Explorer noise.
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js, ${capture}.d.ts, ${capture}.js.map",
        "*.tsx": "${capture}.js, ${capture}.css",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.java": "${capture}.class",
        "package.json": "package-lock.json, .npmrc, .nvmrc, .node-version, tsconfig*.json, .eslint*, .prettier*, eslint.config.*, prettier.config.*",
        "tsconfig.json": "tsconfig.*.json",
        "build.gradle": "gradle.properties, gradle-wrapper.properties, settings.gradle, gradlew, gradlew.bat",
        "build.gradle.kts": "gradle.properties, gradle-wrapper.properties, settings.gradle.kts, gradlew, gradlew.bat",
        "pom.xml": "mvnw, mvnw.cmd, .mvn",
        "*.tf": "${capture}.tfvars, ${capture}.tfvars.json, .terraform.lock.hcl",
        "Dockerfile": "Dockerfile.*, .dockerignore, docker-compose.*, compose.*",
        "pyproject.toml": "poetry.lock, uv.lock, setup.py, setup.cfg, requirements*.txt, .python-version, ruff.toml, .ruff.toml",
        ".gitignore": ".gitattributes, .gitmodules, .mailmap, .editorconfig",
        "mise.toml": ".mise.toml, mise.*.toml, .tool-versions",
        "readme.md": "license, license.*, contributing.*, changelog.*, code_of_conduct.*, security.*"
    },

    // ── Search ──

    "search.exclude": {
        "**/node_modules": true,
        "**/build": true,
        "**/dist": true,
        "**/.gradle": true
    },

    "search.followSymlinks": false,

    // todo-tree's VSIX ships without its bundled rg and fails on activation.
    "todo-tree.ripgrep.ripgrep": "/opt/homebrew/bin/rg",

    // ── Explorer & git ──

    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,

    "git.enableSmartCommit": true,
    "git.confirmSync": false,
    "git.autofetch": true,
    "git.openRepositoryInParentFolders": "never",
    "git.pruneOnFetch": true,
    "git.rebaseWhenSync": true,
    "git.mergeEditor": true,
    "gitlens.currentLine.enabled": false,
    // Turn off VS Code's built-in inline blame (default-on, looks like GitLens).
    "git.blame.editorDecoration.enabled": false,
    "git.blame.statusBarItem.enabled": false,
    "gitlens.codeLens.enabled": false,

    "scm.defaultViewMode": "tree",
    "diffEditor.ignoreTrimWhitespace": false,
    "diffEditor.experimental.showMoves": true,

    "github.gitAuthentication": true,
    "githubPullRequests.pullBranch": "never",

    // ── Terminal ──

    "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font'",
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.scrollback": 100000,
    "terminal.integrated.smoothScrolling": true,
    "terminal.integrated.enablePersistentSessions": false,

    // ── Project environment ──

    // Off so the extension doesn't write JDK paths into this chezmoi-managed file.
    "mise.configureExtensionsAutomatically": false,

    // ── Vim ──

    "vim.leader": "<space>",
    "vim.useSystemClipboard": true,
    "vim.hlsearch": true,
    "vim.incsearch": true,
    "vim.smartcase": true,
    "vim.ignorecase": true,
    "vim.easymotion": true,
    "vim.surround": true,
    "vim.insertModeKeyBindings": [
        {
            "before": ["j", "k"],
            "after": ["<Esc>"]
        }
    ],
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": ["<leader>", "w"],
            "commands": ["workbench.action.files.save"]
        },
        {
            "before": ["<leader>", "p"],
            "commands": ["workbench.action.quickOpen"]
        },
        {
            "before": ["<leader>", "f"],
            "commands": ["workbench.action.findInFiles"]
        },
        {
            "before": ["<leader>", "e"],
            "commands": ["workbench.view.explorer"]
        },
        {
            "before": ["<leader>", "g"],
            "commands": ["workbench.view.scm"]
        },
        {
            "before": ["<leader>", "d"],
            "commands": ["editor.action.revealDefinition"]
        },
        {
            "before": ["<leader>", "r", "n"],
            "commands": ["editor.action.rename"]
        },
        {
            "before": ["<leader>", "a"],
            "commands": ["editor.action.quickFix"]
        },
        {
            "before": ["<leader>", "/"],
            "commands": ["editor.action.commentLine"]
        },
        {
            "before": ["<leader>", "q"],
            "commands": ["workbench.action.closeActiveEditor"]
        }
    ],
    "vim.visualModeKeyBindingsNonRecursive": [
        {
            "before": ["<leader>", "/"],
            "commands": ["editor.action.commentLine"]
        }
    ],

    // ── AI / Copilot ──

    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": true,
        "scminput": false
    },

    // `commitMessageGeneration.instructions` intentionally omitted: any value here
    // trips Copilot's filter and breaks "Generate Commit Message" with a 422
    // (microsoft/vscode#316549). commit-msg hooks + CI enforce Conventional Commits anyway.

    // Conventional Commits for the GitHub PR "Generate Title/Description" action.
    "github.copilot.chat.pullRequestDescriptionGeneration.instructions": [
        {
            "text": "The PR title must follow Conventional Commits: `<type>(<scope>): <subject>`. Types: feat, fix, docs, refactor, test, chore, perf, build, ci, style. Subject in imperative mood, lowercase, no trailing period, ≤72 chars. Breaking changes append `!` to the type. The description body should explain the *why*, list any rollout or follow-up notes, and be scannable."
        }
    ],

    // Global house style; a repo's .github/copilot-instructions.md stacks on top.
    "github.copilot.chat.codeGeneration.instructions": [
        {
            "text": "Readability over cleverness; modern syntax that clarifies rather than shows off. Follow existing project patterns over these defaults."
        },
        {
            "text": "Comments: keep them minimal and explain *why*, not *what*. Don't leave commented-out code behind. Prefer a clear name or a small refactor over a comment."
        },
        {
            "text": "Never hard-code secrets, tokens, or keys — use placeholders or a secret-manager reference."
        }
    ],

    "chat.editor.fontSize": 14,

    // ── Backend / infra ──

    "java.configuration.updateBuildConfiguration": "automatic",
    "java.compile.nullAnalysis.mode": "automatic",
    "java.inlayHints.parameterNames.enabled": "literals",
    "java.saveActions.organizeImports": true,

    // Pin the editor JDK to mise's version-named install path, a durable anchor
    // across runtime updates.
{{ if has "jvmStack" (dig "modules" (list) .) -}}
    "java.jdt.ls.java.home": "{{ .chezmoi.homeDir }}/.local/share/mise/installs/java/temurin-25/Contents/Home",
    "java.import.gradle.java.home": "{{ .chezmoi.homeDir }}/.local/share/mise/installs/java/temurin-25/Contents/Home",
    "java.configuration.runtimes": [
        {
            "name": "JavaSE-25",
            "path": "{{ .chezmoi.homeDir }}/.local/share/mise/installs/java/temurin-25/Contents/Home",
            "default": true
        }
    ],
{{ end -}}

    "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx2G -Xms100m",
    "java.import.gradle.wrapper.enabled": true,

    // Fetch sources so go-to-definition lands on real code, not stubs.
    "java.maven.downloadSources": true,
    "java.eclipse.downloadSources": true,
    "java.references.includeDecompiledSources": true,

    "java.completion.guessMethodArguments": "auto",
    "java.signatureHelp.description.enabled": true,
    "java.completion.favoriteStaticMembers": [
        "org.junit.jupiter.api.Assertions.*",
        "org.junit.jupiter.api.Assumptions.*",
        "org.assertj.core.api.Assertions.*",
        "org.mockito.Mockito.*",
        "org.mockito.ArgumentMatchers.*",
        "org.hamcrest.MatcherAssert.assertThat",
        "org.hamcrest.Matchers.*"
    ],

    "java.codeGeneration.hashCodeEquals.useJava7Objects": true,
    "java.codeGeneration.useBlocks": true,
    "java.codeGeneration.generateComments": false,

    "java.cleanup.actionsOnSave": [
        "addOverride",
        "instanceofPatternMatch",
        "switchExpression"
    ],

    // Lombok via redhat.java's built-in support, not the deprecated extension.
    "java.jdt.ls.lombokSupport.enabled": true,

    "sonarlint.disableTelemetry": true,

    "spring-boot.ls.problem.application-properties.enabled": true,
    "spring-boot.ls.problem.application-yaml.enabled": true,

    // JetBrains Kotlin LSP (Alpha, JVM-only); `intellij.*` because the server is
    // IntelliJ's engine repackaged. serverPort -1 uses the VSIX-bundled server.
    "intellij.dev.serverPort": -1,
{{ if has "jvmStack" (dig "modules" (list) .) -}}
    "intellij.jdkForSymbolResolution": "{{ .chezmoi.homeDir }}/.local/share/mise/installs/java/temurin-25/Contents/Home",
{{ end -}}
    "intellij.trace.server": "off",

    "terraform.languageServer.enable": true,

    "yaml.validate": true,
    "yaml.format.enable": true,
    "yaml.completion": true,
    "yaml.hover": true,
    "yaml.schemaStore.enable": true,
    "yaml.format.printWidth": 120,
    "yaml.format.singleQuote": false,
    "yaml.format.bracketSpacing": true,
    "yaml.format.proseWrap": "preserve",
    "yaml.disableSchemaDetection": [
        "**/.github/workflows/*.yml",
        "**/.github/workflows/*.yaml",
        "**/.gitea/workflows/*.yml",
        "**/.gitea/workflows/*.yaml",
        "**/.forgejo/workflows/*.yml",
        "**/.forgejo/workflows/*.yaml"
    ],

    // Format/validate XML without reflowing hand-laid-out attributes.
    "xml.format.enabled": true,
    "xml.format.maxLineWidth": 120,
    "xml.format.splitAttributes": "preserve",
    "xml.format.preserveAttributeLineBreaks": true,
    "xml.format.joinContentLines": false,
    "xml.validation.enabled": true,

    // Mirrors the repo .editorconfig (4-space indent, indent switch cases).
    "shellformat.flag": "-i 4 -ci",

    "cSpell.language": "{{ if has "locale" (dig "modules" (list) .) }}en-US,nb{{ else }}en-US{{ end }}",

    // ~/.config/cspell/personal.txt symlinks into packages/cspell-words.txt, so
    // words added via quick-fix land in `git status` — no settings edit needed.
    "cSpell.customDictionaries": {
        "personal": {
            "name": "personal",
            "description": "Personal dictionary tracked in dotfiles",
            "path": "{{ .chezmoi.homeDir }}/.config/cspell/personal.txt",
            "addWords": true,
            "scope": "user"
        }
    },

    // ── Language-specific ──

    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },

    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },

    "[yaml]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },

    "[xml]": {
        "editor.defaultFormatter": "redhat.vscode-xml"
    },

    "[markdown]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },

    // Commit messages: subject ≤50, body wrap at 72 — the conventional guides.
    "[git-commit]": {
        "editor.rulers": [50, 72]
    },
    "[scminput]": {
        "editor.rulers": [50, 72]
    },

    "[toml]": {
        "editor.defaultFormatter": "tamasfe.even-better-toml"
    },

    "[dockerfile]": {
        "editor.defaultFormatter": "ms-azuretools.vscode-containers"
    },

    "[shellscript]": {
        "editor.defaultFormatter": "foxundermoon.shell-format"
    },

    "[terraform]": {
        "editor.defaultFormatter": "hashicorp.terraform"
    },

    "[terraform-vars]": {
        "editor.defaultFormatter": "hashicorp.terraform"
    },

    "[spring-boot-properties-yaml]": {
        "yaml.validate": false,
        "editor.quickSuggestions": {
            "strings": true
        }
    },

    "[java]": {
        "editor.defaultFormatter": "redhat.java",
        "editor.tabSize": 4,
        "editor.detectIndentation": false
    },

    // jetbrains.kotlin-server is the current extension; jetbrains.kotlin is deprecated.
    "[kotlin]": {
        "editor.defaultFormatter": "jetbrains.kotlin-server",
        "editor.tabSize": 4,
        "editor.detectIndentation": false
    },

    // Prettier formats; ESLint applies its non-format autofixes on save.
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit"
        }
    },

    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit"
        }
    },

    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit"
        }
    },

    "[javascriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit"
        }
    },

    // Ruff handles both lint-fix and formatting + import sorting on save.
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnType": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports.ruff": "explicit",
            "source.fixAll.ruff": "explicit"
        }
    },

    // Swift/iOS (appleDev): Swift extension drives SourceKit-LSP, Sweetpad wraps
    // xcodebuild. SwiftFormat (vknabel) pipes edits via stdin so it never races
    // VS Code's save; SwiftLint's --fix rewrites on disk so it stays off the save
    // cycle (run via keybinding or pre-commit). See docs/editors.md.
{{ if has "appleDev" (dig "modules" (list) .) -}}
    "[swift]": {
        "editor.defaultFormatter": "vknabel.vscode-swiftformat",
        "editor.tabSize": 4,
        "editor.detectIndentation": false,
        // Empty object overrides the global source.organizeImports.
        "editor.codeActionsOnSave": {}
    },
    "swift.backgroundIndexing": true,
    "swiftformat.path": "/opt/homebrew/bin/swiftformat",
    "sweetpad.build.xcbeautifyEnabled": true,
    "swiftlint.path": "/opt/homebrew/bin/swiftlint",
    // SwiftLint doesn't ascend to $HOME; a project's .swiftlint.yml wins if present,
    // else this chezmoi-deployed config applies.
    "swiftlint.configSearchPaths": [".swiftlint.yml", "{{ .chezmoi.homeDir }}/.config/swiftlint/config.yml"],
{{ end -}}

    // ── Performance ──

    "extensions.ignoreRecommendations": true,
    "telemetry.telemetryLevel": "off",
    "redhat.telemetry.enabled": false,
    "gitlens.telemetry.enabled": false,

    "update.mode": "manual",

    // ── Security ──

    "security.workspace.trust.enabled": true
}
