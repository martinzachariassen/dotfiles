{
    // ── Appearance ──

{{ if has "theme" (dig "modules" (list) .) -}}
    "workbench.colorTheme": "Catppuccin Mocha",

    // Catppuccin's default comment colour (overlay0) sits too low in contrast to
    // skim in KDoc/Javadoc-heavy files; subtext0 lifts it without turning comments
    // into foreground noise.
    "editor.tokenColorCustomizations": {
        "[Catppuccin Mocha]": {
            "comments": "#a6adc8"
        }
    },
{{ end -}}
    "workbench.iconTheme": "material-icon-theme",

    "window.commandCenter": true,
    "workbench.startupEditor": "none",
    "workbench.editor.enablePreview": false,
    "workbench.editor.labelFormat": "short",
    "workbench.tree.indent": 16,
    "breadcrumbs.enabled": true,
    "workbench.settings.enableNaturalLanguageSearch": false,
    "workbench.enableExperiments": false,
    "workbench.list.smoothScrolling": true,

    // Cap open tabs per group; LRU non-dirty tabs auto-close past the limit.
    "workbench.editor.limit.enabled": true,
    "workbench.editor.limit.value": 10,
    "workbench.editor.limit.perEditorGroup": true,

    // ── Font & editor ──

    // Unpatched JetBrains Mono in the editor — the Nerd Font patch ships wider
    // metrics that throw off column alignment, and nothing in the editor renders
    // the extra glyphs. The terminal, which does need them, keeps the patched
    // build (see below). Same family as IntelliJ, so both IDEs render alike.
    "editor.fontFamily": "'JetBrains Mono', Menlo, Monaco, 'Courier New', monospace",
    "editor.fontSize": 14,
    // macOS grayscale-antialiases text; Regular goes thin on a dark background.
    "editor.fontWeight": "500",
    // Off: `!=` vs `->` should stay distinguishable at review speed.
    "editor.fontLigatures": false,
    "editor.lineHeight": 1.6,

    // TextMate regex can't tell a field from a parameter from a local; the
    // language server can. Real signal in Java/Kotlin.
    "editor.semanticHighlighting.enabled": true,

    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.smoothScrolling": true,

    "editor.minimap.enabled": false,
    "editor.renderWhitespace": "selection",
    "editor.guides.indentation": true,
    "editor.guides.bracketPairs": "active",

    "editor.bracketPairColorization.enabled": true,
    "editor.stickyScroll.enabled": true,
    "editor.stickyScroll.maxLineCount": 5,

    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.formatOnSaveMode": "file",
    "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
    },

    // Default formatter so save never prompts; LSP languages override below.
    "editor.defaultFormatter": "esbenp.prettier-vscode",

    // Fallbacks only when a repo has no .prettierrc.
    "prettier.printWidth": 100,
    "prettier.proseWrap": "preserve",

    "editor.inlineSuggest.enabled": true,
    "editor.acceptSuggestionOnEnter": "smart",
    "editor.rulers": [100, 120],
    "editor.cursorSurroundingLines": 4,
    // Relative numbers make vim's count motions (5j, 3dd, d7k) readable instead
    // of guesswork; `vim.smartRelativeLine` below flips back to absolute in
    // insert mode, where the count is irrelevant and the real line number isn't.
    "editor.lineNumbers": "relative",
    "editor.linkedEditing": true,
    "editor.accessibilitySupport": "off",

    // ── Files ──

    // NOT "afterDelay": VS Code skips save participants on the delayed-autosave
    // path, which silently disables editor.formatOnSave and every
    // codeActionsOnSave below (organizeImports, fixAll.eslint, fixAll.ruff,
    // java.cleanup.actionsOnSave). "onFocusChange" still autosaves but runs them.
    "files.autoSave": "onFocusChange",

    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.hotExit": "onExitAndWindowClose",
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/.gradle/**": true,
        "**/build/**": true,
        "**/dist/**": true,
        "**/node_modules/**": true,
        "**/target/**": true
    },

    "files.exclude": {
        "**/.DS_Store": true,
        "**/.git": false,
        "**/node_modules": true,
        "**/.gradle": true,
        "**/dist": true,
        "**/build": true
    },

    // Highlight chezmoi .tmpl files by base language; a whole-file "go"
    // association would wrongly parse the shell/json bodies.
    "files.associations": {
        "*.sh.tmpl": "shellscript",
        "*.json.tmpl": "jsonc",
        "*.toml.tmpl": "toml",
        "**/dot_zshrc.tmpl": "shellscript",
        "**/ghostty/config.tmpl": "ini",
        "**/git/config.tmpl": "ini"
    },

    // Nest derived/companion files under their parent to cut Explorer noise.
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js, ${capture}.d.ts, ${capture}.js.map",
        "*.tsx": "${capture}.js, ${capture}.css",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.java": "${capture}.class",
        "package.json": "package-lock.json, .npmrc, .nvmrc, .node-version, tsconfig*.json, .eslint*, .prettier*, eslint.config.*, prettier.config.*",
        "tsconfig.json": "tsconfig.*.json",
        "build.gradle": "gradle.properties, gradle-wrapper.properties, settings.gradle, gradlew, gradlew.bat",
        "build.gradle.kts": "gradle.properties, gradle-wrapper.properties, settings.gradle.kts, gradlew, gradlew.bat",
        "pom.xml": "mvnw, mvnw.cmd, .mvn",
        "*.tf": "${capture}.tfvars, ${capture}.tfvars.json, .terraform.lock.hcl",
        "Dockerfile": "Dockerfile.*, .dockerignore, docker-compose.*, compose.*",
        "pyproject.toml": "poetry.lock, uv.lock, setup.py, setup.cfg, requirements*.txt, .python-version, ruff.toml, .ruff.toml",
        ".gitignore": ".gitattributes, .gitmodules, .mailmap, .editorconfig",
        "mise.toml": ".mise.toml, mise.*.toml, .tool-versions",
        "readme.md": "license, license.*, contributing.*, changelog.*, code_of_conduct.*, security.*"
    },

    // ── Search ──

    "search.exclude": {
        "**/node_modules": true,
        "**/build": true,
        "**/dist": true,
        "**/.gradle": true
    },

    "search.followSymlinks": false,

    // todo-tree's VSIX ships without its bundled rg and fails on activation.
    "todo-tree.ripgrep.ripgrep": "/opt/homebrew/bin/rg",

    // ── Explorer & git ──

    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,

    "git.enableSmartCommit": true,
    "git.confirmSync": false,
    "git.autofetch": true,
    "git.openRepositoryInParentFolders": "never",
    "git.pruneOnFetch": true,
    "git.rebaseWhenSync": true,
    "git.mergeEditor": true,
    // Turn off VS Code's built-in inline blame (default-on, noisy).
    "git.blame.editorDecoration.enabled": false,
    "git.blame.statusBarItem.enabled": false,

    "scm.defaultViewMode": "tree",
    "diffEditor.ignoreTrimWhitespace": false,
    "diffEditor.experimental.showMoves": true,

    "github.gitAuthentication": true,
    "githubPullRequests.pullBranch": "never",

    // ── Terminal ──

    "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font'",
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.scrollback": 100000,
    "terminal.integrated.smoothScrolling": true,
    "terminal.integrated.enablePersistentSessions": false,

    // ── Project environment ──

    // Off so the extension doesn't write JDK paths into this chezmoi-managed file.
    "mise.configureExtensionsAutomatically": false,

    // ── Vim ──

    // Leader maps below mirror LazyVim's defaults key-for-key, because this repo
    // manages both editors and both use <space> as leader — see docs/editors.md.
    // Anything VSCodeVim already emulates natively is deliberately NOT remapped:
    // gd/gc/gC/ys/cs/ds all work out of the box, and a leader alias for them
    // would only be a second way to do the same thing.
    "vim.leader": "<space>",
    "vim.hlsearch": true,
    "vim.incsearch": true,
    "vim.smartcase": true,
    "vim.ignorecase": true,
    "vim.surround": true,
    "vim.easymotion": true,

    // Every delete/change also clobbers the macOS clipboard — the cost of not
    // having to type "+y for the common case. Named registers ("ayiw) still
    // bypass it when something needs to survive a d/c.
    "vim.useSystemClipboard": true,

    // The only feedback that a yank in normal mode did anything at all.
    "vim.highlightedyank.enable": true,
    "vim.highlightedyank.color": "rgba(249, 226, 175, 0.25)",
    "vim.highlightedyank.duration": 250,

    // Relative numbers in normal/visual, absolute in insert — see
    // editor.lineNumbers above.
    "vim.smartRelativeLine": true,

    // targets.vim: ci( / da, from anywhere on the line rather than only from
    // inside the pair. Pays for itself in nested Java/Kotlin generics and calls.
    "vim.targets.enable": true,

    // `vim.replaceWithRegister` is deliberately OFF: it claims `gr` as the
    // replace operator, and `gr` is Goto References in LazyVim (mapped below).
    // The prefix isn't configurable, so the two can't coexist — and jumping to
    // references is the far more common operation.
{{ if has "theme" (dig "modules" (list) .) -}}

    // EasyMotion ships hard-coded red/orange markers that fight Catppuccin.
    // Mocha equivalents: red / peach / yellow markers on base, dimmed to
    // overlay0 so the jump targets are the only thing with saturation left.
    "vim.easymotionMarkerBackgroundColor": "#1e1e2e",
    "vim.easymotionMarkerForegroundColorOneChar": "#f38ba8",
    "vim.easymotionMarkerForegroundColorTwoCharFirst": "#fab387",
    "vim.easymotionMarkerForegroundColorTwoCharSecond": "#f9e2af",
    "vim.easymotionIncSearchForegroundColor": "#a6e3a1",
    "vim.easymotionDimColor": "#6c7086",
{{ end }}
    "vim.insertModeKeyBindings": [
        {
            "before": ["j", "k"],
            "after": ["<Esc>"]
        }
    ],
    "vim.normalModeKeyBindingsNonRecursive": [
        // ── Find (LazyVim <leader>f) ──
        // LazyVim's <leader><space> (Find Files) is deliberately NOT mapped:
        // with leader=<space> that sequence is <space><space>, which is
        // EasyMotion's entire prefix. <leader>ff covers it.
        {
            "before": ["<leader>", "f", "f"],
            "commands": ["workbench.action.quickOpen"]
        },
        {
            "before": ["<leader>", "f", "r"],
            "commands": ["workbench.action.openRecent"]
        },
        {
            "before": ["<leader>", "f", "t"],
            "commands": ["workbench.action.terminal.toggleTerminal"]
        },

        // ── Search (LazyVim <leader>s, plus <leader>/ for grep) ──
        {
            "before": ["<leader>", "/"],
            "commands": ["workbench.action.findInFiles"]
        },
        {
            "before": ["<leader>", "s", "g"],
            "commands": ["workbench.action.findInFiles"]
        },
        {
            "before": ["<leader>", "s", "s"],
            "commands": ["workbench.action.gotoSymbol"]
        },
        {
            "before": ["<leader>", "s", "S"],
            "commands": ["workbench.action.showAllSymbols"]
        },
        {
            "before": ["<leader>", "s", "d"],
            "commands": ["workbench.actions.view.problems"]
        },

        // ── Code / LSP (LazyVim <leader>c) ──
        {
            "before": ["<leader>", "c", "a"],
            "commands": ["editor.action.quickFix"]
        },
        {
            "before": ["<leader>", "c", "r"],
            "commands": ["editor.action.rename"]
        },
        {
            "before": ["<leader>", "c", "f"],
            "commands": ["editor.action.formatDocument"]
        },

        // ── Buffers & windows (LazyVim <leader>b / <leader>- / <leader>|) ──
        {
            "before": ["<leader>", "b", "d"],
            "commands": ["workbench.action.closeActiveEditor"]
        },
        {
            "before": ["<leader>", "b", "b"],
            "commands": ["workbench.action.openPreviousRecentlyUsedEditorInGroup"]
        },
        {
            "before": ["<leader>", "-"],
            "commands": ["workbench.action.splitEditorDown"]
        },
        {
            "before": ["<leader>", "|"],
            "commands": ["workbench.action.splitEditor"]
        },
        {
            "before": ["<leader>", "w", "d"],
            "commands": ["workbench.action.closeGroup"]
        },

        // ── Git (LazyVim <leader>g; <leader>gg is lazygit there, SCM view here) ──
        {
            "before": ["<leader>", "g", "g"],
            "commands": ["workbench.view.scm"]
        },
        {
            "before": ["<leader>", "g", "d"],
            "commands": ["git.openChange"]
        },

        // ── Explorer & UI toggles (LazyVim <leader>e / <leader>u) ──
        {
            "before": ["<leader>", "e"],
            "commands": ["workbench.view.explorer"]
        },
        {
            "before": ["<leader>", "u", "r"],
            "commands": [":nohl"]
        },
        {
            "before": ["<leader>", "u", "w"],
            "commands": ["editor.action.toggleWordWrap"]
        },

        // ── Goto (LazyVim gr/gI/gy; gd is native to VSCodeVim) ──
        {
            "before": ["g", "r"],
            "commands": ["editor.action.goToReferences"]
        },
        {
            "before": ["g", "I"],
            "commands": ["editor.action.goToImplementation"]
        },
        {
            "before": ["g", "y"],
            "commands": ["editor.action.goToTypeDefinition"]
        },

        // ── Diagnostics (LazyVim ]d / [d) — the payoff for ErrorLens+SonarLint ──
        {
            "before": ["]", "d"],
            "commands": ["editor.action.marker.next"]
        },
        {
            "before": ["[", "d"],
            "commands": ["editor.action.marker.prev"]
        }
    ],
    "vim.visualModeKeyBindingsNonRecursive": [
        {
            "before": ["<leader>", "c", "f"],
            "commands": ["editor.action.formatSelection"]
        },
        // Keep the selection after reindenting so >>> is one keypress each,
        // matching LazyVim. Stock vim drops back to normal mode after one shift.
        {
            "before": [">"],
            "after": [">", "g", "v"]
        },
        {
            "before": ["<"],
            "after": ["<", "g", "v"]
        }
    ],

    // Run VSCodeVim in its own extension host process: keystroke handling stops
    // queueing behind the Java/Sonar/ErrorLens extensions in the shared host.
    // Upstream's one documented perf lever. Cost: the extension reloads on every
    // settings.json write, which `chezmoi apply` does often.
    "extensions.experimental.affinity": {
        "vscodevim.vim": 1
    },

    // ── AI / Copilot ──

    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": true,
        "scminput": false
    },

    // `commitMessageGeneration.instructions` intentionally omitted: any value here
    // trips Copilot's filter and breaks "Generate Commit Message" with a 422
    // (microsoft/vscode#316549). commit-msg hooks + CI enforce Conventional Commits anyway.

    // Conventional Commits for the GitHub PR "Generate Title/Description" action.
    "github.copilot.chat.pullRequestDescriptionGeneration.instructions": [
        {
            "text": "The PR title must follow Conventional Commits: `<type>(<scope>): <subject>`. Types: feat, fix, docs, refactor, test, chore, perf, build, ci, style. Subject in imperative mood, lowercase, no trailing period, ≤72 chars. Breaking changes append `!` to the type. The description body should explain the *why*, list any rollout or follow-up notes, and be scannable."
        }
    ],

    // Global house style; a repo's .github/copilot-instructions.md stacks on top.
    "github.copilot.chat.codeGeneration.instructions": [
        {
            "text": "Readability over cleverness; modern syntax that clarifies rather than shows off. Follow existing project patterns over these defaults."
        },
        {
            "text": "Comments: keep them minimal and explain *why*, not *what*. Don't leave commented-out code behind. Prefer a clear name or a small refactor over a comment."
        },
        {
            "text": "Never hard-code secrets, tokens, or keys — use placeholders or a secret-manager reference."
        }
    ],

    "chat.editor.fontSize": 14,

    // ── Backend / infra ──

    "java.configuration.updateBuildConfiguration": "automatic",
    "java.compile.nullAnalysis.mode": "automatic",
    "java.inlayHints.parameterNames.enabled": "literals",
    "java.saveActions.organizeImports": true,

    // Pin the editor JDK to mise's version-named install path, a durable anchor
    // across runtime updates.
{{ if has "jvmStack" (dig "modules" (list) .) -}}
    "java.jdt.ls.java.home": "{{ .chezmoi.homeDir }}/.local/share/mise/installs/java/temurin-25/Contents/Home",
    "java.import.gradle.java.home": "{{ .chezmoi.homeDir }}/.local/share/mise/installs/java/temurin-25/Contents/Home",
    "java.configuration.runtimes": [
        {
            "name": "JavaSE-25",
            "path": "{{ .chezmoi.homeDir }}/.local/share/mise/installs/java/temurin-25/Contents/Home",
            "default": true
        }
    ],
{{ end -}}

    "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx2G -Xms100m",
    "java.import.gradle.wrapper.enabled": true,

    // Fetch sources so go-to-definition lands on real code, not stubs.
    "java.maven.downloadSources": true,
    "java.eclipse.downloadSources": true,
    "java.references.includeDecompiledSources": true,

    "java.completion.guessMethodArguments": "auto",
    "java.signatureHelp.description.enabled": true,
    "java.completion.favoriteStaticMembers": [
        "org.junit.jupiter.api.Assertions.*",
        "org.junit.jupiter.api.Assumptions.*",
        "org.assertj.core.api.Assertions.*",
        "org.mockito.Mockito.*",
        "org.mockito.ArgumentMatchers.*",
        "org.hamcrest.MatcherAssert.assertThat",
        "org.hamcrest.Matchers.*"
    ],

    "java.codeGeneration.hashCodeEquals.useJava7Objects": true,
    "java.codeGeneration.useBlocks": true,
    "java.codeGeneration.generateComments": false,

    "java.cleanup.actionsOnSave": [
        "addOverride",
        "instanceofPatternMatch",
        "switchExpression"
    ],

    // Lombok via redhat.java's built-in support, not the deprecated extension.
    "java.jdt.ls.lombokSupport.enabled": true,

    "sonarlint.disableTelemetry": true,

    "spring-boot.ls.problem.application-properties.enabled": true,
    "spring-boot.ls.problem.application-yaml.enabled": true,

    // JetBrains Kotlin LSP (Alpha, JVM-only); `intellij.*` because the server is
    // IntelliJ's engine repackaged. serverPort -1 uses the VSIX-bundled server.
    "intellij.dev.serverPort": -1,
{{ if has "jvmStack" (dig "modules" (list) .) -}}
    "intellij.jdkForSymbolResolution": "{{ .chezmoi.homeDir }}/.local/share/mise/installs/java/temurin-25/Contents/Home",
{{ end -}}
    "intellij.trace.server": "off",

    // Its first-run prompt writes both of these into this chezmoi-managed file
    // if they're unset — and the next apply wipes them straight back out, so the
    // prompt returns forever. Declared here to end that loop; "none" matches the
    // telemetry opt-outs below.
    "intellij.region": "europe",
    "intellij.dataSharing": "none",

    "terraform.languageServer.enable": true,

    "yaml.validate": true,
    "yaml.format.enable": true,
    "yaml.completion": true,
    "yaml.hover": true,
    "yaml.schemaStore.enable": true,
    "yaml.format.printWidth": 120,
    "yaml.format.singleQuote": false,
    "yaml.format.bracketSpacing": true,
    "yaml.format.proseWrap": "preserve",
    "yaml.disableSchemaDetection": [
        "**/.github/workflows/*.yml",
        "**/.github/workflows/*.yaml",
        "**/.gitea/workflows/*.yml",
        "**/.gitea/workflows/*.yaml",
        "**/.forgejo/workflows/*.yml",
        "**/.forgejo/workflows/*.yaml"
    ],

    // Format/validate XML without reflowing hand-laid-out attributes.
    "xml.format.enabled": true,
    "xml.format.maxLineWidth": 120,
    "xml.format.splitAttributes": "preserve",
    "xml.format.preserveAttributeLineBreaks": true,
    "xml.format.joinContentLines": false,
    "xml.validation.enabled": true,

    // Mirrors the repo .editorconfig (4-space indent, indent switch cases).
    "shellformat.flag": "-i 4 -ci",

    "cSpell.language": "{{ if has "locale" (dig "modules" (list) .) }}en-US,nb{{ else }}en-US{{ end }}",

    // Fall back to VS Code's native squiggle (underlines just the unknown word)
    // instead of cSpell's custom decorations, which colour the whole line.
    "cSpell.useCustomDecorations": false,

    // ~/.config/cspell/personal.txt symlinks into packages/cspell-words.txt, so
    // words added via quick-fix land in `git status` — no settings edit needed.
    "cSpell.customDictionaries": {
        "personal": {
            "name": "personal",
            "description": "Personal dictionary tracked in dotfiles",
            "path": "{{ .chezmoi.homeDir }}/.config/cspell/personal.txt",
            "addWords": true,
            "scope": "user"
        }
    },

    // Error Lens whole-line-highlights every diagnostic regardless of source,
    // which undoes cSpell.useCustomDecorations above — opt cSpell and
    // markdownlint (same noisy-line-highlight complaint in .md files) back out.
    "errorLens.excludeBySource": ["cSpell", "markdownlint"],

    // ── Language-specific ──

    // Languages Prettier cannot parse. Without these, the global
    // defaultFormatter + formatOnSave pair raises "Extension 'Prettier' is
    // configured as formatter but it cannot format 'X'-files" on every save.
    // Each of these is a file type this setup actually opens: build.gradle
    // (groovy), application.properties (properties/spring-boot-properties),
    // Makefiles, .gitignore (ignore), and interactive-rebase todo lists.
    "[groovy]": { "editor.formatOnSave": false },
    "[properties]": { "editor.formatOnSave": false },
    "[spring-boot-properties]": { "editor.formatOnSave": false },
    "[sql]": { "editor.formatOnSave": false },
    "[plaintext]": { "editor.formatOnSave": false },
    "[makefile]": { "editor.formatOnSave": false },
    "[ignore]": { "editor.formatOnSave": false },
    "[git-rebase]": { "editor.formatOnSave": false },

    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },

    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },

    "[yaml]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },

    "[xml]": {
        "editor.defaultFormatter": "redhat.vscode-xml"
    },

    "[markdown]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },

    // Commit messages: subject ≤50, body wrap at 72 — the conventional guides.
    "[git-commit]": {
        "editor.rulers": [50, 72]
    },
    "[scminput]": {
        "editor.rulers": [50, 72]
    },

    "[toml]": {
        "editor.defaultFormatter": "tamasfe.even-better-toml"
    },

    "[dockerfile]": {
        "editor.defaultFormatter": "ms-azuretools.vscode-containers"
    },

    "[shellscript]": {
        "editor.defaultFormatter": "foxundermoon.shell-format"
    },

    "[terraform]": {
        "editor.defaultFormatter": "hashicorp.terraform"
    },

    "[terraform-vars]": {
        "editor.defaultFormatter": "hashicorp.terraform"
    },

    "[spring-boot-properties-yaml]": {
        "yaml.validate": false,
        // Its own langId, so the [yaml] block above doesn't apply and the
        // global Prettier default would error on save.
        "editor.formatOnSave": false,
        "editor.quickSuggestions": {
            "strings": true
        }
    },

    "[java]": {
        "editor.defaultFormatter": "redhat.java",
        "editor.tabSize": 4,
        "editor.detectIndentation": false
    },

    // jetbrains.kotlin-server is the current extension; jetbrains.kotlin is deprecated.
    "[kotlin]": {
        "editor.defaultFormatter": "jetbrains.kotlin-server",
        "editor.tabSize": 4,
        "editor.detectIndentation": false
    },

    // Prettier formats; ESLint applies its non-format autofixes on save.
    // A language-scoped editor.codeActionsOnSave *replaces* the global one
    // rather than merging with it, so source.organizeImports has to be repeated
    // here — omitting it silently drops import organizing for TS/JS only.
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit",
            "source.fixAll.eslint": "explicit"
        }
    },

    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit",
            "source.fixAll.eslint": "explicit"
        }
    },

    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit",
            "source.fixAll.eslint": "explicit"
        }
    },

    "[javascriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit",
            "source.fixAll.eslint": "explicit"
        }
    },

    // Ruff handles both lint-fix and formatting + import sorting on save.
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnType": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports.ruff": "explicit",
            "source.fixAll.ruff": "explicit"
        }
    },

    // Swift/iOS (appleDev): Swift extension drives SourceKit-LSP, SweetPad wraps
    // xcodebuild for build/run/debug/test and owns [swift] formatting. SwiftLint
    // has no maintained VS Code integration left (see docs/editors.md) — it runs
    // via an Xcode Run Script build phase and pre-commit instead, not live in the
    // editor. vknabel's SwiftFormat/SwiftLint extensions were removed 2026-08:
    // archived upstream (unmaintained) as of 2025-11-19.
{{ if has "appleDev" (dig "modules" (list) .) -}}
    "[swift]": {
        "editor.defaultFormatter": "sweetpad.sweetpad",
        "editor.tabSize": 4,
        "editor.detectIndentation": false,
        // Empty object overrides the global source.organizeImports.
        "editor.codeActionsOnSave": {}
    },
    "swift.backgroundIndexing": true,
    "sweetpad.build.xcbeautifyEnabled": true,
    // SweetPad's formatter defaults to Xcode's bundled swift-format; point it at
    // Homebrew SwiftFormat instead so ~/.swiftformat (--maxwidth 120 etc.) applies.
    // "--quiet" ignores stderr so SweetPad doesn't misread warnings as failures.
    "sweetpad.format.path": "/opt/homebrew/bin/swiftformat",
    "sweetpad.format.args": ["--quiet", "${file}"],
    // No-op unless a workspace has a project.yml at its root; regenerates the
    // .xcodeproj automatically when Swift files are added/removed.
    "sweetpad.xcodegen.autogenerate": true,
{{ end -}}

    // ── Performance ──

    "extensions.ignoreRecommendations": true,
    "telemetry.telemetryLevel": "off",
    "redhat.telemetry.enabled": false,

    "update.mode": "manual",

    // ── Security ──

    "security.workspace.trust.enabled": true
}
