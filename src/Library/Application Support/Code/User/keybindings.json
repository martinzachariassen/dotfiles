// Editor-chrome chords vim doesn't cover (vim leader maps live in settings.json);
// chosen not to clobber macOS defaults.
[
    { "key": "cmd+ctrl+right", "command": "workbench.action.moveEditorToNextGroup" },
    { "key": "cmd+ctrl+left", "command": "workbench.action.moveEditorToPreviousGroup" },
    { "key": "cmd+ctrl+up", "command": "workbench.action.toggleMaximizeEditorGroup" },

    { "key": "cmd+ctrl+t", "command": "workbench.action.terminal.split", "when": "terminalFocus" },

    // Sweetpad Xcode-style build loop, scoped to Swift so cmd+r doesn't hijack
    // other languages; cmd+ctrl+r not cmd+. (that's Quick Fix).
    { "key": "cmd+r", "command": "sweetpad.build.launch", "when": "editorLangId == swift" },
    {
        "key": "cmd+shift+r",
        "command": "runCommands",
        "args": { "commands": ["sweetpad.build.clean", "sweetpad.build.launch"] },
        "when": "editorLangId == swift"
    },
    { "key": "cmd+ctrl+r", "command": "sweetpad.build.stop", "when": "editorLangId == swift" }
    // cmd+ctrl+l was bound to swiftlint.fixDocument until 2026-08. That command
    // came from vknabel.vscode-swiftlint, which was dropped as unmaintained, so
    // the binding was a no-op. SwiftLint now runs via an Xcode build phase and
    // pre-commit; see docs/editors.md.
]
