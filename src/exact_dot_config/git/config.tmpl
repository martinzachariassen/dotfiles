{{/* Signing: prefer .signingMode (off | ssh-key | 1password); fall back to the
     legacy useOnePassword bool for pre-signingMode configs. Only emit a signing
     block when a mode is active AND a key is set, so key-less users aren't broken. */ -}}
{{- $signingMode := dig "signingMode" (ternary "1password" "off" (dig "useOnePassword" true .)) . -}}
{{- $signing := and (ne $signingMode "off") .signingKey -}}
[user]
    name = {{ .name }}
    email = {{ .email }}
{{- if $signing }}
    signingkey = {{ .signingKey }}
{{- end }}

[init]
    defaultBranch = main

{{ if $signing -}}
# Signing on (signingMode = {{ $signingMode }}). Disable: signingMode = "off" in
# ~/.config/chezmoi/chezmoi.toml, then `chezmoi apply`.
[commit]
    gpgsign = true

[gpg]
    format = ssh

[gpg "ssh"]
{{ if eq $signingMode "1password" }}    program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
{{ end }}    allowedSignersFile = ~/.config/git/allowed_signers
{{- end }}

[core]
    editor = nvim
    pager = delta
    # Built-in fsmonitor + untracked cache: faster `git status` on large repos.
    fsmonitor = true
    untrackedCache = true

[commit]
    verbose = true

[column]
    ui = auto

[tag]
    # Semantic-version sort so v1.10 sorts after v1.9, not lexically.
    sort = version:refname

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    line-numbers = true
    side-by-side = false
    # Same -FRK flags as $LESS in ~/.zshenv; deliberately no -X (alt-screen so
    # output clears on exit instead of cluttering scrollback).
    pager = "less -FRK -P'Press q or Ctrl-C to quit · / search · h for help'"

[diff]
    colorMoved = default
    algorithm = histogram
    mnemonicPrefix = true

[merge]
    conflictstyle = zdiff3

[push]
    default = simple
    autoSetupRemote = true
    followTags = true

[pull]
    rebase = true
    ff = only

[rebase]
    autoStash = true
    autoSquash = true

[rerere]
    enabled = true
    autoupdate = true

[fetch]
    prune = true
    pruneTags = true

[branch]
    sort = -committerdate

[help]
    autocorrect = prompt

[alias]
    s   = status -sb
    co  = checkout
    sw  = switch
    br  = branch --sort=-committerdate
    lg  = log --oneline --graph --decorate -20
    last = log -1 HEAD --stat
    unstage = reset HEAD --
    amend = commit --amend --no-edit
    fixup = commit --fixup
    wip  = !git add -A && git commit -m 'wip' --no-verify
    undo = reset --soft HEAD~1

# Push via SSH even when cloned over HTTPS.
[url "git@github.com:"]
    pushInsteadOf = https://github.com/
