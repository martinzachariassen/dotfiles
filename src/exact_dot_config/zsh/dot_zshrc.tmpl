# ~/.config/zsh/.zshrc — interactive shell. Rendered from dot_zshrc.tmpl; edit via
# `chezmoi edit ~/.config/zsh/.zshrc`. Profile: {{ .profile }}

# ─── Shell options ────────────────────────────────────────────────────────────
setopt INTERACTIVE_COMMENTS
setopt AUTO_CD
setopt AUTO_PUSHD
setopt PUSHD_IGNORE_DUPS
setopt CORRECT
setopt EXTENDED_GLOB

# ─── Tooling ──────────────────────────────────────────────────────────────────
command -v mise >/dev/null && eval "$(mise activate zsh)"

# ─── History ──────────────────────────────────────────────────────────────────
# macOS /etc/zshrc runs after ~/.zshenv and resets HISTFILE; re-set it here (last
# rc to run) so our XDG path wins.
export HISTFILE="$XDG_STATE_HOME/zsh/history"
[ -d "${HISTFILE%/*}" ] || mkdir -p "${HISTFILE%/*}"
HISTSIZE=50000
SAVEHIST=50000
setopt EXTENDED_HISTORY
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS
setopt HIST_SAVE_NO_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_VERIFY
setopt SHARE_HISTORY

# ─── Completion ───────────────────────────────────────────────────────────────
ZSH_COMPDUMP="$XDG_CACHE_HOME/zsh/zcompdump"
[ -d "${ZSH_COMPDUMP%/*}" ] || mkdir -p "${ZSH_COMPDUMP%/*}"

# Homebrew completions must be on fpath before compinit.
if [ -d /opt/homebrew/share/zsh/site-functions ]; then
    fpath=(/opt/homebrew/share/zsh/site-functions $fpath)
fi
if [ -d /opt/homebrew/share/zsh-completions ]; then
    fpath=(/opt/homebrew/share/zsh-completions $fpath)
fi

autoload -Uz compinit
# -C skips the per-shell security audit; brew perms are tightened at install time
# and after every `brew bundle`, so it has nothing to find. Audit via `compaudit`.
compinit -C -d "$ZSH_COMPDUMP"
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# ─── Key bindings ─────────────────────────────────────────────────────────────
# Force emacs keymap; zsh would otherwise infer vi from $EDITOR=nvim.
bindkey -e

# ↑/↓ prefix-aware history search, cursor left at end-of-line.
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
# Bind terminfo codes and literal ^[[ sequences so it works in either cursor mode.
[ -n "${terminfo[kcuu1]}" ] && bindkey "${terminfo[kcuu1]}" up-line-or-beginning-search
[ -n "${terminfo[kcud1]}" ] && bindkey "${terminfo[kcud1]}" down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search

# ─── fzf ──────────────────────────────────────────────────────────────────────
# Use fd as the walker: faster than find, respects .gitignore.
if command -v fd >/dev/null; then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --strip-cwd-prefix --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_COMMAND='fd --type d --hidden --strip-cwd-prefix --exclude .git'
fi
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border --info=inline'
command -v fzf >/dev/null && eval "$(fzf --zsh 2>/dev/null)"

# ─── zoxide ───────────────────────────────────────────────────────────────────
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"

# ─── carapace ─────────────────────────────────────────────────────────────────
if command -v carapace >/dev/null; then
    export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense'
    zstyle ':completion:*' format $'\e[2;37mCompleting %d\e[m'
    source <(carapace _carapace zsh)
fi

# ─── Starship prompt ──────────────────────────────────────────────────────────
command -v starship >/dev/null && eval "$(starship init zsh)"

# ─── Modern CLI replacements ──────────────────────────────────────────────────
# Alias only if present so a fresh box still works.
command -v eza >/dev/null && {
    alias ls='eza --group-directories-first'
    alias ll='eza -lah --group-directories-first --git --time-style=long-iso'
    alias tree='eza --tree --level=3 --group-directories-first'
}
command -v bat >/dev/null && alias cat='bat --paging=never --style=plain'
# `find` is deliberately NOT aliased to fd — fd isn't a drop-in and silently
# misbehaves for muscle-memory `find … -exec` invocations.

# ─── Tool shortcuts ───────────────────────────────────────────────────────────
alias n='nvim'
alias lg='lazygit'
alias d='docker'
alias dc='docker compose'
command -v terraform >/dev/null && alias tf='terraform'  # work profile only
alias mw='./mvnw'
alias gw='./gradlew'
command -v kubectl >/dev/null && {
    alias k='kubectl'
    alias kgp='kubectl get pods'
    alias klf='kubectl logs -f'
}

{{ if has "appleDev" (dig "modules" (list) .) -}}
# ─── Swift / iOS ──────────────────────────────────────────────────────────────
alias xcderived='rm -rf ~/Library/Developer/Xcode/DerivedData'  # nuke stale build cache
alias simulator='open -a Simulator'
command -v xcbeautify >/dev/null && alias xcb='xcbeautify'

{{ end -}}
# ─── Quality-of-life ──────────────────────────────────────────────────────────
alias g='git'
alias gs='git status -sb'
alias gd='git diff'
alias gl='git log --oneline --graph --decorate -20'
alias ..='cd ..'
alias ...='cd ../..'

mkcd() { mkdir -p "$1" && cd "$1" || return; }

# ─── Dotfiles meta-commands ───────────────────────────────────────────────────
# _chez_run REL [args...] — run a repo helper by working-tree-relative path (baked
# in at apply time). If the script is missing — repo moved it but this shell's
# config predates the change — self-heal: pull + apply to regenerate these
# functions, then reload so the corrected paths take effect.
_chez_run() {
    local rel=$1
    shift
    local src={{ .chezmoi.workingTree | quote }}
    if [[ -f $src/$rel ]]; then
        bash "$src/$rel" "$@"
        return
    fi
    print -ru2 -- "dotfiles: $src/$rel is missing — this shell's config predates a repo change."
    if ! command -v chezmoi >/dev/null 2>&1; then
        print -ru2 -- "  chezmoi isn't on PATH; fix by hand: cd ${(q)src} && git pull && chezmoi apply && exec zsh"
        return 1
    fi
    print -ru2 -- "  re-syncing this machine (git pull + chezmoi apply)…"
    (cd "$src" && git pull --ff-only) 2>/dev/null
    chezmoi apply || return 1
    if [[ -o interactive ]]; then
        print -ru2 -- "  synced — reloading your shell. Re-run your command."
        exec zsh
    fi
    print -ru2 -- "  synced — open a new shell (or run: exec zsh)."
}

# Not auto-run by `chezmoi apply` — invoke on a fresh Mac or after resetting a pref pane.
alias macos-defaults='_chez_run scripts/bin/macos-defaults.sh'

# No args: cd into the source repo. With args: point at the setup verbs.
dotfiles() {
    local src={{ .chezmoi.workingTree | quote }}
    if [ "$#" -eq 0 ]; then
        cd "$src" || return
    else
        echo "Re-choose your setup (profile, modules, signing):"
        echo "    chezreset                  # plain-text wizard, then applies"
        echo
        echo "Or just fill in newly-added setup keys (keeps current answers):"
        echo "    chezreinit"
        echo
        echo "List every dotfiles command:"
        echo "    chezhelp"
    fi
}

# Quiet `chezmoi apply --force` with a single upfront confirm when managed files
# in $HOME have drifted (plain apply's per-file prompt collides with later sudo
# prompts). Pass -v for the per-file content diffs.
chez() {
    local status_output response
    status_output=$(chezmoi status --exclude scripts 2>&1)
    if [ -n "$status_output" ]; then
        echo
        echo "── Pending changes ───────────────────────────────────────────"
        echo "$status_output"
        echo "──────────────────────────────────────────────────────────────"
        echo "  What this means:"
        echo "    chezmoi has file changes to apply and/or managed files in \$HOME drifted."
        echo
        echo "  Status codes:"
        echo "    A add   M modify   D remove"
        echo "    left column = your \$HOME edits (drift), right column = repo → \$HOME (apply)"
        echo "    plain-language breakdown: \`chezdiff\`"
        echo
        echo "  Choices:"
        echo "    y + Enter      apply now with \`chezmoi apply --force\`"
        echo "                   this overwrites drift in managed \$HOME files"
        echo "    n or Enter     abort; inspect first with \`chezdiff\` (plain) or \`chezmoi diff\` (raw)"
        echo
        printf "Apply these managed dotfile changes now? [y/N] "
        read -r response < /dev/tty
        case "$response" in
            [yY]|[yY][eE][sS]) ;;
            *) echo "Aborted."; return 1 ;;
        esac
    fi
    chezmoi apply --force "$@"
    local rc=$?
    # Flag packages present locally but in no Brewfile so `chez` never silently
    # uninstalls; `chezmirror` reconciles on demand.
    if command -v brew >/dev/null 2>&1; then
        local untracked
        untracked=$(_chez_brew_untracked)
        if [ -n "$untracked" ]; then
            echo
            echo "  ℹ $(printf '%s\n' "$untracked" | grep -c .) brew package(s) installed locally but in no Brewfile."
            echo "    review: chezaudit   ·   reconcile (uninstall): chezmirror"
        fi
    fi
    return $rc
}

# Plain-language, read-only drift explainer: translates `chezmoi status`'s two-letter
# codes into a directional summary of what `chez` would do. Never applies or pulls.
chezdiff() {
    case "${1:-}" in
        -h | --help)
            echo "usage: chezdiff [-v|--verbose] [PATH …]"
            echo "  (no args)   plain-language summary of pending changes + local drift"
            echo "  PATH        raw \`chezmoi diff\` for a file (e.g. chezdiff ~/.zshrc)"
            echo "  -v          raw \`chezmoi diff\` for everything"
            return 0
            ;;
        -v | --verbose)
            shift
            chezmoi diff "$@"
            return
            ;;
        ?*)
            chezmoi diff "$@"
            return
            ;;
    esac

    local status_output
    status_output=$(chezmoi status --exclude scripts 2>&1) || {
        print -ru2 -- "chezdiff: \`chezmoi status\` failed:"
        print -ru2 -- "$status_output"
        return 1
    }
    if [ -z "$status_output" ]; then
        echo "  ✓ in sync — no pending changes, nothing edited locally"
        echo "    (package drift is tracked separately: chezaudit)"
        return 0
    fi

    # right column → "apply would write", left column → "you edited locally". A file
    # that drifted AND changed upstream (MM) lands in both.
    local pending drift line col1 col2 path
    pending=""
    drift=""
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        col1=${line:0:1}
        col2=${line:1:1}
        path=${line:3}
        case "$col2" in
            A) pending+="    add      ~/$path"$'\n' ;;
            M) pending+="    modify   ~/$path"$'\n' ;;
            D) pending+="    remove   ~/$path"$'\n' ;;
        esac
        case "$col1" in
            A) drift+="    added    ~/$path"$'\n' ;;
            M) drift+="    edited   ~/$path"$'\n' ;;
            D) drift+="    deleted  ~/$path"$'\n' ;;
        esac
    done <<<"$status_output"

    if [ -n "$pending" ]; then
        echo "── Repo → \$HOME · what \`chez\` would write ───────────────────"
        printf '%s' "$pending"
        echo
    fi
    if [ -n "$drift" ]; then
        echo "── Local drift · managed files you edited in \$HOME ───────────"
        printf '%s' "$drift"
        echo "  ⚠ \`chez\` overwrites these. Keep an edit instead: chezmoi re-add ~/…"
        echo
    fi
    echo "  See a file's exact lines:  chezdiff ~/path   ·   all:  chezdiff -v"
    echo "  Apply now:                 chez              ·   packages:  chezaudit"
}

# ─── Everyday: the two commands that keep a machine in sync ───────────────────
# Converge this Mac to the repo: pull + preview + apply. Brew/mise apply scripts
# reconcile real installed state on every apply, so packages match too.
# Knobs: YES=1 skip confirm · DRY_RUN=1 print without running. Extra args → apply.
chezup() {
    _chez_run scripts/bin/chezup.sh "$@"
}

# Read-only full-stack health check.
chezdoctor() {
    _chez_run scripts/bin/doctor.sh
}

# ─── Advanced / occasional chezmoi helpers ────────────────────────────────────
# Fill in newly-added setup keys only; keeps answers you've already given (chezmoi's
# prompt*Once reads persisted answers). To re-choose everything, use `chezreset`.
chezreinit() {
    local src={{ .chezmoi.workingTree | quote }}
    (cd "$src" && git pull --ff-only) || return $?
    echo "chezreinit: filling in any new/unanswered setup keys only."
    echo "            to re-choose profile/modules/signing, run: chezreset"
    chezmoi init && chez "$@"
}

# Set this Mac up "as new": reset chezmoi's persistent state so run_once_* /
# run_onchange_* hooks re-fire, re-ask the full wizard, then apply. Does NOT
# uninstall packages or delete files. Confirm-gated.
chezreset() {
    local src reply
    src={{ .chezmoi.workingTree | quote }}
    # Self-heal a stale wizard path BEFORE the destructive state reset below —
    # never leave the machine half-reset with no way to finish the wizard.
    [[ -f $src/scripts/bin/wizard.sh ]] || { _chez_run scripts/bin/wizard.sh "$@"; return; }
    (cd "$src" && git pull --ff-only) || return $?
    if [ -r /dev/tty ]; then
        printf 'chezreset: replay first-time setup (reset run-once state, re-ask the wizard)? [y/N] '
        IFS= read -r reply </dev/tty || reply=""
        case "$reply" in
            y | Y | yes | YES) ;;
            *)
                echo "aborted — nothing changed"
                return 0
                ;;
        esac
    fi
    chezmoi state reset --force || return $?
    bash "$src/scripts/bin/wizard.sh" "$@"
}

# Routine dependency bump: brew + mise global runtimes. Per-project runtimes travel
# with their own repos. Doesn't auto-commit — review the diff yourself.
chezbump() {
    local src={{ .chezmoi.workingTree | quote }}
    echo "── brew update + upgrade ─────────────────────────────────────"
    brew update && brew upgrade
    echo
    echo "── Untracked Homebrew packages (in no Brewfile tier) ──────────"
    local removals
    removals=$(_chez_brew_removals "$src")
    if [ -n "$removals" ]; then
        printf '%s\n' "$removals" | awk -F'\t' '{ printf "  %-8s %s\n", $1, $2 }'
        echo "  (reconcile with \`chezmirror\` to uninstall — it prompts per package)"
    else
        echo "  ✓ none — every installed package is tracked"
    fi
    if command -v mise >/dev/null 2>&1; then
        echo
        echo "── mise upgrade (global runtimes) ─────────────────────────────"
        mise upgrade || true
    fi
    echo
    echo "Now: cd $src && git diff   to review, then commit."
}

# Internal: names of `brew leaves` formulae installed locally but in no Brewfile
# tier (one per line, empty when in sync). Both sides are reduced to the bare leaf
# name so tap-qualified formulae (hashicorp/tap/terraform) don't read as untracked.
# Formulae only — casks come via `brew bundle cleanup` in _chez_brew_removals.
_chez_brew_untracked() {
    local src={{ .chezmoi.workingTree | quote }}
    local tracked
    tracked=$(grep -h '^\(brew\|cask\) ' "$src"/packages/Brewfile "$src"/packages/Brewfile.* 2>/dev/null \
        | sed -E 's/^(brew|cask) "([^"]+)".*/\2/' \
        | awk -F/ '{print $NF}' \
        | sort -u)
    comm -23 <(brew leaves 2>/dev/null | awk -F/ '{print $NF}' | sort -u) \
        <(printf '%s\n' "$tracked")
}

# Internal: emit "<kind>\t<name>" (cask | formula | tap) for every Homebrew item in
# no Brewfile tier — the authoritative removal set chezmirror acts on. Takes repo
# root as $1; pure, so it's unit-testable against a stubbed `brew`.
#
# The tier set is the `Brewfile.*` glob — NOT a hardcoded list — so a newly added
# tier (e.g. Brewfile.apple-dev) is honoured automatically; hardcoding once made
# chezmirror flag every apple-dev package as untracked. Matches _chez_brew_untracked.
# `brew bundle cleanup` honours only ONE --file, so tiers are concatenated onto
# stdin (--file=-); passing several --file would read just the last tier.
_chez_brew_removals() {
    local src=$1
    cat "$src"/packages/Brewfile "$src"/packages/Brewfile.* 2>/dev/null |
        brew bundle cleanup --file=- 2>/dev/null | awk '
            /^Would uninstall casks:/    { kind = "cask";    next }
            /^Would uninstall formulae:/ { kind = "formula"; next }
            /^Would untap:/              { kind = "tap";     next }
            # Reset on the cache-pruning / trailer sections so their paths never
            # leak in as bogus "formula" removals.
            /^Would .brew cleanup.:/     { kind = "";        next }
            /^Run .brew bundle cleanup/  { kind = "";        next }
            kind && NF                   { print kind "\t" $0 }
        '
}

# Internal: remove one package, routing casks and taps to the right subcommand.
# Split out so the dispatch is unit-testable without a TTY.
_chez_brew_uninstall_one() {
    if [ "$1" = cask ]; then
        brew uninstall --cask "$2"
    elif [ "$1" = tap ]; then
        brew untap "$2"
    else
        brew uninstall "$2"
    fi
}

# Report brew packages installed locally but tracked in no Brewfile. Reports only;
# use `chezmirror` to act.
chezaudit() {
    local untracked
    untracked=$(_chez_brew_untracked)
    if [ -z "$untracked" ]; then
        echo "  ✓ no untracked brew packages"
    else
        echo "── Untracked (installed locally, not in any Brewfile) ────────"
        echo "$untracked"
        echo
        echo "Add to the right Brewfile (packages/Brewfile / packages/Brewfile.mac-apps /"
        echo "packages/Brewfile.personal / packages/Brewfile.work),"
        echo "or reconcile with \`chezmirror\` to uninstall everything untracked."
    fi
}

# Enforce the Brewfile in the REMOVAL direction: uninstall packages in no Brewfile
# tier. Deliberately NOT wired into `chez` (a routine apply should never silently
# uninstall). Asks per package by default; --all/-a does one bulk confirm; YES=1
# skips even that. No controlling terminal ⇒ removes nothing.
chezmirror() {
    local src={{ .chezmoi.workingTree | quote }}

    local all=0 bulk_confirm=1 arg
    [ "${YES:-}" = 1 ] && { all=1; bulk_confirm=0; }
    for arg in "$@"; do
        case "$arg" in
            -a | --all | -y | --yes) all=1 ;;
            -h | --help)
                echo "usage: chezmirror [--all|-a | --yes|-y]"
                echo "  (no flag)   confirm each untracked package individually"
                echo "  --all, -a   uninstall the whole untracked set after ONE confirmation"
                echo "  --yes, -y   alias of --all;  YES=1 chezmirror skips that confirmation"
                return 0
                ;;
            *)
                echo "chezmirror: unknown option: $arg (try --help)" >&2
                return 2
                ;;
        esac
    done

    local parsed
    parsed=$(_chez_brew_removals "$src")

    if [ -z "$parsed" ]; then
        echo "  ✓ nothing to remove — every installed package is tracked"
        return 0
    fi

    echo "── Untracked (installed locally, in no Brewfile tier) ────────"
    printf '%s\n' "$parsed" | awk -F'\t' '{ printf "  %-8s %s\n", $1, $2 }'
    echo

    # `[ -r /dev/tty ]` is unreliable (perm bits read rw with no controlling tty),
    # so actually try to open it — a failed open is the real "no terminal" signal.
    if ! { : </dev/tty; } 2>/dev/null; then
        echo "No TTY — not removing. Re-run interactively to confirm each."
        return 0
    fi

    if [ "$all" -eq 1 ] && [ "$bulk_confirm" -eq 1 ]; then
        local count ok
        count=$(printf '%s\n' "$parsed" | grep -c .)
        if command -v gum >/dev/null 2>&1; then
            gum confirm "Uninstall ALL $count untracked package(s)?" && ok=1 || ok=0
        else
            local reply
            printf 'Uninstall ALL %s untracked package(s)? [y/N] ' "$count"
            IFS= read -r reply </dev/tty || reply=""
            case "$reply" in y | Y | yes | YES) ok=1 ;; *) ok=0 ;; esac
        fi
        [ "$ok" -eq 1 ] || { echo "aborted — nothing removed"; return 0; }
    fi

    # Phase 1 — decide. Confirm each package (unless accept-all) and collect the
    # approved set; nothing is uninstalled yet. Feed the list on fd 3, NOT stdin:
    # `gum confirm` reads keypresses from stdin, so a here-string on fd 0 would
    # make gum auto-answer "no" and drain the list.
    local kind name reply ok kept=0 approved=""
    while IFS=$'\t' read -r kind name <&3; do
        [ -n "$name" ] || continue
        if [ "$all" -eq 1 ]; then
            ok=1
        elif command -v gum >/dev/null 2>&1; then
            gum confirm "Uninstall ${kind} ${name}?" && ok=1 || ok=0
        else
            printf 'Uninstall %s %s? [y/N] ' "$kind" "$name"
            IFS= read -r reply </dev/tty || reply=""
            case "$reply" in y | Y | yes | YES) ok=1 ;; *) ok=0 ;; esac
        fi
        if [ "$ok" -eq 1 ]; then
            approved+="${kind}"$'\t'"${name}"$'\n'
        else
            kept=$((kept + 1))
        fi
    done 3<<<"$parsed"

    # Phase 2 — remove, retrying in passes. `brew bundle cleanup` lists deps BEFORE
    # their dependents, so a one-shot pass fails on every shared dep ("still a
    # dependency"). Keep looping until a whole pass removes nothing: each pass frees
    # the leaves, unblocking the deps beneath them next time. Suppress brew's stderr
    # so the transient "refusing to uninstall" noise doesn't leak — whatever is
    # still stuck after no pass makes progress is reported once, cleanly.
    # List on fd 3 again, keeping brew's stdin on the terminal — a here-string on
    # fd 0 would become brew's stdin and, if it ever read a line, drain the pass.
    local removed=0 pending=$approved progressed leftover
    while [ -n "$pending" ]; do
        progressed=0 leftover=""
        while IFS=$'\t' read -r kind name <&3; do
            [ -n "$name" ] || continue
            if _chez_brew_uninstall_one "$kind" "$name" 2>/dev/null; then
                removed=$((removed + 1))
                progressed=1
            else
                leftover+="${kind}"$'\t'"${name}"$'\n'
            fi
        done 3<<<"$pending"
        pending=$leftover
        [ "$progressed" -eq 1 ] || break
    done

    if [ -n "$pending" ]; then
        echo
        echo "  ! still installed — a package outside your Brewfiles still needs these:"
        printf '%s' "$pending" | awk -F'\t' 'NF { printf "      %-8s %s\n", $1, $2 }'
    fi

    echo
    echo "  removed $removed · kept $kept"
    [ "$removed" -gt 0 ] && echo "  Tip: \`brew autoremove\` prunes any now-orphaned dependencies."
    return 0
}

# Mirror the TOP LEVEL of $HOME to what chezmoi manages: list untracked ~/.*
# entries (minus keepHome in cleanup.toml) and remove only what you confirm. The
# file analogue of chezmirror; ~/.config is mirrored separately (exact_ + keep-
# list). Confirms each by default; --all/-a bulk-confirms; YES=1 skips prompts;
# DRY_RUN=1 previews. No controlling terminal ⇒ removes nothing.
chezclean() {
    _chez_run scripts/bin/clean.sh "$@"
}

# Print every dotfiles verb, grouped by frequency. Static text (no subprocesses).
# Mirrors README.md / docs/commands.md — keep the three in sync.
chezhelp() {
    cat <<'EOF'

  ── dotfiles commands ─────────────────────────────────────────────
  Converge this Mac to the repo. Two verbs day to day; the rest are
  for setup changes and package drift.

  Everyday
    chezup           Pull → preview → apply. The command you run most.
    chezdoctor       Read-only health check (repo, brew, auth, mise, shell).

  Change your setup (re-run the wizard)
    chezreset        Set up as new: reset run-once state, re-ask wizard, apply.
    chezreinit       Fill in newly-added setup keys; keeps existing answers.

  Maintenance (packages & drift)
    chez             Apply without pulling. Flags drift; never uninstalls.
    chezdiff         Explain pending changes + local drift in plain words (read-only).
    chezbump         Upgrade deps: brew upgrade + mise upgrade.
    chezaudit        List locally-installed packages in no Brewfile (report).
    chezmirror       Uninstall untracked packages, confirming each.
                       --all/-a  uninstall the whole set after one confirmation.
    chezclean        Remove untracked top-level ~/.* entries, confirming each.
                       --all/-a  remove the whole set after one confirmation.
    dotfiles         cd into the source repo.

  Under the hood
    install.sh       Bootstrap a fresh Mac (curl | bash entry point).
    macos-defaults   (Re-)apply macOS system defaults on their own.
    chezhelp         Show this list.

  Knobs (chezup / chez / chezclean):  DRY_RUN=1 print only  ·  YES=1 skip confirm
  YES=1 chezmirror / chezclean:  accept-all — remove everything untracked, no prompts
  Deeper docs:  run `dotfiles`, then see docs/commands.md
EOF
}

# ─── Zellij ───────────────────────────────────────────────────────────────────
# One Ghostty window = one Zellij session. First window in a project gets the
# project name; later windows in the same project get "-2", "-3"… so two windows
# never co-attach to one session (which mirrors keystrokes). A new window always
# lands in a *fresh* session, and closing a window reaps its session (see the
# TRAPHUP below), so the "-N" suffix stays low instead of climbing all day.
# Deliberate resurrection/join is `zj <name>`.

# Session name from arg, else the git repo root name so every window inside a
# project shares one base regardless of which subdir it opened in. Outside a repo:
# cwd basename ($HOME → "home"). Folds slashes/spaces and lowercases.
_zj_session_name() {
    local name="${1:-}"
    if [[ -z "$name" ]]; then
        local root
        if root="$(command git rev-parse --show-toplevel 2>/dev/null)" && [[ -n "$root" ]]; then
            name="${root:t}"
        elif [[ "$PWD" == "$HOME" ]]; then
            name="home"
        else
            name="${PWD:A:t}"
        fi
    fi
    name="${name//\//-}"
    name="${name// /-}"
    print -r -- "${(L)name:-home}"
}

# First unused session name for base $1: "<base>", else "<base>-2"… Every existing
# session counts as taken — running OR exited — so `attach -c` always creates a
# brand-new session and never resurrects a stale one.
_zj_pick_session() {
    local base="$1" out line name
    local -A taken=()
    out="$(command zellij list-sessions --no-formatting 2>/dev/null)" || out=""
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        name="${line%% \[Created*}"
        taken[$name]=1
    done <<< "$out"
    local candidate="$base" n=2
    while (( ${+taken[$candidate]} )); do
        candidate="${base}-$((n++))"
    done
    print -r -- "$candidate"
}

# Drop exited/serialized sessions so the graveyard can't accumulate (and so a
# fresh window keeps low suffixes). Non-force ⇒ only ever touches dead sessions.
_zj_prune() { command zellij delete-all-sessions -y >/dev/null 2>&1; }

# zj [name]  no arg: attach to a fresh session for cwd. With a name: attach even
#            if running (joining/resurrecting a named session on purpose). zj -l lists.
zj() {
    if [[ "${1:-}" == "-l" || "${1:-}" == "--list" ]]; then
        zellij list-sessions
        return
    fi
    if [[ -n "${1:-}" ]]; then
        zellij attach -c "$(_zj_session_name "$1")"
    else
        zellij attach -c "$(_zj_pick_session "$(_zj_session_name)")"
    fi
}
alias zjclean='zellij delete-all-sessions -y'

if [[ -n "$ZELLIJ" ]]; then
    # Inside a pane Ghostty's shell integration isn't injected, so set the OSC 2
    # title ourselves: short path at the prompt, running command during execution.
    _zj_title_precmd()  { print -n "\e]2;${(%):-%(4~|…/%3~|%~)}\a"; }
    _zj_title_preexec() { print -rn -- $'\e]2;'"${1//[[:cntrl:]]}"$'\a'; }
    _zj_rename_tab() { command zellij action rename-tab "${PWD:A:t}" 2>/dev/null; }
    autoload -Uz add-zsh-hook
    add-zsh-hook precmd  _zj_title_precmd
    add-zsh-hook preexec _zj_title_preexec
    add-zsh-hook chpwd   _zj_rename_tab
    _zj_rename_tab
elif [[ "$TERM_PROGRAM" == "ghostty" && -z "$NO_ZELLIJ" && -z "$VSCODE_INJECTION" \
        && -t 1 ]] && command -v zellij >/dev/null; then
    # Auto-attach only in Ghostty. Plain call (not exec): detaching drops back to a
    # working shell in the same tab. Escape hatch: NO_ZELLIJ=1 zsh.
    _zj_prune
    _ZJ_SESSION="$(_zj_pick_session "$(_zj_session_name)")"
    # Closing the window (PTY hangup → SIGHUP) reaps this window's own session, so
    # detached daemons can't pile up and inflate the "-N" suffix. A manual detach
    # returns from attach normally (no HUP) and is left alone — resurrect it later
    # with `zj <name>`. Only ever touches the one session this window created.
    TRAPHUP() { command zellij kill-session "$_ZJ_SESSION" >/dev/null 2>&1 }
    zellij attach -c "$_ZJ_SESSION"
fi

