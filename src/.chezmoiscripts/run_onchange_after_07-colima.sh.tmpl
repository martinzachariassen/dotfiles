#!/usr/bin/env bash
# Registers the colima launchd agent when the agent or the VM template changes.
# Re-registering is how an edited plist takes effect at all — launchd caches the
# loaded copy, so a rewritten file alone changes nothing.
#
# The engine is features/containers/hook.sh; this template holds only what must
# be decided at render time. All three are hashed, so an edit to any one of them
# re-fires the hook — hashing only this file would freeze the engine.
#
# Engine hash:   {{ include "../features/containers/hook.sh" | sha256sum }}
# colima plist   hash: {{ include "Library/LaunchAgents/no.mlz.colima.plist.tmpl" | sha256sum }}
# VM template    hash: {{ include "dot_config/colima/_templates/default.yaml" | sha256sum }}

set -euo pipefail

{{ if ne .chezmoi.os "darwin" -}}
echo "→ colima: not on macOS, skipping"
exit 0
{{ end -}}

exec bash "{{ .chezmoi.workingTree }}/features/containers/hook.sh" "{{ .chezmoi.homeDir }}"
