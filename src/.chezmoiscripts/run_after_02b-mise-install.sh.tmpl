#!/usr/bin/env bash
# run_after_02b-mise-install — materialize mise's global toolchain.
# The engine is features/runtimes/hook.sh; this template holds only the
# render-time darwin guard.
#
# run_after (not onchange): a runtime can go missing while config.toml stays
# put, so it re-converges every apply. That also means there is no recorded hash
# to freeze — the engine is hashed anyway, so the reason this hook re-runs stays
# the same one for every delegating hook in the repo.
#
# Engine hash: {{ include "../features/runtimes/hook.sh" | sha256sum }}

set -euo pipefail

{{ if ne .chezmoi.os "darwin" -}}
echo "→ mise: not on macOS, skipping"
exit 0
{{ end -}}

exec bash "{{ .chezmoi.workingTree }}/features/runtimes/hook.sh"
