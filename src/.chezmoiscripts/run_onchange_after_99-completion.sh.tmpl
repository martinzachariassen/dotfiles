#!/usr/bin/env bash
# run_onchange_after_99-completion — closing summary at the end of an apply.
# "99-" sorts last; onchange keeps `chezmoi diff` clean between runs.

set -euo pipefail

PROFILE="{{ .profile }}"
SOURCE="{{ .chezmoi.workingTree }}"
SIGNING="{{ dig "signingMode" (ternary "1password" "off" (dig "useOnePassword" true .)) . }}"
SIGNKEY="{{ dig "signingKey" "" . }}"

EXTRAS=""
{{ range $m := (dig "modules" (list) .) -}}
EXTRAS="${EXTRAS}{{ $m }} · "
{{ end -}}
EXTRAS="${EXTRAS% · }"
[ -z "$EXTRAS" ] && EXTRAS="(none enabled)"

if [ -t 1 ]; then
    B=$'\033[1m'; D=$'\033[2m'
    G=$'\033[32m'; C=$'\033[36m'; Y=$'\033[33m'; M=$'\033[35m'
    R=$'\033[0m'
else
    B="";D="";G="";C="";Y="";M="";R=""
fi

# Setup can defer the signing key: on a fresh Mac it's still locked in 1Password,
# which Homebrew only just installed. Surface the one-shot fix rather than
# letting the machine sit silently unsigned.
SIGN_STEP=""
if [ "$SIGNING" != "off" ] && [ -z "$SIGNKEY" ]; then
    SIGN_STEP="
    ${M}4.${R} ${C}chezsign${R}
       ${Y}Signing is deferred${R} — no key is set yet, so commits are unsigned.
       Run this once 1Password is signed in and its SSH agent is on; it offers
       the agent's keys and changes nothing else about your setup."
fi

cat <<EOF

${C}╭────────────────────────────────────────────────────────────╮${R}
${C}│${R}  ${G}${B}chezmoi apply complete${R}                                  ${C}│${R}
${C}╰────────────────────────────────────────────────────────────╯${R}

  ${B}Setup${R}
    Profile       ${G}${PROFILE}${R}
    Modules       ${EXTRAS}
    Signing       ${G}${SIGNING}${R}
    Source        ${D}${SOURCE}${R}

  ${B}Next moves${R}
    ${M}1.${R} ${C}exec zsh${R}
       Reload the managed shell.

    ${M}2.${R} ${C}bash ${SOURCE}/scripts/bin/bootstrap-auth.sh${R}
       Sign in to gh, optional cloud CLIs, and verify git signing.

    ${M}3.${R} ${C}chezdoctor${R}
       Run a health check after auth is done.
${SIGN_STEP}

  ${B}Daily commands${R}
    ${C}chezup${R}      converge this Mac to the repo (pull, apply, install packages)
    ${C}chezdoctor${R}  full-stack health check
    ${D}advanced: chezapply · chezsetup · chezbump · chezstatus${R}

${D}Walk the wizard again with ${C}bash ${SOURCE}/install.sh${D}.${R}
EOF
