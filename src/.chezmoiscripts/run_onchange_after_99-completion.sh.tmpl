#!/usr/bin/env bash
# run_onchange_after_99-completion — closing summary at the end of an apply.
# "99-" sorts last; onchange keeps `chezmoi diff` clean between runs.

set -euo pipefail

PROFILE="{{ .profile }}"
SOURCE="{{ .chezmoi.workingTree }}"
SIGNING="{{ dig "signingMode" (ternary "1password" "off" (dig "useOnePassword" true .)) . }}"
EMAIL="{{ dig "email" "" . }}"
SIGNKEY="{{ dig "signingKey" "" . }}"

EXTRAS=""
{{ range $m := (dig "modules" (list) .) -}}
EXTRAS="${EXTRAS}{{ $m }} · "
{{ end -}}
EXTRAS="${EXTRAS% · }"
[ -z "$EXTRAS" ] && EXTRAS="(none enabled)"

if [ -t 1 ]; then
    B=$'\033[1m'; D=$'\033[2m'
    G=$'\033[32m'; C=$'\033[36m'; Y=$'\033[33m'; M=$'\033[35m'
    R=$'\033[0m'
else
    B="";D="";G="";C="";Y="";M="";R=""
fi

# Steps 1-3 are unconditional; the two below are appended only when they apply,
# so the numbering is counted rather than hardcoded.
NEXT=4
STEPS=""

# add_step BODY — append an optional step, carrying its own blank line above it.
# STEPS is spliced onto the end of step 3's last line rather than sitting on its
# own heredoc line, so when no optional step applies it contributes nothing at
# all instead of an orphan blank.
add_step() {
    STEPS="${STEPS}

${1}"
    NEXT=$((NEXT + 1))
}

# Setup allows a blank email — the address is usually a GitHub noreply nobody
# has memorised on install day. Say so here, because the consequence (git
# refusing to commit) otherwise turns up much later, in an unrelated repo.
if [ -z "$EMAIL" ]; then
    add_step "    ${M}${NEXT}.${R} ${C}chez setup${R}
       ${Y}No git email is set${R} — git will refuse to commit until there is one.
       Better than the alternative: an empty address authors every commit as
       \"<>\", which GitHub cannot attribute and only a rewrite undoes.
       chez setup re-asks just this question. Your noreply address is at
       github.com → Settings → Emails."
fi

# Setup can defer the signing key: on a fresh Mac it's still locked in 1Password,
# which Homebrew only just installed. Surface the one-shot fix rather than
# letting the machine sit silently unsigned.
if [ "$SIGNING" != "off" ] && [ -z "$SIGNKEY" ]; then
    add_step "    ${M}${NEXT}.${R} ${C}chez sign${R}
       ${Y}Signing is deferred${R} — no key is set yet, so commits are unsigned.
       Run this once 1Password is signed in and its SSH agent is on; it offers
       the agent's keys and changes nothing else about your setup."
fi

# An apply installs the Swift tooling but never Xcode itself — install.sh only
# gets you the Command Line Tools, and `xcodes install` needs an Apple ID with
# 2FA, so it can't run unattended from here. Without this prompt the machine
# looks finished while still unable to build a single iOS app.
{{ if has "appleDev" (dig "modules" (list) .) -}}
# shellcheck source=../../features/xcode/probe.sh
if [ -r "{{ .chezmoi.workingTree }}/features/xcode/probe.sh" ]; then
    . "{{ .chezmoi.workingTree }}/features/xcode/probe.sh"
    # Cheap probes only — this runs at the end of every apply, so the slower
    # xcodebuild round-trips are left to `chez xcode --check` and `chez doctor`.
    if ! xcode_app_path >/dev/null 2>&1; then
        XCODE_MSG="${Y}No Xcode is installed${R} — the Swift CLIs are in place, but"$'\n'"       nothing can build an iOS app yet."
    elif ! xcode_selected_is_full; then
        XCODE_MSG="${Y}The Command Line Tools are still the active toolchain${R} —"$'\n'"       xcodebuild resolves to them, not to Xcode."
    elif ! xcode_has_ios_runtime; then
        XCODE_MSG="${Y}No iOS simulator runtime is downloaded${R} — since Xcode 16 it"$'\n'"       ships separately, so there is nothing to run an app on."
    else
        XCODE_MSG=""
    fi
    if [ -n "$XCODE_MSG" ]; then
        add_step "    ${M}${NEXT}.${R} ${C}chez xcode${R}
       ${XCODE_MSG}
       Installs Xcode, selects it, accepts the licence and fetches a simulator
       runtime. Needs your Apple ID; budget ~40 GB. Check state: chez xcode --check"
    fi
fi
{{ end -}}

cat <<EOF

${C}╭────────────────────────────────────────────────────────────╮${R}
${C}│${R}  ${G}${B}chezmoi apply complete${R}                                  ${C}│${R}
${C}╰────────────────────────────────────────────────────────────╯${R}

  ${B}Setup${R}
    Profile       ${G}${PROFILE}${R}
    Modules       ${EXTRAS}
    Signing       ${G}${SIGNING}${R}
    Source        ${D}${SOURCE}${R}

  ${B}Next moves${R}
    ${M}1.${R} ${C}exec zsh${R}
       Reload the managed shell.

    ${M}2.${R} ${C}chez auth${R}
       Sign in to gh, optional cloud CLIs, and verify git signing.

    ${M}3.${R} ${C}chez doctor${R}
       Run a health check after auth is done.${STEPS}

  ${B}Daily commands${R}
    ${C}chez up${R}      converge this Mac to the repo (pull, apply, install packages)
    ${C}chez doctor${R}  full-stack health check
    ${D}everything else: ${C}chez help${D} — the old chez up/chezdoctor names still work${R}

${D}Walk the wizard again with ${C}bash ${SOURCE}/install.sh${D}.${R}
EOF
