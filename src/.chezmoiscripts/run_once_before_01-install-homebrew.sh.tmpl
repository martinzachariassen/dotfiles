#!/usr/bin/env bash
# Installs Homebrew if missing. Runs once, before the first apply.
set -euo pipefail

{{ if ne .chezmoi.os "darwin" -}}
echo "→ Homebrew: not on macOS, skipping"
exit 0
{{ end -}}

echo "◆ One-time setup: Homebrew"

if command -v brew >/dev/null 2>&1; then
    echo "✓ Homebrew already installed"
    exit 0
fi

echo "→ Installing Homebrew. This is usually about a minute on a fresh Mac."
installer="$(mktemp)"
trap 'rm -f "$installer"' EXIT
curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh -o "$installer"
NONINTERACTIVE=1 /bin/bash "$installer"
rm -f "$installer"
trap - EXIT

if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

echo "✓ Homebrew installed and ready"
