#!/usr/bin/env bash
# Applies scripts/bin/macos-defaults.sh when its contents change (run_once would
# silently ignore later edits). Re-apply without editing via the `macos-defaults` alias.
#
# scripts/bin/macos-defaults.sh  hash: {{ include "../scripts/bin/macos-defaults.sh" | sha256sum }}

set -euo pipefail

{{ if ne .chezmoi.os "darwin" -}}
echo "→ macOS defaults: not on macOS, skipping"
exit 0
{{ end -}}

{{ if not (has "macosDefaults" (dig "modules" (list) .)) -}}
echo "→ macOS defaults: 'macosDefaults' module not selected, skipping"
exit 0
{{ end -}}

echo "▶ macOS defaults"
echo "  System preferences pass (re-runs when the defaults script changes)."
echo "  Some changes need a reboot."

# chezmoi runs scripts with stdin closed; sudo inside macos-defaults.sh would hang without this.
# shellcheck source=../../scripts/lib/tty.sh
. "{{ .chezmoi.workingTree }}/scripts/lib/tty.sh"
if ! tty_reattach; then
    echo "! no terminal available; skipping macOS defaults"
    echo "  Run later with: macos-defaults"
    echo "  Or: bash {{ .chezmoi.workingTree }}/scripts/bin/macos-defaults.sh"
    exit 0
fi

bash "{{ .chezmoi.workingTree }}/scripts/bin/macos-defaults.sh"

echo "✓ macOS defaults applied"
