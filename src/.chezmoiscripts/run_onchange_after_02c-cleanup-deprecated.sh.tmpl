#!/usr/bin/env bash
# run_onchange_after_02c-cleanup-deprecated — remove tools this repo has dropped.
#
# apply/brew bundle only add, never remove, so dropped tools linger. This is the
# one place that removes intentionally-dropped tooling, driven by the manifest
# below — only items NAMED there, each guarded by a presence check. The
# irreversible ~/.codex removal always confirms first. run_onchange re-fires only
# when this script's content changes; idempotent guards make any re-fire cheap.

set -euo pipefail

{{ if ne .chezmoi.os "darwin" -}}
echo "→ Cleanup: not on macOS, skipping"
exit 0
{{ end -}}

# Put Homebrew's bin on PATH when apply runs outside a login shell, so the
# `command -v brew` check below finds the binary.
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# ─── Deprecation manifest ─────────────────────────────────────────────────────
DEPRECATED_FORMULAE=(
    "direnv"        # replaced by mise's per-project [env]
    "node"          # runtimes now come from mise
)
DEPRECATED_CASKS=(
    "temurin@21"        # JDKs now come from mise
    "temurin@25"
    "microsoft-outlook" # conflicts_with the M365 suite that bundles it
    "codex"             # repo no longer manages OpenAI tooling
    "chatgpt"
)
# Deprecated data paths OUTSIDE ~/.config, driven from src/.chezmoidata/cleanup.toml.
# (~/.config deprecations are now removed automatically by the exact_ mirror —
# see src/exact_dot_config + the keep-list in .chezmoiignore — so they don't
# belong here.) Paths are $HOME-relative in the manifest; prefixed here.
DEPRECATED_PATHS=(
{{- range .cleanup.deprecatedPaths }}
    "{{ $.chezmoi.homeDir }}/{{ . }}"
{{- end }}
)
# Dangling symlinks need their own list: a broken symlink fails `-e` (which
# follows the link to a missing target) but still passes `-L`.
DEPRECATED_SYMLINKS=(
{{- range .cleanup.deprecatedSymlinks }}
    "{{ $.chezmoi.homeDir }}/{{ . }}"
{{- end }}
)

echo "◆ Cleanup: removing deprecated tools"

removed_any=false

# ─── 1. Deprecated Homebrew formulae + casks ──────────────────────────────────
if command -v brew >/dev/null 2>&1; then
    installed_formulae="$(brew list --formula -1 2>/dev/null || true)"
    for f in ${DEPRECATED_FORMULAE[@]+"${DEPRECATED_FORMULAE[@]}"}; do
        if printf '%s\n' "$installed_formulae" | grep -qx "$f"; then
            echo "→ uninstalling deprecated formula: $f"
            if brew uninstall "$f" >/dev/null 2>&1; then
                removed_any=true
            else
                echo "  ! kept $f — still required by another package (\`brew uses --installed $f\`)"
            fi
        fi
    done

    installed_casks="$(brew list --cask -1 2>/dev/null || true)"
    for c in ${DEPRECATED_CASKS[@]+"${DEPRECATED_CASKS[@]}"}; do
        if printf '%s\n' "$installed_casks" | grep -qx "$c"; then
            echo "→ uninstalling deprecated cask: $c"
            if brew uninstall --cask "$c" >/dev/null 2>&1; then
                removed_any=true
            else
                echo "  ! could not remove cask $c (remove manually: brew uninstall --cask $c)"
            fi
        fi
    done
fi

# ─── 2. Deprecated data paths + dangling symlinks ─────────────────────────────
for p in ${DEPRECATED_PATHS[@]+"${DEPRECATED_PATHS[@]}"}; do
    if [ -e "$p" ] || [ -L "$p" ]; then
        echo "→ removing $p"
        rm -rf "$p" && removed_any=true
    fi
done
for s in ${DEPRECATED_SYMLINKS[@]+"${DEPRECATED_SYMLINKS[@]}"}; do
    # -L catches a dangling symlink; -e covers a symlink to an existing target.
    if [ -L "$s" ] || [ -e "$s" ]; then
        echo "→ removing symlink $s"
        rm -f "$s" && removed_any=true
    fi
done

# ─── 3. ~/.codex (auth + history — confirm first) ────────────────────────────
# Holds auth.json + session history; confirm before deleting so we never silently
# remove auth material (reopen the TTY since chezmoi disconnects stdin).
codex_dir="{{ .chezmoi.homeDir }}/.codex"
if [ -d "$codex_dir" ]; then
    codex_size="$(du -sh "$codex_dir" 2>/dev/null | cut -f1 || echo '?')"
    echo
    echo "── ~/.codex cleanup ──────────────────────────────────────────"
    echo "  Codex CLI is gone, but its state dir is still at $codex_dir ($codex_size)."
    echo "  It contains auth.json and session history. Removal is irreversible."

    exec </dev/tty || true
    resp=""
    printf "  Delete %s now? [y/N] " "$codex_dir"
    read -r resp </dev/tty 2>/dev/null || resp=""
    case "$resp" in
        [yY]|[yY][eE][sS])
            if rm -rf "$codex_dir"; then
                echo "✓ Removed $codex_dir"
                removed_any=true
            else
                echo "  ! could not remove $codex_dir — delete it manually"
            fi
            ;;
        *)
            echo "  Skipped. Remove later with: rm -rf $codex_dir"
            ;;
    esac
fi

if [ "$removed_any" = true ]; then
    echo "✓ Deprecated tools cleaned up"
else
    echo "✓ Nothing to clean up"
fi
