#!/usr/bin/env bash
# run_onchange_after_02e-pre-commit-install — activate this repo's git hooks.
#
# `pre-commit install` writes a dispatcher into .git/hooks — a per-clone action
# chezmoi can't express as a managed file (hooks live under .git). run_onchange
# keyed on the config hash below re-fires only when the hook set (or this script)
# changes; `pre-commit install` is idempotent. The binary comes from brew-bundle (02).
#
# pre-commit config hash: {{ include "../.pre-commit-config.yaml" | sha256sum }}

set -euo pipefail

{{ if ne .chezmoi.os "darwin" -}}
echo "→ pre-commit: not on macOS, skipping"
exit 0
{{ end -}}

# Put Homebrew's bin on PATH when apply runs outside a login shell, so the
# `command -v pre-commit` check below finds the bundle-installed binary.
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

echo "▶ pre-commit hooks"

if ! command -v pre-commit >/dev/null 2>&1; then
    echo "  ! pre-commit not on PATH — skipping (run \`chezup\` after brew bundle installs it)"
    exit 0
fi

# .git + .pre-commit-config.yaml live at the repo root, not src/.
repo="{{ .chezmoi.workingTree }}"
if [ ! -d "$repo/.git" ]; then
    echo "  ! ${repo} is not a git checkout — skipping hook install"
    exit 0
fi

# default_install_hook_types in the config wires up both stages; --install-hooks
# pre-builds any managed hook environments (a no-op for our language: system hooks).
( cd "$repo" && pre-commit install --install-hooks >/dev/null )

echo "  ${GREEN:-}✓${RESET:-} pre-commit hooks installed (pre-commit + commit-msg)"
