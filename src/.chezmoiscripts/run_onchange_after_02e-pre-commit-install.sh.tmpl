#!/usr/bin/env bash
# run_onchange_after_02e-pre-commit-install — activate this repo's git hooks.
# Hooks live under .git, so chezmoi can't manage them as a file; run_onchange
# keyed on the hash below re-fires only when the hook set changes.
#
# pre-commit config hash: {{ include "../.pre-commit-config.yaml" | sha256sum }}

set -euo pipefail

{{ if ne .chezmoi.os "darwin" -}}
echo "→ pre-commit: not on macOS, skipping"
exit 0
{{ end -}}

# Put Homebrew's bin on PATH so a non-login apply still finds pre-commit.
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

echo "▶ pre-commit hooks"

if ! command -v pre-commit >/dev/null 2>&1; then
    echo "  ! pre-commit not on PATH — skipping (run \`chezup\` after brew bundle installs it)"
    exit 0
fi

repo="{{ .chezmoi.workingTree }}"
if [ ! -d "$repo/.git" ]; then
    echo "  ! ${repo} is not a git checkout — skipping hook install"
    exit 0
fi

( cd "$repo" && pre-commit install --install-hooks >/dev/null )

echo "  ${GREEN:-}✓${RESET:-} pre-commit hooks installed (pre-commit + commit-msg)"
