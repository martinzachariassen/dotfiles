#!/usr/bin/env bash
# run_before_00-sudo-cache — pre-authenticate sudo so later steps (brew casks,
# macos-defaults) don't prompt mid-apply. A clean TTY here also dodges a race
# where the first keystroke is eaten before sudo goes no-echo.

set -uo pipefail

{{ if ne .chezmoi.os "darwin" -}}
exit 0
{{ end -}}

if sudo -n true 2>/dev/null; then
    echo "✓ admin access already granted — you will not be asked during this apply"
else
    # chezmoi closes stdin; no TTY means nobody to ask — warn and skip.
    # shellcheck source=../../core/tty.sh
    . "{{ .chezmoi.workingTree }}/core/tty.sh"
    if ! tty_reattach; then
        echo "! no terminal available for sudo pre-auth; sudo steps may ask later or skip"
        exit 0
    fi

    cat <<'EOF'

▶ Administrator password needed

  Some apps install with an Apple installer package, and the macOS
  settings step changes system preferences. Both need admin access.

  Enter the password once here, before the noisy install output — that
  way nothing has to stop and ask you halfway through a long download.

  Nothing appears as you type — that is sudo, not a frozen terminal.
  If Touch ID for sudo is already enabled, just tap your finger.
EOF

    # Let pending output drain before sudo flips the line discipline (first-keystroke race).
    sleep 0.2

    if ! sudo -v -p "  macOS password for %u: "; then
        echo "! sudo was not cached; steps that need admin access may skip or ask again"
        exit 0
    fi
    echo "✓ password accepted — you should not be asked again during this apply"
fi

# Background keeper: refreshes the sudo timestamp until chezmoi exits, so later
# steps (brew casks, macos-defaults) don't hit a lapsed cache mid-apply.
# shellcheck source=../../core/sudo.sh
. "{{ .chezmoi.workingTree }}/core/sudo.sh"
sudo_keep_warm "$PPID"

echo "✓ sudo kept warm for this apply"
