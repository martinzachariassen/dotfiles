#!/usr/bin/env bash
# run_before_00-sudo-cache — pre-authenticate sudo up front, on a clean terminal,
# so later steps (brew casks, macos-defaults) don't prompt mid-apply. Prompting
# on a clean TTY also dodges a race where the first keystroke is eaten before
# sudo flips the line discipline to no-echo on GPU terminals.

set -uo pipefail

{{ if ne .chezmoi.os "darwin" -}}
exit 0
{{ end -}}

# Warm cache: skip the prompt but fall through to start the keeper anyway, so a
# cache that expires partway through a long apply doesn't re-prompt later.
if sudo -n true 2>/dev/null; then
    echo "✓ sudo already cached"
else
    # Re-attach stdin (chezmoi closes it); no TTY means nobody to ask — warn and skip.
    # scripts/ lives at the repo root — reach it via .chezmoi.workingTree.
    # shellcheck source=../../scripts/lib/tty.sh
    . "{{ .chezmoi.workingTree }}/scripts/lib/tty.sh"
    if ! tty_reattach; then
        echo "! no terminal available for sudo pre-auth; sudo steps may ask later or skip"
        exit 0
    fi

    cat <<'EOF'

▶ sudo access

  Some later steps need admin access for Homebrew casks and macOS
  defaults. Enter the password once here, before the noisy install output.

  If Touch ID for sudo is already enabled, just tap your finger.
EOF

    # Settle pause so pending output drains before sudo flips the line discipline
    # (guards the first-keystroke-eaten race).
    sleep 0.2

    if ! sudo -v -p "[chezmoi] sudo password: "; then
        echo "! sudo was not cached; steps that need admin access may skip or ask again"
        exit 0
    fi
    echo "✓ sudo cached for this apply"
fi

# Background keeper — refresh the sudo timestamp while chezmoi is alive, on both
# paths above, so no later step re-prompts. Only ever `sudo -n`, which extends an
# existing timestamp and never triggers Touch ID.
#
# Double-fork: `( command & )` orphans the keeper to init so zsh doesn't wait on
# our process group after apply (a perceived "halt"). Tight `sleep 2` poll so the
# keeper notices chezmoi exiting within 2s, while only refreshing every ~240s.
CHEZMOI_PID=$PPID
(
    (
        refresh_in=0
        while kill -0 "$CHEZMOI_PID" 2>/dev/null; do
            if [ "$refresh_in" -le 0 ]; then
                sudo -n true 2>/dev/null || exit
                refresh_in=240   # inside the default 5-min cache
            fi
            sleep 2
            refresh_in=$((refresh_in - 2))
        done
    ) &
) </dev/null >/dev/null 2>&1

echo "✓ sudo kept warm for this apply"
