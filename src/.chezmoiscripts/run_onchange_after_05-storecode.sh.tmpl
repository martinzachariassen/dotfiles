#!/usr/bin/env bash
# run_onchange_after_05-storecode — install storecode, the work-only security
# tool. The engine is features/storecode/hook.sh; this template holds only the
# render-time decisions: the OS and profile guards, and the install command read
# from storecode.toml.
#
# Both halves are hashed, so an edit to either re-fires the hook. Hashing only
# this file would freeze the engine — chezmoi would keep matching the recorded
# hash and the hook would never run again.
#
# Engine hash: {{ include "../features/storecode/hook.sh" | sha256sum }}

set -euo pipefail

{{ if ne .chezmoi.os "darwin" -}}
echo "→ storecode: not on macOS, skipping"
exit 0
{{ end -}}
{{ if ne .profile "work" -}}
echo "→ storecode: not the work profile, skipping"
exit 0
{{ end -}}

exec bash "{{ .chezmoi.workingTree }}/features/storecode/hook.sh" \
    "{{ .chezmoi.homeDir }}" {{ .storecode.installCmd | quote }}
