#!/usr/bin/env bash
# run_onchange_after_05-storecode — install storecode, a security tool that
# ships its own installer rather than a formula. The engine is
# features/storecode/hook.sh; this template holds only the render-time
# decisions: the OS guard and the install command read from storecode.toml.
#
# The gate IS the install command. This public repo ships `installCmd = ""`
# (the URL is not ours to publish), so on every machine but the one that fills
# it in the hook is already a no-op — which makes the data the honest gate and
# removes one entirely, rather than moving it to a tick-box that would do
# nothing for everyone who can see it. This used to read `ne .profile "work"`.
#
# Both halves are hashed, so an edit to either re-fires the hook. Hashing only
# this file would freeze the engine — chezmoi would keep matching the recorded
# hash and the hook would never run again.
#
# Engine hash: {{ include "../features/storecode/hook.sh" | sha256sum }}

set -euo pipefail

{{ if ne .chezmoi.os "darwin" -}}
echo "→ storecode: not on macOS, skipping"
exit 0
{{ end -}}
{{ if not .storecode.installCmd -}}
echo "→ storecode: no installer configured, skipping"
exit 0
{{ end -}}

exec bash "{{ .chezmoi.workingTree }}/features/storecode/hook.sh" \
    "{{ .chezmoi.homeDir }}" {{ .storecode.installCmd | quote }}
