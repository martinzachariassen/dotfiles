#!/usr/bin/env bash
# run_after_02-brew-bundle — converge Homebrew to the active Brewfiles.
# run_after (not onchange) reconciles real installed state; --no-upgrade gives
# presence not freshness (freshness is chezbump's job).

set -uo pipefail

{{ if ne .chezmoi.os "darwin" -}}
echo "→ Homebrew packages: not on macOS, skipping"
exit 0
{{ end -}}

# Reattach stdin so casks needing sudo can prompt (belt-and-braces to run_before_00-sudo-cache).
# shellcheck source=../../core/tty.sh
. "{{ .chezmoi.workingTree }}/core/tty.sh"
# shellcheck source=../../core/ui.sh
. "{{ .chezmoi.workingTree }}/core/ui.sh"
# shellcheck source=../../features/brew/lib/progress.sh
. "{{ .chezmoi.workingTree }}/features/brew/lib/progress.sh"
# shellcheck source=../../features/brew/lib/homebrew.sh
. "{{ .chezmoi.workingTree }}/features/brew/lib/homebrew.sh"
ui_init_logging
tty_reattach || warn "no terminal available; casks needing sudo may ask later"

# Guarded like every sibling hook: this file is `set -uo pipefail` (no -e), so a
# bare eval on a machine without /opt/homebrew would print a raw "No such file"
# and then march on into brew commands that don't exist.
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif ! command -v brew >/dev/null 2>&1; then
    warn "brew not found — skipping packages (expected /opt/homebrew on Apple Silicon)"
    exit 0
fi

# Before any `brew trust` call: pin trust.json to the one path the deployed
# zshenv will also make brew use. Unpinned, a `curl | bash` first install (no
# XDG_CONFIG_HOME) writes ~/.homebrew/trust.json and every later shell reads
# ~/.config/homebrew/trust.json instead.
brew_trust_store >/dev/null

{{ $modules := dig "modules" (list) . -}}
FILES=(
    "{{ .chezmoi.workingTree }}/{{ .brewfiles.core }}"
{{- range $mod, $path := .brewfiles.byModule }}
{{- if has $mod $modules }}
    "{{ $.chezmoi.workingTree }}/{{ $path }}"
{{- end }}
{{- end }}
{{- $profileFile := index .brewfiles.byProfile .profile }}
{{- if $profileFile }}
    "{{ .chezmoi.workingTree }}/{{ $profileFile }}"
{{- end }}
)

echo
printf '%s%s%s  %sHomebrew packages%s %s(profile: {{ .profile }})%s\n' \
    "$CYAN" "$NODE" "$RESET" "$BOLD" "$RESET" "$DIM" "$RESET"
explain "Installs what your profile declares. Never uninstalls; safe to re-run."

# ─── Fast path: presence-only check ───────────────────────────────────────────
missing=0
for f in "${FILES[@]}"; do
    [ -f "$f" ] || continue
    brew bundle check --no-upgrade --file="$f" >/dev/null 2>&1 || {
        missing=1
        break
    }
done
if [ "$missing" -eq 0 ]; then
    ok "already satisfied — nothing to install"
    chmod -R go-w /opt/homebrew/share/zsh* 2>/dev/null || true
    exit 0
fi
explain "Some packages are missing — installing them now. This is the slow step;" \
    "Homebrew prints its own progress below."

# ─── Pre-flight: admin access ─────────────────────────────────────────────────
# Casks that ship an Apple installer package run it under `sudo`, and Homebrew
# gives that child a closed stdin — so sudo opens /dev/tty itself and its prompt
# bypasses the pipeline below, landing *underneath* the progress bar where the
# next redraw erases it. Asking here, on a clean screen before the bar exists,
# means that prompt never has to happen at all. (brew-progress.sh handles the
# case where it does anyway: it stops drawing whenever the ticket is missing.)
#
# SUDO_PROMPT is exported for Homebrew's *own* sudo calls, which pass `-E`.
# Without it a cask asks with a bare "Password:" that names neither who is
# asking nor why, in the middle of a wall of install output.
SUDO_PROMPT="  macOS password for %u (Homebrew needs admin access): "
export SUDO_PROMPT

if ! sudo -n true </dev/null 2>/dev/null; then
    hr
    info "some apps install with an Apple installer package and need admin access"
    # dim, not explain: QUIET=1 drops prose, and a password prompt is the one
    # thing that must never arrive unannounced.
    dim "Enter your macOS login password once now, before the install starts."
    dim "Nothing appears as you type — that is normal. Touch ID works here too."
    sleep 0.2 # let the lines above drain before sudo flips the line discipline
    if sudo -v -p "  macOS password for %u: "; then
        ok "admin access granted — you should not be asked again during this install"
        # Keep the ticket alive for the whole bundle: a 65-package run is well
        # past sudo's 5-minute cache, and a cask installing at minute 12 would
        # otherwise prompt again from behind the progress bar.
        # shellcheck source=../../core/sudo.sh
        . "{{ .chezmoi.workingTree }}/core/sudo.sh"
        sudo_keep_warm "$$"
    else
        warn "no admin access — apps that need an installer package will be skipped"
        dim "Everything else still installs. Re-run \`chezup\` to finish the rest."
    fi
    hr
fi

# ─── Trust third-party taps declared in the Brewfiles ─────────────────────────
# Homebrew 6.0 ignores non-official taps until trusted, and `brew bundle` skips
# their entries without saying so — a work-profile install reported success with
# neither kubelogin nor terraform on the machine. Trust is granted here, then
# read back, and anything that didn't take is named loudly *before* the progress
# bar starts, because a warning printed underneath the bar is a warning nobody
# sees.
untrusted_taps="$(brew_trust_taps "${FILES[@]}")"
if [ -n "$untrusted_taps" ]; then
    hr
    warn "Homebrew will not load these taps, so their packages get skipped:"
    while IFS= read -r taprepo; do
        [ -n "$taprepo" ] || continue
        dim "    $taprepo"
    done <<EOF
$untrusted_taps
EOF
    dim "    fix: brew trust --tap <name>, then re-run \`chezup\`"
    hr
fi

# ─── Pre-flight: clear stale partial downloads ───────────────────────────────
# A leftover *.incomplete can trigger a race that makes brew bundle wrongly report the file as failed.
cache_dir="$(brew --cache 2>/dev/null)/downloads"
[ -d "$cache_dir" ] && rm -f "$cache_dir"/*.incomplete 2>/dev/null || true

# Skip per-formula post-install cleanup — it's the step that raced above.
export HOMEBREW_NO_INSTALL_CLEANUP=1

# ─── Install missing entries (continue-on-error) ──────────────────────────────
# The denominator is real: `brew bundle` prints exactly one line per entry —
# "Using <name>" when already present, or "<verb> <name>" (Installing/Upgrading/
# Tapping) when it acts. So total = declared entries, and each such line is one
# entry genuinely finished. Nothing here animates on a timer.
total=0
for f in "${FILES[@]}"; do
    [ -f "$f" ] || continue
    total=$((total + $(brew_pkg_count "$f")))
done

BUNDLE_DONE="__bundle_done_$$__"
BREW_LOG="$(mktemp -t brewbundle 2>/dev/null || echo "/tmp/brewbundle.$$")"
RC_FILE="$(mktemp -t brewrc 2>/dev/null || echo "/tmp/brewrc.$$")"
failures=()
start_all="$(ui_now)"

ui_progress_start "$total" "packages"
for f in "${FILES[@]}"; do
    if [ ! -f "$f" ]; then
        warn "Brewfile missing: $f"
        continue
    fi
    printf '1\n' >"$RC_FILE"
    {
        brew bundle install --no-upgrade --file="$f"
        printf '%s\n' "$?" >"$RC_FILE"
        printf '%s\n' "$BUNDLE_DONE"
    } 2>&1 | tee -a "$BREW_LOG" | brew_progress_consume "$BUNDLE_DONE"
    [ "$(cat "$RC_FILE" 2>/dev/null || echo 1)" = "0" ] || failures+=("$(basename "$f")")
done
ui_progress_finish ""
rm -f "$RC_FILE" 2>/dev/null || true

# Strip group/other-write bits brew leaves on $fpath dirs, which make compinit warn.
chmod -R go-w /opt/homebrew/share/zsh* 2>/dev/null || true

if [ "${#failures[@]}" -gt 0 ]; then
    # Keep the log somewhere that survives a reboot. mktemp lands in
    # /var/folders, which macOS purges — so the "full log:" path printed below
    # was routinely dead by the time anyone went looking for it. ~/.local is on
    # cleanup.keepHome, so chezclean won't offer it either.
    log_dir="{{ .chezmoi.homeDir }}/.local/state/dotfiles"
    if mkdir -p "$log_dir" 2>/dev/null && cp "$BREW_LOG" "$log_dir/brew-bundle.log" 2>/dev/null; then
        BREW_LOG="$log_dir/brew-bundle.log"
    fi

    warn "${#failures[@]} Brewfile(s) had install failures — everything else installed:"
    for f in "${failures[@]}"; do dim "    $FAIL_MARK $f"; done

    # Name the packages, not just the file. This is the same question the user
    # would ask next, and it reports real current state rather than whatever
    # happened to scroll past.
    dim "    still missing:"
    missing_any=0
    for f in "${FILES[@]}"; do
        [ -f "$f" ] || continue
        case " ${failures[*]} " in
            *" $(basename "$f") "*) ;;
            *) continue ;;
        esac
        while IFS= read -r entry; do
            [ -n "$entry" ] || continue
            missing_any=1
            dim "      $entry ($(basename "$f"))"
        done < <(brew_unmet_entries "$f")
    done
    [ "$missing_any" -eq 1 ] || dim "      (nothing missing now — the failure looks transient)"

    # Then *why*. A blind tail of a 65-package log showed the last few successes
    # and none of the error, which is how a hard failure (xcodes needing a full
    # Xcode.app in order to build) read as a flaky download.
    dim "    what Homebrew reported:"
    brew_error_lines "$BREW_LOG" 12 | grep -v "$BUNDLE_DONE" | sed 's/^/      /'
    dim "    full log: $BREW_LOG"

    # A password prompt that expired is not a flaky download, and the generic
    # "re-run and it may work" advice below is wrong for it — say so separately.
    if brew_sudo_failed "$BREW_LOG"; then
        hr
        warn "at least one app failed because the admin password was not entered"
        dim "    macOS stops waiting after about a minute. Re-run \`chezup\` and enter"
        dim "    your password at the \"macOS password\" prompt before the install starts;"
        dim "    everything already installed is skipped, so it picks up where it left off."
    fi

    # Same reasoning for trust: an untrusted tap is not a flaky download either,
    # and it is the one failure whose symptom is a package that never appears in
    # the log at all — so re-read the store rather than grepping the output.
    still_untrusted="$(brew_trust_taps "${FILES[@]}")"
    if [ -n "$still_untrusted" ]; then
        hr
        warn "at least one tap is still untrusted, so Homebrew skipped its packages"
        while IFS= read -r taprepo; do
            [ -n "$taprepo" ] || continue
            dim "    brew trust --tap $taprepo"
        done <<EOF
$still_untrusted
EOF
        dim "    run the line(s) above, then re-run \`chezup\`."
    fi

    # Deliberately not "usually transient". Sometimes it is a download; sometimes
    # the package cannot install on this machine at all, and telling someone to
    # re-run forever is worse than telling them to read the error.
    explain "Re-run \`chezup\` to retry — already-installed packages are skipped," \
        "so it picks up where it left off. If the same package fails again, the" \
        "error above is the real reason and retrying will not change it."
    exit 0
fi
rm -f "$BREW_LOG" 2>/dev/null || true
ok "Homebrew packages up to date$(
    t="$(ui_elapsed "$start_all")"
    [ -n "$t" ] && printf ' (%s)' "$t"
)"
