#!/usr/bin/env bash
# run_after_02-brew-bundle — converge Homebrew to the active Brewfiles.
# run_after (not onchange) reconciles real installed state; --no-upgrade gives
# presence not freshness (freshness is chezbump's job).

set -uo pipefail

{{ if ne .chezmoi.os "darwin" -}}
echo "→ Homebrew packages: not on macOS, skipping"
exit 0
{{ end -}}

# Reattach stdin so casks needing sudo can prompt (belt-and-braces to run_before_00-sudo-cache).
# shellcheck source=../../scripts/lib/tty.sh
. "{{ .chezmoi.workingTree }}/scripts/lib/tty.sh"
# shellcheck source=../../scripts/lib/log.sh
. "{{ .chezmoi.workingTree }}/scripts/lib/log.sh"
# shellcheck source=../../scripts/lib/brew-progress.sh
. "{{ .chezmoi.workingTree }}/scripts/lib/brew-progress.sh"
ui_init_logging
tty_reattach || warn "no terminal available; casks needing sudo may ask later"

# Guarded like every sibling hook: this file is `set -uo pipefail` (no -e), so a
# bare eval on a machine without /opt/homebrew would print a raw "No such file"
# and then march on into brew commands that don't exist.
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif ! command -v brew >/dev/null 2>&1; then
    warn "brew not found — skipping packages (expected /opt/homebrew on Apple Silicon)"
    exit 0
fi

{{ $modules := dig "modules" (list) . -}}
FILES=(
    "{{ .chezmoi.workingTree }}/{{ .brewfiles.core }}"
{{- range $mod, $path := .brewfiles.byModule }}
{{- if has $mod $modules }}
    "{{ $.chezmoi.workingTree }}/{{ $path }}"
{{- end }}
{{- end }}
{{- $profileFile := index .brewfiles.byProfile .profile }}
{{- if $profileFile }}
    "{{ .chezmoi.workingTree }}/{{ $profileFile }}"
{{- end }}
)

echo
printf '%s%s%s  %sHomebrew packages%s %s(profile: {{ .profile }})%s\n' \
    "$CYAN" "$NODE" "$RESET" "$BOLD" "$RESET" "$DIM" "$RESET"
explain "Installs what your profile declares. Never uninstalls; safe to re-run."

# ─── Fast path: presence-only check ───────────────────────────────────────────
missing=0
for f in "${FILES[@]}"; do
    [ -f "$f" ] || continue
    brew bundle check --no-upgrade --file="$f" >/dev/null 2>&1 || {
        missing=1
        break
    }
done
if [ "$missing" -eq 0 ]; then
    ok "already satisfied — nothing to install"
    chmod -R go-w /opt/homebrew/share/zsh* 2>/dev/null || true
    exit 0
fi
explain "Some packages are missing — installing them now. This is the slow step;" \
    "Homebrew prints its own progress below."

# ─── Trust third-party taps declared in the Brewfiles ─────────────────────────
# Homebrew 6.0 ignores non-official taps until trusted; without this, `brew bundle` silently skips their formulae.
for f in "${FILES[@]}"; do
    [ -f "$f" ] || continue
    while IFS= read -r taprepo; do
        [ -n "$taprepo" ] || continue
        brew trust --tap "$taprepo" >/dev/null 2>&1 || echo "! could not trust tap: $taprepo"
    done < <(sed -n 's/^[[:space:]]*tap[[:space:]]*"\([^"]*\)".*/\1/p' "$f")
done

# ─── Pre-flight: clear stale partial downloads ───────────────────────────────
# A leftover *.incomplete can trigger a race that makes brew bundle wrongly report the file as failed.
cache_dir="$(brew --cache 2>/dev/null)/downloads"
[ -d "$cache_dir" ] && rm -f "$cache_dir"/*.incomplete 2>/dev/null || true

# Skip per-formula post-install cleanup — it's the step that raced above.
export HOMEBREW_NO_INSTALL_CLEANUP=1

# ─── Install missing entries (continue-on-error) ──────────────────────────────
# The denominator is real: `brew bundle` prints exactly one line per entry —
# "Using <name>" when already present, or "<verb> <name>" (Installing/Upgrading/
# Tapping) when it acts. So total = declared entries, and each such line is one
# entry genuinely finished. Nothing here animates on a timer.
total=0
for f in "${FILES[@]}"; do
    [ -f "$f" ] || continue
    total=$((total + $(brew_pkg_count "$f")))
done

BUNDLE_DONE="__bundle_done_$$__"
BREW_LOG="$(mktemp -t brewbundle 2>/dev/null || echo "/tmp/brewbundle.$$")"
RC_FILE="$(mktemp -t brewrc 2>/dev/null || echo "/tmp/brewrc.$$")"
failures=()
start_all="$(ui_now)"

ui_progress_start "$total" "packages"
for f in "${FILES[@]}"; do
    if [ ! -f "$f" ]; then
        warn "Brewfile missing: $f"
        continue
    fi
    printf '1\n' >"$RC_FILE"
    {
        brew bundle install --no-upgrade --file="$f"
        printf '%s\n' "$?" >"$RC_FILE"
        printf '%s\n' "$BUNDLE_DONE"
    } 2>&1 | tee -a "$BREW_LOG" | brew_progress_consume "$BUNDLE_DONE"
    [ "$(cat "$RC_FILE" 2>/dev/null || echo 1)" = "0" ] || failures+=("$(basename "$f")")
done
ui_progress_finish ""
rm -f "$RC_FILE" 2>/dev/null || true

# Strip group/other-write bits brew leaves on $fpath dirs, which make compinit warn.
chmod -R go-w /opt/homebrew/share/zsh* 2>/dev/null || true

if [ "${#failures[@]}" -gt 0 ]; then
    warn "${#failures[@]} Brewfile(s) had install failures — everything else installed:"
    for f in "${failures[@]}"; do dim "    $FAIL_MARK $f"; done
    # Output was captured to drive the bar, so surface enough to diagnose.
    dim "    last lines from Homebrew:"
    grep -v "$BUNDLE_DONE" "$BREW_LOG" 2>/dev/null | tail -n 15 | sed 's/^/      /'
    dim "    full log: $BREW_LOG"
    explain "Usually a transient download. Re-run \`chezup\` to retry —" \
        "already-installed packages are skipped, so it picks up where it left off."
    exit 0
fi
rm -f "$BREW_LOG" 2>/dev/null || true
ok "Homebrew packages up to date$(
    t="$(ui_elapsed "$start_all")"
    [ -n "$t" ] && printf ' (%s)' "$t"
)"
