#!/usr/bin/env bash
# run_after_02-brew-bundle — converge Homebrew to the active Brewfiles.
#
# run_after (every apply), not run_onchange, so real installed state is
# reconciled. --no-upgrade guarantees presence not freshness, so a clean machine
# short-circuits instead of upgrading every apply (freshness is `chezbump`'s job).
# The active file set comes from .chezmoidata/packages.toml (core + modules + profile).

set -uo pipefail

{{ if ne .chezmoi.os "darwin" -}}
echo "→ Homebrew packages: not on macOS, skipping"
exit 0
{{ end -}}

# Reattach stdin so casks that invoke sudo can read the password (belt-and-braces
# to run_before_00-sudo-cache's pre-auth). scripts/ + packages/ live at the repo
# root — reach them via .chezmoi.workingTree.
# shellcheck source=../../scripts/lib/tty.sh
. "{{ .chezmoi.workingTree }}/scripts/lib/tty.sh"
tty_reattach || echo "! no terminal available; casks needing sudo may ask later"

eval "$(/opt/homebrew/bin/brew shellenv)"

# Active Brewfiles resolved at render time: core + selected modules + profile.
{{ $modules := dig "modules" (list) . -}}
FILES=(
    "{{ .chezmoi.workingTree }}/{{ .brewfiles.core }}"
{{- range $mod, $path := .brewfiles.byModule }}
{{- if has $mod $modules }}
    "{{ $.chezmoi.workingTree }}/{{ $path }}"
{{- end }}
{{- end }}
{{- $profileFile := index .brewfiles.byProfile .profile }}
{{- if $profileFile }}
    "{{ .chezmoi.workingTree }}/{{ $profileFile }}"
{{- end }}
)

echo "▶ Homebrew packages (profile: {{ .profile }})"

# ─── Fast path: presence-only check ───────────────────────────────────────────
missing=0
for f in "${FILES[@]}"; do
    [ -f "$f" ] || continue
    brew bundle check --no-upgrade --file="$f" >/dev/null 2>&1 || {
        missing=1
        break
    }
done
if [ "$missing" -eq 0 ]; then
    echo "  ✓ already satisfied — nothing to install"
    chmod -R go-w /opt/homebrew/share/zsh* 2>/dev/null || true
    exit 0
fi

# ─── Trust third-party taps declared in the Brewfiles ─────────────────────────
# Homebrew 6.0 ignores non-official taps until trusted (docs.brew.sh/Tap-Trust);
# a `tap` line in our Brewfile is the trust decision, so mirror it into the trust
# store before install or `brew bundle` silently skips those formulae. Idempotent.
for f in "${FILES[@]}"; do
    [ -f "$f" ] || continue
    while IFS= read -r taprepo; do
        [ -n "$taprepo" ] || continue
        brew trust --tap "$taprepo" >/dev/null 2>&1 || echo "! could not trust tap: $taprepo"
    done < <(sed -n 's/^[[:space:]]*tap[[:space:]]*"\([^"]*\)".*/\1/p' "$f")
done

# ─── Pre-flight: clear stale partial downloads ───────────────────────────────
# A leftover *.incomplete from an interrupted fetch can trigger a `dir_s_rmdir`
# race that aborts an otherwise-successful pour, making `brew bundle` report the
# file as failed. `rm -f` is idempotent.
cache_dir="$(brew --cache 2>/dev/null)/downloads"
[ -d "$cache_dir" ] && rm -f "$cache_dir"/*.incomplete 2>/dev/null || true

# Skip per-formula post-install cleanup — it's the step that raced above.
export HOMEBREW_NO_INSTALL_CLEANUP=1

# ─── Install missing entries (continue-on-error) ──────────────────────────────
failures=()
for f in "${FILES[@]}"; do
    if [ ! -f "$f" ]; then
        echo "! Brewfile missing: $f"
        continue
    fi
    echo "→ $(basename "$f")"
    brew bundle install --no-upgrade --file="$f" || failures+=("$(basename "$f")")
done

# Strip group/other-write bits brew leaves on $fpath dirs, which make compinit warn.
chmod -R go-w /opt/homebrew/share/zsh* 2>/dev/null || true

if [ "${#failures[@]}" -gt 0 ]; then
    echo "! Homebrew: ${#failures[@]} file(s) had install failures — the rest installed:"
    for f in "${failures[@]}"; do echo "    ✗ $f"; done
    echo "  Re-run \`chezup\` to retry (already-installed items are skipped)."
    exit 0
fi
echo "✓ Homebrew packages up to date"
