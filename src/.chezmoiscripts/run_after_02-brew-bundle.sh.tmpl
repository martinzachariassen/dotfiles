#!/usr/bin/env bash
# run_after_02-brew-bundle — converge Homebrew to the active Brewfiles.
#
# Runs on EVERY apply (run_after, not run_onchange) so the machine's real
# installed state is reconciled with what the Brewfiles declare. Convergence
# guarantees PRESENCE, not freshness: --no-upgrade means a merely-outdated
# package doesn't trip the check, so a clean machine short-circuits instead of
# turning every apply into an upgrade run (freshness is `chezbump`'s job).
#
# The active file set is derived from the single source of truth in
# .chezmoidata/packages.toml (core + selected modules + profile). This uses
# Homebrew's native `brew bundle`, so there is no bespoke install engine.

set -uo pipefail

{{ if ne .chezmoi.os "darwin" -}}
echo "→ Homebrew packages: not on macOS, skipping"
exit 0
{{ end -}}

# Reattach stdin to the controlling terminal so casks that invoke sudo
# (docker-desktop, 1password) can read the password. run_before_00-sudo-cache
# does the upfront pre-auth; this is the belt-and-braces complement.
# scripts/ + packages/ live at the repo root, not under the source dir (src/),
# so reach them via .chezmoi.workingTree (the git working tree = repo root).
# shellcheck source=../../scripts/lib/tty.sh
. "{{ .chezmoi.workingTree }}/scripts/lib/tty.sh"
tty_reattach || echo "! no terminal available; casks needing sudo may ask later"

eval "$(/opt/homebrew/bin/brew shellenv)"

# Active Brewfiles, resolved from .chezmoidata/packages.toml at render time:
# core (always) + each selected module's file + the profile's file (if any).
{{ $modules := dig "modules" (list) . -}}
FILES=(
    "{{ .chezmoi.workingTree }}/{{ .brewfiles.core }}"
{{- range $mod, $path := .brewfiles.byModule }}
{{- if has $mod $modules }}
    "{{ $.chezmoi.workingTree }}/{{ $path }}"
{{- end }}
{{- end }}
{{- $profileFile := index .brewfiles.byProfile .profile }}
{{- if $profileFile }}
    "{{ .chezmoi.workingTree }}/{{ $profileFile }}"
{{- end }}
)

echo "▶ Homebrew packages (profile: {{ .profile }})"

# ─── Fast path: presence-only check (--no-upgrade), skip when nothing missing ──
missing=0
for f in "${FILES[@]}"; do
    [ -f "$f" ] || continue
    brew bundle check --no-upgrade --file="$f" >/dev/null 2>&1 || {
        missing=1
        break
    }
done
if [ "$missing" -eq 0 ]; then
    echo "  ✓ already satisfied — nothing to install"
    chmod -R go-w /opt/homebrew/share/zsh* 2>/dev/null || true
    exit 0
fi

# ─── Trust third-party taps declared in the Brewfiles ─────────────────────────
# Homebrew 6.0 ignores formulae/casks from non-official taps until they're
# trusted (docs.brew.sh/Tap-Trust). Declaring a `tap` line in our own Brewfile
# IS the trust decision — so mirror it into Homebrew's trust store before
# install, otherwise `brew bundle` silently skips e.g. Azure/kubelogin (kubelogin)
# and hashicorp/tap (terraform) on a fresh machine. Idempotent: re-trusting an
# already-trusted tap is a no-op.
for f in "${FILES[@]}"; do
    [ -f "$f" ] || continue
    while IFS= read -r taprepo; do
        [ -n "$taprepo" ] || continue
        brew trust --tap "$taprepo" >/dev/null 2>&1 || echo "! could not trust tap: $taprepo"
    done < <(sed -n 's/^[[:space:]]*tap[[:space:]]*"\([^"]*\)".*/\1/p' "$f")
done

# ─── Pre-flight: clear stale partial downloads ───────────────────────────────
# An interrupted earlier fetch (Ctrl-C, crash, flaky network) can leave a
# *.incomplete file in Homebrew's download cache. On the next fetch Homebrew
# tries to remove it and can hit a `dir_s_rmdir - No such file or directory`
# race — which aborts an otherwise-successful pour, so the package installs but
# `brew bundle` reports the whole file as failed. `rm -f` is idempotent and
# ignores the (already-)missing files, making the run quiet and repeatable.
cache_dir="$(brew --cache 2>/dev/null)/downloads"
[ -d "$cache_dir" ] && rm -f "$cache_dir"/*.incomplete 2>/dev/null || true

# Skip Homebrew's per-formula post-install cleanup during the bundle: it's the
# step that raced above, and a single cleanup elsewhere (or `brew cleanup`)
# reclaims space without turning a good install into a reported failure.
export HOMEBREW_NO_INSTALL_CLEANUP=1

# ─── Install missing entries (continue-on-error; failures summarised) ─────────
failures=()
for f in "${FILES[@]}"; do
    if [ ! -f "$f" ]; then
        echo "! Brewfile missing: $f"
        continue
    fi
    echo "→ $(basename "$f")"
    brew bundle install --no-upgrade --file="$f" || failures+=("$(basename "$f")")
done

# brew installs sometimes leave group/other-write bits on share dirs that land
# on zsh's $fpath, which makes compinit warn at every startup. Strip them.
chmod -R go-w /opt/homebrew/share/zsh* 2>/dev/null || true

if [ "${#failures[@]}" -gt 0 ]; then
    echo "! Homebrew: ${#failures[@]} file(s) had install failures — the rest installed:"
    for f in "${failures[@]}"; do echo "    ✗ $f"; done
    echo "  Re-run \`chezup\` to retry (already-installed items are skipped)."
    exit 0
fi
echo "✓ Homebrew packages up to date"
