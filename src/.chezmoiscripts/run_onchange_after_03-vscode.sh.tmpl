#!/usr/bin/env bash
# Mirror VS Code extensions to packages/vscode-extensions.txt (installs listed,
# uninstalls untracked). Re-runs when this script or the manifest changes.
#
# Marketplace extension manifest hash: {{ include "../packages/vscode-extensions.txt" | sha256sum }}

set -euo pipefail

{{ if ne .chezmoi.os "darwin" -}}
echo "→ VS Code: not on macOS, skipping"
exit 0
{{ end -}}

# Put Homebrew's bin on PATH when apply runs outside a login shell, so the
# `command -v code` check below finds the bundle-installed binary.
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# packages/ and scripts/ live at the repo root — reach them via .chezmoi.workingTree.
ROOT="{{ .chezmoi.workingTree }}"
EXTENSIONS_FILE="$ROOT/packages/vscode-extensions.txt"
EXTENSIONS_DIR="{{ .chezmoi.homeDir }}/.vscode/extensions"

# shellcheck source=../../scripts/lib/vscode.sh
. "$ROOT/scripts/lib/vscode.sh"

if ! command -v code >/dev/null 2>&1; then
    echo "! VS Code CLI not found; extension sync skipped"
    exit 0
fi

if [ ! -f "$EXTENSIONS_FILE" ]; then
    echo "! VS Code extension manifest missing: $EXTENSIONS_FILE"
    exit 0
fi

installed_extensions() {
    code --list-extensions 2>/dev/null | tr '[:upper:]' '[:lower:]' || true
}

# One manifest drives both install and prune. With the locale module off, drop the
# Norwegian dictionary from it so the two directions stay consistent.
{{ if has "locale" (dig "modules" (list) .) -}}
MANIFEST="$(vscode_read_manifest "$EXTENSIONS_FILE")"
{{ else -}}
MANIFEST="$(vscode_read_manifest "$EXTENSIONS_FILE" "streetsidesoftware.code-spell-checker-norwegian-bokmal")"
{{ end -}}

install_marketplace_extensions() {
    local installed ext
    installed="$(installed_extensions)"
    while IFS= read -r ext || [ -n "$ext" ]; do
        [ -n "$ext" ] || continue
        if printf '%s\n' "$installed" | grep -qxF "$ext"; then
            echo "✓ extension already installed: $ext"
        else
            echo "→ installing extension: $ext"
            # Continue-on-error: one bad ID mustn't abort the rest.
            code --install-extension "$ext" || echo "  ! failed to install: $ext (continuing)"
        fi
    done <<EOF
$MANIFEST
EOF
}

# The CLI refuses to uninstall an extension *pack* whose members have external
# dependents (e.g. vscjava.vscode-java-pack bundles redhat.java). Fall back to
# removing it on disk and pruning VS Code's extensions cache.
remove_extension_on_disk() {
    local ext="$1" changed=false dir cache

    # nocaseglob guards publisher-case drift; nullglob makes a no-match expand to nothing.
    shopt -s nullglob nocaseglob
    for dir in "$EXTENSIONS_DIR/$ext"-*; do
        [ -d "$dir" ] || continue
        rm -rf "$dir" && changed=true
    done
    shopt -u nullglob nocaseglob

    # Drop the stale entry so `code --list-extensions` stops reporting a phantom failure.
    cache="$EXTENSIONS_DIR/extensions.json"
    if [ -f "$cache" ] && command -v python3 >/dev/null 2>&1; then
        if python3 - "$cache" "$ext" <<'PY'
import json, sys
cache, ext = sys.argv[1], sys.argv[2].lower()
try:
    data = json.load(open(cache))
except Exception:
    sys.exit(1)
kept = [e for e in data if e.get("identifier", {}).get("id", "").lower() != ext]
if len(kept) == len(data):
    sys.exit(1)  # nothing pruned
json.dump(kept, open(cache, "w"))
PY
        then
            changed=true
        fi
    fi

    [ "$changed" = true ]
}

# Uninstall every locally-installed extension absent from the manifest.
prune_untracked_extensions() {
    local installed untracked ext
    installed="$(installed_extensions)"
    untracked="$(vscode_untracked "$installed" "$MANIFEST")"
    [ -n "$untracked" ] || return 0

    while IFS= read -r ext || [ -n "$ext" ]; do
        [ -n "$ext" ] || continue
        echo "→ uninstalling untracked extension: $ext"
        if code --uninstall-extension "$ext" >/dev/null 2>&1; then
            continue
        fi
        # CLI refused (e.g. a pack member has external dependents) — remove on disk.
        if remove_extension_on_disk "$ext"; then
            echo "  ↳ CLI declined; removed on disk instead"
        else
            echo "  ! failed to uninstall: $ext (continuing)"
        fi
    done <<EOF
$untracked
EOF
}

echo "▶ VS Code extensions"
echo "  Manifest: $EXTENSIONS_FILE"

install_marketplace_extensions
prune_untracked_extensions

echo "✓ VS Code extensions mirror the manifest"
