#!/usr/bin/env bash
# Mirror VS Code extensions to features/vscode/extensions.txt (installs listed,
# uninstalls untracked). The engine is features/vscode/hook.sh; this template
# holds only what must be decided at render time.
#
# Both halves are hashed, so an edit to either re-fires the hook. Hashing only
# this file would freeze the engine: chezmoi would keep matching the recorded
# hash and the hook would simply never run again, with no error and no output.
#
# Engine hash:   {{ include "../features/vscode/hook.sh" | sha256sum }}
# Manifest hash: {{ include "../features/vscode/extensions.txt" | sha256sum }}
#
# The presence marker below is part of the hash on purpose — see the same note in
# run_onchange_after_02e. Skipping on a missing `code` CLI still exits 0, which
# chezmoi records as done; the marker is what makes the hook re-fire once hook 02
# has actually installed VS Code.
# VS Code CLI: {{ if lookPath "code" }}present{{ else }}absent{{ end }}

set -euo pipefail

{{ if ne .chezmoi.os "darwin" -}}
echo "→ VS Code: not on macOS, skipping"
exit 0
{{ end -}}

# Put Homebrew's bin on PATH so a non-login apply still finds the code CLI.
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

export VSCODE_EXTENSIONS_DIR="{{ .chezmoi.homeDir }}/.vscode/extensions"

# Module gates are render-time decisions, so they are resolved here and passed in.
EXCLUDES=()
{{ if not (has "locale" (dig "modules" (list) .)) -}}
EXCLUDES+=("streetsidesoftware.code-spell-checker-norwegian-bokmal") # locale module
{{ end -}}
{{ if not (has "appleDev" (dig "modules" (list) .)) -}}
EXCLUDES+=("swiftlang.swift-vscode" "sweetpad.sweetpad" "vadimcn.vscode-lldb" "llvm-vs-code-extensions.lldb-dap") # appleDev module
{{ end -}}

exec bash "{{ .chezmoi.workingTree }}/features/vscode/hook.sh" ${EXCLUDES[@]+"${EXCLUDES[@]}"}
