#!/usr/bin/env bash
# Installs VS Code extensions from the repo manifest when this script or the
# extension manifest changes.
#
# Marketplace extension manifest hash: {{ include "../packages/vscode-extensions.txt" | sha256sum }}

set -euo pipefail

{{ if ne .chezmoi.os "darwin" -}}
echo "→ VS Code: not on macOS, skipping"
exit 0
{{ end -}}

# Ensure Homebrew's bin dir is on PATH when apply runs outside a login shell
# (launchd, cron, a bare `chezmoi apply`). Mirrors run_after_02-brew-bundle so
# the `command -v code` check below finds the binary the bundle installed.
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# packages/ lives at the repo root, not the source dir (src/) — reach it via
# .chezmoi.workingTree (the git working tree = repo root).
ROOT="{{ .chezmoi.workingTree }}"
EXTENSIONS_FILE="$ROOT/packages/vscode-extensions.txt"
DEPRECATED_EXTENSIONS=(
    "continue.continue"
    "fwcd.kotlin"
    "jetbrains.kotlin"
    "jetpack-io.devbox"
    "mkhl.direnv"
    # Lombok support is now built into redhat.java (since v1.9), controlled by
    # java.jdt.ls.lombokSupport.enabled (default true). The standalone extension
    # ships an old bundled lombok.jar and is being deprecated upstream.
    "vscjava.vscode-lombok"
    # Old community Kotlin extension; superseded by jetbrains.kotlin-server.
    "mathiasfrohlich.kotlin"
    # Meta extension pack; all member extensions are already tracked
    # individually. The CLI can't uninstall it (VS Code treats removing a pack as
    # removing its members, and redhat.java has external dependents — Spring Boot
    # Tools/Dashboard), so uninstall_deprecated_extensions falls back to removing
    # it on disk.
    "vscjava.vscode-java-pack"
    # Azure Java migration wizard; not a day-to-day tool.
    "vscjava.migrate-java-to-azure"
)

if ! command -v code >/dev/null 2>&1; then
    echo "! VS Code CLI not found; extension install skipped"
    exit 0
fi

installed_extensions() {
    code --list-extensions 2>/dev/null | tr '[:upper:]' '[:lower:]' || true
}

install_marketplace_extensions() {
    if [ ! -f "$EXTENSIONS_FILE" ]; then
        echo "! VS Code extension manifest missing: $EXTENSIONS_FILE"
        return 0
    fi

    local installed ext line
    installed="$(installed_extensions)"
    while IFS= read -r line || [ -n "$line" ]; do
        ext="${line%%#*}"
        ext="$(printf '%s' "$ext" | xargs | tr '[:upper:]' '[:lower:]')"
        [ -n "$ext" ] || continue
{{ if not (has "locale" (dig "modules" (list) .)) -}}
        # locale module off: skip the Norwegian dictionary extension.
        [ "$ext" = "streetsidesoftware.code-spell-checker-norwegian-bokmal" ] && continue
{{ end -}}

        # -F = literal match (extension IDs contain "."), -x = whole line.
        # `installed` is already lowercased; `ext` matches that.
        if printf '%s\n' "$installed" | grep -qxF "$ext"; then
            echo "✓ extension already installed: $ext"
        else
            echo "→ installing extension: $ext"
            # Continue-on-error: a yanked ID, version-incompatible extension, or a
            # transient marketplace failure must not abort the extensions after it.
            code --install-extension "$ext" || echo "  ! failed to install: $ext (continuing)"
        fi
    done < "$EXTENSIONS_FILE"
}

# The VS Code CLI refuses to uninstall an extension *pack* whose members have
# external dependents — e.g. vscjava.vscode-java-pack bundles redhat.java, and
# Spring Boot Tools/Dashboard depend on redhat.java, so `code
# --uninstall-extension` errors out. The GUI can drop just the pack; the CLI
# can't express that. Fall back to removing the extension on disk and pruning
# VS Code's extensions cache (which VS Code otherwise self-heals on next launch).
EXTENSIONS_DIR="{{ .chezmoi.homeDir }}/.vscode/extensions"

remove_extension_on_disk() {
    local ext="$1" changed=false dir cache

    # Extension dirs are named "<publisher>.<name>-<version>". nocaseglob guards
    # against publisher-case drift; nullglob makes a no-match expand to nothing.
    shopt -s nullglob nocaseglob
    for dir in "$EXTENSIONS_DIR/$ext"-*; do
        [ -d "$dir" ] || continue
        rm -rf "$dir" && changed=true
    done
    shopt -u nullglob nocaseglob

    # Drop the stale entry from extensions.json so `code --list-extensions` stops
    # reporting the pack (otherwise the next apply re-reports a phantom failure).
    cache="$EXTENSIONS_DIR/extensions.json"
    if [ -f "$cache" ] && command -v python3 >/dev/null 2>&1; then
        if python3 - "$cache" "$ext" <<'PY'
import json, sys
cache, ext = sys.argv[1], sys.argv[2].lower()
try:
    data = json.load(open(cache))
except Exception:
    sys.exit(1)
kept = [e for e in data if e.get("identifier", {}).get("id", "").lower() != ext]
if len(kept) == len(data):
    sys.exit(1)  # nothing pruned
json.dump(kept, open(cache, "w"))
PY
        then
            changed=true
        fi
    fi

    [ "$changed" = true ]
}

uninstall_deprecated_extensions() {
    local installed ext
    installed="$(installed_extensions)"

    # DEPRECATED_EXTENSIONS entries are kept lowercase by convention so they
    # line up with `installed_extensions` (already lowercased). Match literally
    # with -F so dots in IDs aren't treated as regex any-char.
    for ext in "${DEPRECATED_EXTENSIONS[@]}"; do
        if printf '%s\n' "$installed" | grep -qxF "$ext"; then
            echo "→ uninstalling deprecated extension: $ext"
            if code --uninstall-extension "$ext" >/dev/null 2>&1; then
                continue
            fi
            # CLI refused (e.g. a pack member has dependents) — remove on disk.
            if remove_extension_on_disk "$ext"; then
                echo "  ↳ CLI declined; removed on disk instead"
            else
                echo "  ! failed to uninstall: $ext (continuing)"
            fi
        fi
    done
}

echo "▶ VS Code extensions"
echo "  Manifest: $EXTENSIONS_FILE"

install_marketplace_extensions
uninstall_deprecated_extensions

echo "✓ VS Code extensions are managed"
