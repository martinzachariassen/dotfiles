# ~/.swiftformat — global SwiftFormat defaults (appleDev module). Homebrew's
# swiftformat walks up the tree, so this applies to any Swift project under $HOME
# with no closer .swiftformat, which wins wholesale when present.

--swiftversion 6.0            # per-project .swift-version file overrides this

--indent 4                    # matches editor.tabSize in the VS Code [swift] block
--maxwidth 120                # kept in sync with SwiftLint line_length

--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--closingparen balanced

--commas inline
--self init-only              # keep an explicit self only where the compiler needs it
--stripunusedargs closure-only
--importgrouping testable-bottom
