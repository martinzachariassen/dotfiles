{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Read",
      "Grep",
      "WebSearch"
    ],
    "defaultMode": "default"
  },
  "theme": "dark-ansi",
  "verbose": false
}
