{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Read",
      "Grep",
      "WebSearch"
    ],
    "defaultMode": "default"
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true
  },
  "effortLevel": "high",
  "theme": "dark-ansi",
  "verbose": false,
  "model": "sonnet",
  "statusLine": {
    "type": "command",
    "command": "~/.config/claude/statusline.sh",
    "padding": 1
  },
  "spinnerTipsEnabled": false,
  "attribution": {
    "commit": ""
  }
}
