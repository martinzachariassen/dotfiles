# mise — global default runtimes. Per-project mise.toml files override these on `cd`.

[tools]
{{ if has "jvmStack" (dig "modules" (list) .) -}}
java = ["temurin-25"]
{{ end -}}

node = "lts"
# pnpm was previously installed via `npm -g` into node's install dir, which a
# runtime upgrade would silently drop; mise owns it now.
pnpm = "latest"
bun = "latest"
python = "latest"

{{ if has "jvmStack" (dig "modules" (list) .) -}}
kotlin = "latest"
maven = "latest"
gradle = "latest"
{{ end -}}
