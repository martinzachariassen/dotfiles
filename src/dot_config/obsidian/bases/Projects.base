views:
  - type: table
    name: Active projects
    filters:
      and:
        - 'note.type == "project"'
        - 'note.status != "done"'
    order:
      - file.name
      - note.status
      - note.domain
      - note.priority
      - note.target
      - note.repo
  - type: table
    name: Areas
    filters:
      and:
        - 'note.type == "area"'
    order:
      - file.name
      - note.domain
      - note.review
  - type: table
    name: Inbox to file
    filters:
      and:
        - 'note.type == "inbox"'
    order:
      - file.name
      - note.created
