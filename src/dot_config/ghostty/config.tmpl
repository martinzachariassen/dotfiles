# Ghostty config — managed by chezmoi. https://ghostty.org/docs/config/reference
# Ghostty has NO inline comments: `# foo` after a value is parsed as part of the
# value and errors on launch. Every comment must be on its own line.

# ─── Theme ────────────────────────────────────────────────────────────────────
# Local theme file (chezmoi-managed) for version-independent colors.
{{ if has "theme" (dig "modules" (list) .) -}}
theme = catppuccin-frappe
{{ end -}}

# ─── Font ─────────────────────────────────────────────────────────────────────
font-family = JetBrainsMono Nerd Font
font-size = 13
font-feature = calt
font-feature = liga

# ─── Window ───────────────────────────────────────────────────────────────────
window-padding-x = 12
window-padding-y = 12
window-padding-balance = true
# `default`, not `always`: each Ghostty window auto-attaches its own Zellij session,
# so restoring every tab on launch just multiplies detached sessions. Let Zellij own
# persistence; a relaunch starts clean.
window-save-state = default
background-blur-radius = 20
background-opacity = 0.97

# ─── macOS-specific ───────────────────────────────────────────────────────────
macos-titlebar-style = transparent
# Keep Option available for macOS Unicode/dead-key input such as å.
macos-option-as-alt = false
macos-non-native-fullscreen = true

# ─── Cursor ───────────────────────────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = true

# ─── Mouse / clipboard ────────────────────────────────────────────────────────
mouse-hide-while-typing = true
# Match Zellij's copy_on_select for consistent behavior in and out of a session.
copy-on-select = clipboard

# ─── Shell integration ────────────────────────────────────────────────────────
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# ─── Scrollback ───────────────────────────────────────────────────────────────
# Measured in BYTES, not lines (default 10MB); allocated lazily. 100MB ≈ 100k
# lines of heavily-styled output where ANSI escapes count against the limit.
scrollback-limit = 100000000

# ─── Keybindings ──────────────────────────────────────────────────────────────
keybind = cmd+k=clear_screen
keybind = cmd+enter=toggle_fullscreen
keybind = cmd+shift+period=inspector:toggle
# Tab bindings (Cmd+T/W/1..9, Cmd+Shift+[ ]) are Ghostty defaults.
