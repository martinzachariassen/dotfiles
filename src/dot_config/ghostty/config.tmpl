# Ghostty config — managed by chezmoi. https://ghostty.org/docs/config/reference
# Ghostty has NO inline comments: `# foo` after a value errors on launch.

# ─── Theme ────────────────────────────────────────────────────────────────────
# Local theme file (chezmoi-managed) for version-independent colors.
{{ if has "theme" (dig "modules" (list) .) -}}
theme = catppuccin-mocha
{{ end -}}

# ─── Font ─────────────────────────────────────────────────────────────────────
font-family = JetBrainsMono Nerd Font
font-size = 13
font-feature = calt
font-feature = liga

# ─── Window ───────────────────────────────────────────────────────────────────
window-padding-x = 12
window-padding-y = 12
window-padding-balance = true
# `default`, not `always`: Zellij owns tab persistence; restoring here would just multiply detached sessions.
window-save-state = default
# New tabs/splits inherit the current tab's working directory (Ghostty default).
# Outside Zellij this works via shell OSC 7; inside a Zellij session Zellij never
# forwards the pane cwd to Ghostty (zellij#3811), so the .zshrc auto-attach bridges
# it — a fresh tab reopens the last-active pane's directory before attaching.
window-inherit-working-directory = true
background-blur-radius = 20
background-opacity = 0.97

# ─── macOS-specific ───────────────────────────────────────────────────────────
macos-titlebar-style = transparent
# `right`, not `false`: the left Option key stays a macOS compose key, so the
# Norwegian layout's Option-dependent characters ([ ] { } | \ @ $ ~) and
# dead-key input still work. The right Option key becomes Alt, which the whole
# stack below the terminal needs — fzf's ALT-C widget, Zellij's Alt+n /
# Alt+hjkl / Alt+[ / Alt+] (including the swap layouts in layouts/main.kdl),
# and zsh's alt-b / alt-f word motions are all unreachable with `false`.
macos-option-as-alt = right
macos-non-native-fullscreen = true

# ─── Cursor ───────────────────────────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = true

# ─── Mouse / clipboard ────────────────────────────────────────────────────────
mouse-hide-while-typing = true
# Match Zellij's copy_on_select for consistent behavior in and out of a session.
copy-on-select = clipboard

# ─── Shell integration ────────────────────────────────────────────────────────
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# ─── Scrollback ───────────────────────────────────────────────────────────────
# Measured in BYTES not lines (default 10MB); ANSI escapes count against the limit.
scrollback-limit = 100000000

# ─── Keybindings ──────────────────────────────────────────────────────────────
keybind = cmd+k=clear_screen
keybind = cmd+enter=toggle_fullscreen
keybind = cmd+shift+period=inspector:toggle
# Tab bindings (Cmd+T/W/1..9, Cmd+Shift+[ ]) are Ghostty defaults.
