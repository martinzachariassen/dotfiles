{{/* Signing mode: prefer the new .signingMode; fall back to the legacy
     useOnePassword bool for configs initialised before signingMode existed
     (missing key -> default true -> "1password"). A signing block is only
     emitted when a mode is active AND a signing key is set, so key-less users
     never get a broken config.
       off       -> no signing
       ssh-key   -> plain SSH signing (git's default ssh-keygen signer)
       1password -> SSH signing via the 1Password app's signer */ -}}
{{- $signingMode := dig "signingMode" (ternary "1password" "off" (dig "useOnePassword" true .)) . -}}
{{- $signing := and (ne $signingMode "off") .signingKey -}}
[user]
    name = {{ .name }}
    email = {{ .email }}
{{- if $signing }}
    signingkey = {{ .signingKey }}
{{- end }}

[init]
    defaultBranch = main

{{ if $signing -}}
# Commit signing is enabled (signingMode = {{ $signingMode }}, signingKey set).
# To disable: set signingMode = "off" (or blank signingKey) in
# ~/.config/chezmoi/chezmoi.toml, then `chezmoi apply`.
[commit]
    gpgsign = true

[gpg]
    format = ssh

[gpg "ssh"]
{{ if eq $signingMode "1password" }}    program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
{{ end }}    allowedSignersFile = ~/.config/git/allowed_signers
{{- end }}

[core]
    editor = nvim
    pager = delta
    # Global ignore lives at ~/.config/git/ignore (XDG)
    # Built-in filesystem monitor + untracked cache — much faster `git status`
    # on large repos (no daemon to install; macOS-supported since git 2.37).
    fsmonitor = true
    untrackedCache = true

[commit]
    # Show the full diff in the commit-message editor — review while you write.
    verbose = true

[column]
    # Multi-column output for `git branch`, `git status`, `git tag`, etc.
    ui = auto

[tag]
    # Sort tags by semantic version rather than lexically (v1.10 after v1.9).
    sort = version:refname

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    line-numbers = true
    side-by-side = false
    # Pager wired with the same flags as $LESS in ~/.zshenv:
    #   F = auto-exit when content fits in one screen
    #   R = raw ANSI colors so delta's syntax highlighting renders
    #   K = Ctrl-C quits less (instead of interrupting in-progress search)
    #   -P… = custom status line showing how to escape, instead of the cryptic ":"
    # NOT using -X — see the rationale in ~/.zshenv. Without -X, less uses the
    # alt-screen buffer so content + status line vanish cleanly on exit
    # instead of cluttering scrollback.
    pager = "less -FRK -P'Press q or Ctrl-C to quit · / search · h for help'"

[diff]
    colorMoved = default
    algorithm = histogram
    # i/ w/ c/ prefixes (index/worktree/commit) instead of a/ b/ — unambiguous.
    mnemonicPrefix = true

[merge]
    conflictstyle = zdiff3

[push]
    default = simple
    autoSetupRemote = true
    followTags = true

[pull]
    rebase = true
    ff = only

[rebase]
    autoStash = true
    autoSquash = true

[rerere]
    enabled = true
    autoupdate = true

[fetch]
    prune = true
    pruneTags = true

[branch]
    sort = -committerdate

[help]
    autocorrect = prompt

[alias]
    s   = status -sb
    co  = checkout
    sw  = switch
    br  = branch --sort=-committerdate
    lg  = log --oneline --graph --decorate -20
    last = log -1 HEAD --stat
    unstage = reset HEAD --
    amend = commit --amend --no-edit
    fixup = commit --fixup
    wip  = !git add -A && git commit -m 'wip' --no-verify
    undo = reset --soft HEAD~1

# URL rewrites — push always goes via SSH, even if cloned via HTTPS
[url "git@github.com:"]
    pushInsteadOf = https://github.com/
