// Zellij layout "main" — default panes + zjstatus one-line status bar.
// zjstatus is pinned by release URL; bump deliberately (fallback pin: v0.23.0).
// First load needs network + a one-time plugin-permission approval in Zellij.
layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="https://github.com/dj95/zjstatus/releases/download/v0.24.0/zjstatus.wasm" {
                // Catppuccin Frappé: base #303446 surface0 #414559 text #c6d0f5 blue #8caaee mauve #ca9ee6 green #a6d189 red #e78284 yellow #e5c890 teal #81c8be peach #ef9f76 subtext1 #a5adce
                format_left   "#[bg=#ca9ee6,fg=#303446,bold] {session} {mode}"
                format_center "{tabs}"
                format_right  "#[bg=#303446,fg=#737994]{swap_layout}"
                format_space  "#[bg=#303446]"
                format_hide_on_overlength "true"
                format_precedence "lrc"

                // Never let zjstatus toggle frames — pane titles must stay visible.
                hide_frame_for_single_pane "false"

                mode_normal       "#[bg=#a6d189,fg=#303446,bold] NORMAL "
                mode_locked       "#[bg=#e78284,fg=#303446,bold] LOCKED "
                mode_pane         "#[bg=#8caaee,fg=#303446,bold] PANE "
                mode_tab          "#[bg=#8caaee,fg=#303446,bold] TAB "
                mode_resize       "#[bg=#e5c890,fg=#303446,bold] RESIZE "
                mode_move         "#[bg=#e5c890,fg=#303446,bold] MOVE "
                mode_scroll       "#[bg=#81c8be,fg=#303446,bold] SCROLL "
                mode_search       "#[bg=#81c8be,fg=#303446,bold] SEARCH "
                mode_enter_search "#[bg=#81c8be,fg=#303446,bold] SEARCH "
                mode_rename_tab   "#[bg=#8caaee,fg=#303446,bold] RENAME "
                mode_rename_pane  "#[bg=#8caaee,fg=#303446,bold] RENAME "
                mode_session      "#[bg=#ef9f76,fg=#303446,bold] SESSION "
                mode_prompt       "#[bg=#ef9f76,fg=#303446,bold] PROMPT "
                mode_tmux         "#[bg=#ef9f76,fg=#303446,bold] TMUX "

                tab_normal        "#[bg=#414559,fg=#a5adce] {index} {name}{fullscreen_indicator}{sync_indicator}{floating_indicator} "
                tab_active        "#[bg=#8caaee,fg=#303446,bold] {index} {name}{fullscreen_indicator}{sync_indicator}{floating_indicator} "
                tab_separator     "#[bg=#303446] "
                tab_fullscreen_indicator " □"
                tab_sync_indicator       " ⟳"
                tab_floating_indicator   " 󰉈"
            }
        }
    }

    // Mirrored from Zellij's built-in default.swap.kdl so Alt+[ / Alt+] keeps working with the custom bar.
    swap_tiled_layout name="vertical" {
        tab max_panes=5 {
            pane split_direction="vertical" {
                pane
                pane { children; }
            }
        }
        tab max_panes=8 {
            pane split_direction="vertical" {
                pane { children; }
                pane { pane; pane; pane; pane; }
            }
        }
        tab max_panes=12 {
            pane split_direction="vertical" {
                pane { children; }
                pane { pane; pane; pane; pane; }
                pane { pane; pane; pane; pane; }
            }
        }
    }
    swap_tiled_layout name="horizontal" {
        tab max_panes=4 {
            pane
            pane
        }
        tab max_panes=8 {
            pane {
                pane split_direction="vertical" { children; }
                pane split_direction="vertical" { pane; pane; pane; pane; }
            }
        }
        tab max_panes=12 {
            pane {
                pane split_direction="vertical" { children; }
                pane split_direction="vertical" { pane; pane; pane; pane; }
                pane split_direction="vertical" { pane; pane; pane; pane; }
            }
        }
    }
    swap_tiled_layout name="stacked" {
        tab min_panes=5 {
            pane split_direction="vertical" {
                pane
                pane stacked=true { children; }
            }
        }
    }
    swap_floating_layout name="staggered" {
        floating_panes
    }
}
