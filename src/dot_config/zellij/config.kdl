// Zellij config — managed by chezmoi. https://zellij.dev/documentation/configuration

// ─── Theme ────────────────────────────────────────────────────────────────
theme "catppuccin-mocha"

// ─── Behavior ─────────────────────────────────────────────────────────────
scrollback_lines     100000             // match Ghostty's buffer
default_shell        "zsh"
default_layout       "main"             // layouts/main.kdl (zjstatus bar)
mouse_mode           true
copy_on_select       true
copy_command         "pbcopy"
mirror_session       false              // each Ghostty tab = independent session
session_serialization true
pane_frames          true
simplified_ui        false
show_startup_tips    false

// ─── UI ───────────────────────────────────────────────────────────────────
ui {
    pane_frames {
        rounded_corners   true
        hide_session_name true            // already shown in the zjstatus bar
    }
}

// Keybinds are Zellij's mode-based defaults; Ctrl+G locks/unlocks them for apps that want the same chord.
