// Zellij config — managed by chezmoi
// Edit via: chezmoi edit ~/.config/zellij/config.kdl
// Reference: https://zellij.dev/documentation/configuration

// ─── Theme ────────────────────────────────────────────────────────────────
// Catppuccin Frappe ships with Zellij 0.40+
theme "catppuccin-frappe"

// ─── Behavior ─────────────────────────────────────────────────────────────
default_shell        "zsh"
default_layout       "compact"          // minimal status bar; more screen for content
mouse_mode           true
copy_on_select       true
copy_command         "pbcopy"           // macOS clipboard
mirror_session       false              // each Ghostty tab = independent zellij session
session_serialization true               // persist sessions across restarts
pane_frames          false              // cleaner look; turn back on if you split panes a lot
simplified_ui        false
show_startup_tips    false

// ─── UI ───────────────────────────────────────────────────────────────────
ui {
    pane_frames {
        rounded_corners   true
        hide_session_name false
    }
}

// ─── Keybinds ─────────────────────────────────────────────────────────────
// Zellij uses mode-based keybinds by default — Ctrl+P for pane mode, Ctrl+T
// for tab mode, etc. The defaults are sane; if you want to customize, see
// `zellij setup --dump-config` for the full bindings list and override here.
//
// One thing worth knowing: Ctrl+G locks/unlocks Zellij's own keybinds, useful
// if you're inside vim/an app that wants the same key chord.
