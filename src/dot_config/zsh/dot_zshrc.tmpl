# ─── Local overrides (not versioned) ──────────────────────────────────────────
[ -f "$ZDOTDIR/.zshrc.local" ] && source "$ZDOTDIR/.zshrc.local"

# ─── zsh-autosuggestions ──────────────────────────────────────────────────────
if [ -f /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]; then
    source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
    # Fetch suggestions asynchronously — otherwise every keystroke blocks on a
    # history lookup, which is very visible with a 50k-entry HISTFILE.
    ZSH_AUTOSUGGEST_USE_ASYNC=1
    # Don't try to suggest for a pasted or otherwise huge buffer.
    ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=80
{{ if has "theme" (dig "modules" (list) .) -}}
    # Catppuccin Mocha overlay0 — readable but unmistakably suggestion-grey.
    ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#6c7086'
{{ end -}}
fi

# ─── zsh-syntax-highlighting — MUST be sourced LAST (upstream requirement) ─────
if [ -f /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]; then
    source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

# Counterpart to the zmodload at the top; prints only when ZSH_PROFILE is set.
# `|| true` because this is the last statement: without it the unset case leaves
# $? = 1 and starship paints an error indicator on the very first prompt.
{ [[ -n ${ZSH_PROFILE:-} ]] && zprof } || true
