# ─── Swift / iOS ──────────────────────────────────────────────────────────────
alias xcderived='rm -rf ~/Library/Developer/Xcode/DerivedData'  # nuke stale build cache
alias simulator='open -a Simulator'
command -v xcbeautify >/dev/null && alias xcb='xcbeautify'

