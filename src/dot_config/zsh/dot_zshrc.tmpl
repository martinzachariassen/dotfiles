# ─── Quality-of-life ──────────────────────────────────────────────────────────
alias g='git'
alias gs='git status -sb'
alias gd='git diff'
alias gl='git log --oneline --graph --decorate -20'
alias ..='cd ..'
alias ...='cd ../..'

mkcd() { mkdir -p "$1" && cd "$1" || return; }

# ─── Dotfiles meta-commands ───────────────────────────────────────────────────
# _chez_run REL [args...] — run a repo helper by working-tree-relative path. If
# missing (repo moved it since this shell's config was generated), self-heal:
# pull + apply to regenerate, then reload.
_chez_run() {
    local rel=$1
    shift
    local src={{ .chezmoi.workingTree | quote }}
    if [[ -f $src/$rel ]]; then
        bash "$src/$rel" "$@"
        return
    fi
    print -ru2 -- "dotfiles: $src/$rel is missing — this shell's config predates a repo change."
    if ! command -v chezmoi >/dev/null 2>&1; then
        print -ru2 -- "  chezmoi isn't on PATH; fix by hand: cd ${(q)src} && git pull && chezmoi apply --force && exec zsh"
        return 1
    fi
    print -ru2 -- "  re-syncing this machine (git pull + chezmoi apply)…"
    (cd "$src" && git pull --ff-only) 2>/dev/null
    chezmoi apply --force || return 1
    if [[ -o interactive ]]; then
        print -ru2 -- "  synced — reloading your shell. Re-run your command."
        exec zsh
    fi
    print -ru2 -- "  synced — open a new shell (or run: exec zsh)."
}

# The plain-language preamble every verb prints. Nothing in this file calls it
# any more — the verbs are bash scripts and use core/ui.sh's `explain_titled` —
# but it stays as the parity oracle: tests/ui.bats runs both and asserts the
# output is byte-identical, so the extraction cannot quietly change how a verb
# looks. QUIET=1 drops back to results only.
_chez_explain() {
    [[ ${QUIET:-0} == 1 ]] && return 0
    local bar='│' dim=$'\e[2m' cyan=$'\e[36m' bold=$'\e[1m' reset=$'\e[0m' line
    [[ -t 1 ]] || { dim=''; cyan=''; bold=''; reset='' }
    print -r -- ""
    print -r -- "${cyan}◆${reset}  ${bold}$1${reset}"
    shift
    for line in "$@"; do print -r -- "${cyan}${bar}${reset}  ${dim}${line}${reset}"; done
    return 0
}

# ─── chez: one verb, many subcommands ─────────────────────────────────────────
# `chez <verb>` resolves through core/verbs.sh, the single table that also
# renders `chez help` and feeds the completion below — so the surface, the help
# and the completion cannot drift apart.
#
# It has to be a function, not a script: `chez cd` changes THIS shell's
# directory, which a subprocess cannot do. Everything else is handed to
# core/chez.sh through _chez_run, so a stale shell config still self-heals.
chez() {
    local src={{ .chezmoi.workingTree | quote }}
    if [[ ${1:-} == cd ]]; then
        cd "$src" || return
        return 0
    fi
    # Exported from render-time data rather than read back out of `chezmoi
    # data`: gating help and dispatch on the module set costs nothing this way,
    # and is exactly as accurate as the shell config it came from.
    local -x CHEZ_MODULES={{ (dig "modules" (list) .) | join " " | quote }}
    _chez_run core/chez.sh "$@"
}

# The verb list comes from the dispatcher itself, so a verb added to the table
# completes without touching this file. Module-gated verbs the Mac does not have
# are already filtered out by `--verbs`.
_chez() {
    local -a verbs
    verbs=(${(f)"$(chez --verbs 2>/dev/null)"})
    _describe -t verbs 'chez verb' verbs
}
compdef _chez chez

# ─── The old names, kept as aliases ───────────────────────────────────────────
# Every verb answered to `chez<verb>` before the dispatcher existed, and muscle
# memory outlives a refactor. These are one line each and forward verbatim;
# `chez help` is what documents the surface.
#
# Two do not follow the pattern: `dotfiles` predates the `chez` prefix, and
# `macos-defaults` is the name the macOS docs and the 04 hook already use.
alias chezup='chez up'
alias chezdoctor='chez doctor'
alias chezsetup='chez setup'
alias chezsign='chez sign'
alias chezapply='chez apply'
alias chezstatus='chez status'
alias chezbump='chez bump'
alias chezmirror='chez mirror'
alias chezreconcile='chez reconcile'
alias chezclean='chez clean'
alias chezhelp='chez help'
alias dotfiles='chez cd'
alias macos-defaults='chez macos'
{{- if has "appleDev" (dig "modules" (list) .) }}
alias chezxcode='chez xcode'
{{- end }}
{{- if has "claudeDistiller" (dig "modules" (list) .) }}
alias chezdistill='chez distill'
{{- end }}

# ─── Zellij, in-session ───────────────────────────────────────────────────────
# The auto-attach and the helpers it needs live at the top of this file, because
# everything above the attach is parsed twice per Ghostty tab. What's left here
# only ever runs in a shell that is already inside a pane, or on demand.

# Record $PWD as the active-pane cwd (creating the state dir on first use).
_zj_record_cwd() {
    [[ -d "${_zj_cwd_file:h}" ]] || command mkdir -p "${_zj_cwd_file:h}" 2>/dev/null || return
    print -r -- "$PWD" > "$_zj_cwd_file" 2>/dev/null
}

# zj [name]  no arg: attach to a fresh session for cwd. With a name: attach even
#            if running (joining/resurrecting on purpose). zj -l lists.
zj() {
    if [[ "${1:-}" == "-l" || "${1:-}" == "--list" ]]; then
        zellij list-sessions
        return
    fi
    if [[ -n "${1:-}" ]]; then
        zellij attach -c "$(_zj_session_name "$1")"
    else
        zellij attach -c "$(_zj_pick_session "$(_zj_session_name)")"
    fi
}
alias zjclean='zellij delete-all-sessions -y'

if [[ -n "$ZELLIJ" ]]; then
    # Inside a pane Ghostty's shell integration isn't injected, so set OSC 2 titles ourselves.
    _zj_title_precmd()  { print -n "\e]2;${(%):-%(4~|…/%3~|%~)}\a"; }
    _zj_title_preexec() { print -rn -- $'\e]2;'"${1//[[:cntrl:]]}"$'\a'; }
    _zj_rename_tab() { command zellij action rename-tab "${PWD:A:t}" 2>/dev/null; }
    autoload -Uz add-zsh-hook
    add-zsh-hook precmd  _zj_title_precmd
    add-zsh-hook preexec _zj_title_preexec
    add-zsh-hook chpwd   _zj_rename_tab
    # Track this pane's cwd so the next new Ghostty tab can open here.
    add-zsh-hook precmd  _zj_record_cwd
    add-zsh-hook chpwd   _zj_record_cwd
    _zj_rename_tab
    _zj_record_cwd
fi

