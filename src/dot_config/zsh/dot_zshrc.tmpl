# ─── Quality-of-life ──────────────────────────────────────────────────────────
alias g='git'
alias gs='git status -sb'
alias gd='git diff'
alias gl='git log --oneline --graph --decorate -20'
alias ..='cd ..'
alias ...='cd ../..'

mkcd() { mkdir -p "$1" && cd "$1" || return; }

# ─── Dotfiles meta-commands ───────────────────────────────────────────────────
# _chez_run REL [args...] — run a repo helper by working-tree-relative path. If
# missing (repo moved it since this shell's config was generated), self-heal:
# pull + apply to regenerate, then reload.
_chez_run() {
    local rel=$1
    shift
    local src={{ .chezmoi.workingTree | quote }}
    if [[ -f $src/$rel ]]; then
        bash "$src/$rel" "$@"
        return
    fi
    print -ru2 -- "dotfiles: $src/$rel is missing — this shell's config predates a repo change."
    if ! command -v chezmoi >/dev/null 2>&1; then
        print -ru2 -- "  chezmoi isn't on PATH; fix by hand: cd ${(q)src} && git pull && chezmoi apply --force && exec zsh"
        return 1
    fi
    print -ru2 -- "  re-syncing this machine (git pull + chezmoi apply)…"
    (cd "$src" && git pull --ff-only) 2>/dev/null
    chezmoi apply --force || return 1
    if [[ -o interactive ]]; then
        print -ru2 -- "  synced — reloading your shell. Re-run your command."
        exec zsh
    fi
    print -ru2 -- "  synced — open a new shell (or run: exec zsh)."
}

# Plain-language preamble for the zsh-native verbs; the bash scripts get the same
# from core/ui.sh's `explain`. QUIET=1 drops back to results only.
_chez_explain() {
    [[ ${QUIET:-0} == 1 ]] && return 0
    local bar='│' dim=$'\e[2m' cyan=$'\e[36m' bold=$'\e[1m' reset=$'\e[0m' line
    [[ -t 1 ]] || { dim=''; cyan=''; bold=''; reset='' }
    print -r -- ""
    print -r -- "${cyan}◆${reset}  ${bold}$1${reset}"
    shift
    for line in "$@"; do print -r -- "${cyan}${bar}${reset}  ${dim}${line}${reset}"; done
    return 0
}

# Not auto-run by `chezmoi apply` — invoke on a fresh Mac or after resetting a pref pane.
alias macos-defaults='_chez_run features/macos/cli.sh'

# No args: cd into the source repo. With args: point at the setup verbs.
dotfiles() {
    local src={{ .chezmoi.workingTree | quote }}
    if [ "$#" -eq 0 ]; then
        cd "$src" || return
    else
        echo "Re-choose your setup (profile, modules, signing):"
        echo "    chezsetup --reset          # plain-text wizard, then applies"
        echo
        echo "Or just fill in newly-added setup keys (keeps current answers):"
        echo "    chezsetup"
        echo
        echo "Just set the git signing key (once 1Password is running):"
        echo "    chezsign"
        echo
        echo "List every dotfiles command:"
        echo "    chezhelp"
    fi
}

# Apply without pulling — the building block chezup calls. Flags Brewfile drift
# (packages installed but untracked); never uninstalls.
chezapply() {
    _chez_run features/converge/apply.sh "$@"
}

# Read-only drift explainer: plain-language file drift (repo <-> $HOME) AND
# untracked-package drift, in one report. Never applies, pulls, or removes.
chezstatus() {
    _chez_run features/converge/status.sh "$@"
}

# ─── Everyday: the two commands that keep a machine in sync ───────────────────
# Converge this Mac to the repo: pull + preview + apply.
# Knobs: YES=1 skip confirm · DRY_RUN=1 print without running. Extra args → apply.
chezup() {
    _chez_run features/converge/up.sh "$@"
}

# Read-only full-stack health check.
chezdoctor() {
    _chez_run scripts/bin/doctor.sh
}

# ─── Advanced / occasional chezmoi helpers ────────────────────────────────────
# Configure this machine's profile/modules/signing. Default: fill in any
# newly-added setup keys, keeping existing answers. --reset/-r: replay
# first-time setup instead — reset chezmoi's persistent state so run_once_*/
# run_onchange_* hooks re-fire, then re-ask everything, overriding saved
# answers. Neither mode uninstalls anything; --reset is confirm-gated.
chezsetup() {
    local src={{ .chezmoi.workingTree | quote }}
    local reset=0 reply arg
    local -a rest
    for arg in "$@"; do
        case "$arg" in
            -r | --reset) reset=1 ;;
            -h | --help)
                echo "usage: chezsetup [--reset|-r]"
                echo "  (no flag)      fill in newly-added setup keys only; keeps existing answers"
                echo "  --reset, -r    replay first-time setup: reset run-once state, re-ask everything"
                return 0
                ;;
            *) rest+=("$arg") ;;
        esac
    done

    if [ "$reset" -eq 1 ]; then
        # Self-heal a stale wizard path before the destructive state reset below.
        [[ -f $src/scripts/bin/wizard.sh ]] || { _chez_run scripts/bin/wizard.sh "${rest[@]}"; return; }
        (cd "$src" && git pull --ff-only) || return $?
        # `[ -r /dev/tty ]` is unreliable, so actually try to open it.
        if { : </dev/tty; } 2>/dev/null; then
            printf 'chezsetup --reset: replay first-time setup (reset run-once state, re-ask the wizard)? [y/N] '
            IFS= read -r reply </dev/tty || reply=""
            case "$reply" in
                y | Y | yes | YES) ;;
                *)
                    echo "aborted — nothing changed"
                    return 0
                    ;;
            esac
        fi
        chezmoi state reset --force || return $?
        bash "$src/scripts/bin/wizard.sh" "${rest[@]}"
        return
    fi

    (cd "$src" && git pull --ff-only) || return $?
    echo "chezsetup: filling in any new/unanswered setup keys only."
    echo "           to re-choose profile/modules/signing, run: chezsetup --reset"
    chezmoi init && chezapply "${rest[@]}"
}

# Set the git signing key on a machine that deferred it during setup (the key
# lives in 1Password, which isn't installed until after the wizard runs). Offers
# the SSH agent's keys, changes nothing else, then proves it with a signed commit.
chezsign() {
    _chez_run features/sign/cli.sh "$@"
}
{{- if has "appleDev" (dig "modules" (list) .) }}

# Install/repair the Xcode layer an apply can't: Xcode.app itself, the selected
# developer dir, the licence, first-launch components, and a simulator runtime.
# Interactive by necessity (Apple ID + 2FA), which is why it isn't an apply hook.
chezxcode() {
    _chez_run features/xcode/cli.sh "$@"
}
{{- end }}
{{- if has "claudeDistiller" (dig "modules" (list) .) }}

# Distil Claude Code conversations into the MAIN.md every future session loads.
# Knobs: --setup · --since 7d · --render · --undo · --remote [URL|none] · -n.
# Read-only, free: --status · --stats · --runs [N] · --logs [N] [-f] · --remote.
chezdistill() {
    _chez_run scripts/bin/distill.sh "$@"
}
{{- end }}

# Routine dependency upgrade: brew update + upgrade, then mise upgrade, with a
# read-only report of anything no Brewfile tier declares.
chezbump() {
    _chez_run features/brew/bump.sh "$@"
}

# Removal direction of the Brewfile: uninstall untracked packages, then prune
# orphaned dependencies. Not wired into `chezapply` — a routine apply must never
# silently uninstall. `chezreconcile` chains chezup (install) + this (remove).
chezmirror() {
    _chez_run features/brew/mirror.sh "$@"
}

# Full reconcile: chezup (install what the repo declares) then chezmirror
# (remove what it no longer tracks). Untracked *files* are a separate step
# (`chezclean`). Honours DRY_RUN=1 and YES=1. Trailing args pass to chezup.
chezreconcile() {
    _chez_run features/converge/reconcile.sh "$@"
}

# Reconcile untracked dotfiles to what chezmoi manages (both $HOME's top level
# and ~/.config, per cleanup.toml). The file analogue of chezmirror.
chezclean() {
    _chez_run features/clean/cli.sh "$@"
}

# Print every dotfiles verb, grouped by frequency. Mirrors README.md /
# docs/commands.md — keep the three in sync.
chezhelp() {
    cat <<'EOF'

  ── dotfiles commands ─────────────────────────────────────────────
  Converge this Mac to the repo. Two verbs day to day; the rest are
  for setup changes and package drift.

  Everyday
    chezup           Pull → preview → apply. The command you run most.
    chezdoctor       Read-only health check (repo, brew, auth, mise, shell).

  Change your setup (re-run the wizard)
    chezsetup        Fill in newly-added setup keys; keeps existing answers.
                       --reset/-r  set up as new: reset run-once state, re-ask everything.
    chezsign         Set the git signing key on its own; keeps every other answer.
                       Run this after 1Password is up if setup deferred the key.
{{- if has "appleDev" (dig "modules" (list) .) }}
    chezxcode        Install Xcode + iOS simulator runtime (Apple ID, ~40 GB).
                       --check  report the five readiness checks; changes nothing.
{{- end }}
{{- if has "claudeDistiller" (dig "modules" (list) .) }}
    chezdistill      Distil Claude conversations into the MAIN.md Claude loads.
                       --setup   turn it on here: module, apply, nightly timer.
                       --status  where things live, MAIN size vs cap, spend, runs.
                       --render  rebuild from the corpus, no API calls.
                       --stats   the corpus: funnel, topics, spend, runs.
                       --runs [N]  a row per night ·  --logs [N] [-f]  the log.
                       --since 7d  backfill     ·  --undo  revert + re-render.
                       --remote [URL|none]  back the corpus up, or stop.
{{- end }}

  Maintenance (packages & drift)
    chezapply        Apply without pulling. Flags drift; never uninstalls.
    chezstatus       Explain pending file + package drift in plain words (read-only).
    chezbump         Upgrade deps: brew upgrade + mise upgrade.
    chezmirror       Uninstall untracked packages (removal only), confirming each.
                       --all/-a      uninstall the whole set after one confirmation.
                       --dry-run/-n  preview only, remove nothing.
    chezreconcile    Full package reconcile: chezup (install) + chezmirror (remove).
    chezclean        Remove untracked top-level ~/.* entries, confirming each.
                       --all/-a  remove the whole set after one confirmation.
    dotfiles         cd into the source repo.

  Add something new to the repo
    new brew pkg     add the line to features/brew/Brewfile* → chezapply  (apply installs it)
    new dotfile      chezmoi add ~/.foo   ·   update tracked: chezmoi re-add ~/.foo

  Under the hood
    install.sh       Bootstrap a fresh Mac (curl | bash entry point).
    macos-defaults   (Re-)apply macOS system defaults on their own.
    chezhelp         Show this list.

  Knobs (chezup / chezapply / chezreconcile / chezclean):  DRY_RUN=1 print only  ·  YES=1 skip confirm
  QUIET=1 on any verb (and install.sh) drops the explanations, leaving just results
  chezmirror also honors DRY_RUN=1 / -n (preview only) and YES=1 (accept-all, no prompts)
  YES=1 chezclean:  accept-all — remove everything untracked, no prompts
  Deeper docs:  run `dotfiles`, then see docs/commands.md
EOF
}

# ─── Zellij, in-session ───────────────────────────────────────────────────────
# The auto-attach and the helpers it needs live at the top of this file, because
# everything above the attach is parsed twice per Ghostty tab. What's left here
# only ever runs in a shell that is already inside a pane, or on demand.

# Record $PWD as the active-pane cwd (creating the state dir on first use).
_zj_record_cwd() {
    [[ -d "${_zj_cwd_file:h}" ]] || command mkdir -p "${_zj_cwd_file:h}" 2>/dev/null || return
    print -r -- "$PWD" > "$_zj_cwd_file" 2>/dev/null
}

# zj [name]  no arg: attach to a fresh session for cwd. With a name: attach even
#            if running (joining/resurrecting on purpose). zj -l lists.
zj() {
    if [[ "${1:-}" == "-l" || "${1:-}" == "--list" ]]; then
        zellij list-sessions
        return
    fi
    if [[ -n "${1:-}" ]]; then
        zellij attach -c "$(_zj_session_name "$1")"
    else
        zellij attach -c "$(_zj_pick_session "$(_zj_session_name)")"
    fi
}
alias zjclean='zellij delete-all-sessions -y'

if [[ -n "$ZELLIJ" ]]; then
    # Inside a pane Ghostty's shell integration isn't injected, so set OSC 2 titles ourselves.
    _zj_title_precmd()  { print -n "\e]2;${(%):-%(4~|…/%3~|%~)}\a"; }
    _zj_title_preexec() { print -rn -- $'\e]2;'"${1//[[:cntrl:]]}"$'\a'; }
    _zj_rename_tab() { command zellij action rename-tab "${PWD:A:t}" 2>/dev/null; }
    autoload -Uz add-zsh-hook
    add-zsh-hook precmd  _zj_title_precmd
    add-zsh-hook preexec _zj_title_preexec
    add-zsh-hook chpwd   _zj_rename_tab
    # Track this pane's cwd so the next new Ghostty tab can open here.
    add-zsh-hook precmd  _zj_record_cwd
    add-zsh-hook chpwd   _zj_record_cwd
    _zj_rename_tab
    _zj_record_cwd
fi

