# ~/.config/zsh/.zprofile — login shell setup, runs once before .zshrc.

# Set vars inline rather than `brew shellenv` to keep an external process out of
# every `/bin/zsh -l`.
if [ -d /opt/homebrew ]; then
    export HOMEBREW_PREFIX="/opt/homebrew"
    export HOMEBREW_CELLAR="/opt/homebrew/Cellar"
    export HOMEBREW_REPOSITORY="/opt/homebrew"

    # `typeset -U path` (~/.zshenv) dedups, so an unconditional prepend is safe.
    path=(/opt/homebrew/bin /opt/homebrew/sbin $path)

    export MANPATH="/opt/homebrew/share/man${MANPATH+:$MANPATH}:"
    export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}"
fi

# Set here, not .zshenv: /etc/zprofile's path_helper runs in between and would
# otherwise sink ~/.local/bin below /usr/bin.
path=("$HOME/.local/bin" $path)
